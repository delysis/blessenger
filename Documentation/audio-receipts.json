  "api_contract": {
    "capture": "AVAudioEngine input/output voice processing in one engine; mono Float32 at 16000 Hz for Gemma, resampled with a persistent AVAudioConverter.",
    "vad": "VadManager.processStreamingChunk, explicit VadStreamState, 4096-sample chunks; CPU-only compute, threshold 0.65, 0.5-second silence, app-enforced 30-second utterance limit.",
    "speech": "PocketTtsManager placement .ane (rank4), conditioner/FlowLM/flowDecoder/mimiEncoder cpuAndNeuralEngine, mimiDecoder cpuOnly. No TTS stage is configured to permit GPU compute.",
    "fallback": "Only explicit thrown Neural Engine evidence enables sticky uniform cpuOnly fallback on the same rank4 assets. Generic CoreML, network and cancellation errors do not. Fatal process aborts cannot be recovered by Swift error handling.",
    "retry": "A sentence can be retried only before any of its audio is queued. After that, an ANE error stops the response and enables CPU for subsequent responses.",
    "streaming": "One sentence (at most 240 Unicode scalars) per PocketTtsSession; upstream streams are unbounded but no second sentence is queued into them. App queue: eight sentences with backpressure; playback: eight 1920-sample 24kHz frames, at most 640ms scheduled.",
    "cancellation": "PocketTtsSession.cancel is awaited to join generation, including the current CoreML operation; playback stops immediately and generation IDs discard stale completion callbacks.",
    "voice": "One to ten seconds of mono24k conditioning. VoiceSample reads at most 4096 source frames per call within an independent 10s budget, downmixes at source rate, then resamples once. Late failed packetized reads keep an already-decoded prefix, matching pinned FluidAudio. First-read failures, less than 1s and nonfinite samples are rejected. Controller retains 20MiB file bound and transactional conditioning commit.",
    "echo": "If voice processing is unavailable, capture is suppressed during playback and for a 300ms tail; no separate interrupt control is required.",
    "pins": "ModelRegistry.revisionOverrides is configured once on MainActor before FluidAudio work. Revision-specific cache folders avoid adopting mutable old assets.",
    "legacy_backfills": "Before Pocket initialize, all selected English rank4 files, BOS and Alba constants are present. English skips 24-layer speaker projection and pack-local encoder backfills. The optional shared encoder is preflighted before cloneVoice.",
    "cache_validation": "Fast startup validates exact selected file sizes and rejects symbolic links/incomplete files. This detects partial caches; it is not a cryptographic check of later local edits. ModelHub downloads from the exact pinned revision.",
    "voice_commit": "setVoice(referenceAudio:commit:) validates and clones into a local value, checks task cancellation, invokes a synchronous throwing @Sendable commit closure, then replaces in-memory conditioning with no intervening await. Nil reset follows the same order; clone/cancellation/commit failure retains the prior live voice.",
    "capture_callback": "A local OSAllocatedUnfairLock gates one-time delivery to AVAudioConverterInputBlock, following the pinned AudioConverter Swift 6 pattern; persistent streaming converter retains its state."
  },
  "failure_reference": {
    "url": "https://github.com/FluidInference/FluidAudio/issues/881",
    "use": "Concrete reported ANEProgramProcessRequestDirect failure signature; not a native qualification result."
  },
  "validation": {
    "source_files_verified_against_git_blob": 30,
    "swift_compiler_available": true,
    "native_macos_tests_run": false,
    "native_coreml_ane_tests_run": false,
    "audio_hardware_tests_run": false,
    "tests_added": [
      "Tests/CallGemmaTests/AudioPolicyTests.swift",
      "Tests/CallGemmaTests/VoiceSampleTests.swift"
    ],
    "scope": "Eight actual pure audio-policy/buffer tests passed on Linux Swift 6.2.3 with complete concurrency checking and warning errors. Apple sources syntax-parse only; no CoreML, ANE or physical audio claim.",
    "portable_audio_tests_passed": 8,
    "evidence": "../Qualification/Validation/swift-portable/tests.xml",
    "native_voice_decoder_tests_not_run": 4,
    "compressed_eof_test_limit": "Generated AAC exercises actual Apple encoding/decoding but a particular OS decoder may finish without throwing at the padding tail; the failure branch is not forcibly injected."
  },
  "instrumentation": {
    "enable": "Set CALL_GEMMA_TRACE=1 in the launched app environment before startup. Signposting is otherwise disabled.",
    "apple_api": "https://developer.apple.com/documentation/os/ossignposter",
    "subsystem": "CallGemma",
    "category": "Audio",
    "interval": "Sentence synthesis stream: from session creation through consumption and producer join, including downstream backpressure. It is not an isolated CoreML compute measurement.",
    "events": [
      "First PCM frame received",
      "First playback buffer scheduled"
    ],
    "logging_scope": "Phase boundaries only; no speech contents, per-sample events, or per-token logs.",
    "native_manual_gate": [
      "On the target Apple Silicon Mac, run swift test using the actual pinned dependency and built patched runtime; retain the complete test log, macOS/Swift/Xcode versions and model asset revisions.",
      "Build and sign the app, move the app to a new location, make the original .build resource bundles unavailable, and verify both app and dependency resources load. Restore any moved build files after this relocation test.",
      "Record Instruments Points of Interest together with Time Profiler, CoreML/Neural Engine activity and the audio output timeline. Use a three-sentence response long enough to exceed eight Pocket frames. Confirm first playback scheduling occurs before the sentence stream ends; then verify from compute/audio tracks that synthesis really continues while output plays. The sentence interval alone cannot prove private producer overlap.",
      "Capture output with a loopback device or external recorder and retain the waveform. Check within-sentence continuity and measure sentence-transition silence across at least 20 warm responses; report maximum and distribution with hardware/load, rather than equating schedule time with audible time.",
      "Measure utterance-complete to first-text, first-PCM and first-buffer-scheduled latency using the app/runtime phase markers. Repeat with warm caches, a restored conversation, and fresh process startup.",
      "Exercise built-in Alba and a one-to-ten-second imported sample across process restart. Confirm missing/truncated pinned model files are repaired or fail explicitly, and an offline complete cache starts without legacy default-main backfills.",
      "Interrupt via speaking while playback is active; verify playback stops, the previous session producer joins, and no old frame or completion is heard during the next response. Test hang-up during capture, generation and playback.",
      "On a device/configuration that emits an actual catchable ANE failure, verify CPU fallback before the first frame retries once and does not use GPU. If the failure occurs after a frame was queued, verify current response stops without repeating the sentence and the next response uses CPU. Do not report this as passed from a fabricated generic NSError; a native fault-injected test build must be identified separately.",
      "Verify generic CoreML shape/download errors and cancellation do not switch to CPU. If voice processing is unavailable, verify listening pauses during playback and its 300ms echo tail. Hardware loopback and barge-in results are required; source inspection is not device qualification."
    ]
  }
