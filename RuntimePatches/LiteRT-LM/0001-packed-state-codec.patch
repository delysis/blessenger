+TEST_F(StateSerializationTest, BoundsMetadataNesting) {
+  ASSERT_OK_AND_ASSIGN(auto serialized,
+                       SerializeState(nlohmann::json::object(), {}));
+  auto header = Header(serialized);
+  for (int i = 0; i < 40; ++i) {
+    header["metadata"] = {{"nested", header["metadata"]}};
+  }
+  EXPECT_FALSE(ParseSerializedState(ReplaceHeader(serialized, header)).ok());
+}
