+class CacheAudioContext : public AudioContext {
+ public:
+  explicit CacheAudioContext(bool pending = false) : pending(pending) {}
+  absl::StatusOr<std::unique_ptr<AudioContext>> Clone() const override {
+    return std::make_unique<CacheAudioContext>(*this);
+  }
+  bool pending;
+};
+
+class CacheAudioExecutor : public AudioExecutor {
+ public:
+  absl::StatusOr<ExecutorAudioData> Encode(const TensorBuffer&) override {
+    return absl::UnimplementedError("Not used in the lease tests.");
+  }
+  absl::Status ValidateContextForCache(
+      const AudioContext* context = nullptr) const override {
+    if (!stateless) return absl::UnimplementedError("Stateful audio.");
+    const bool has_pending =
+        context != nullptr ? static_cast<const CacheAudioContext*>(context)->pending
+                           : pending;
+    if (has_pending) {
+      return absl::FailedPreconditionError("Partial audio.");
+    }
+    return absl::OkStatus();
+  }
+  absl::StatusOr<std::unique_ptr<AudioContext>> CloneContext() override {
+    return std::make_unique<CacheAudioContext>(pending);
+  }
+  absl::StatusOr<std::unique_ptr<AudioContext>> CloneContext(
+      const AudioContext& context) override {
+    return context.Clone();
+  }
+  absl::Status RestoreContext(std::unique_ptr<AudioContext> context) override {
+    pending = static_cast<CacheAudioContext*>(context.get())->pending;
+    ++restores;
+    return absl::OkStatus();
+  }
+  bool stateless = true;
+  bool pending = false;
+  int restores = 0;
+};
