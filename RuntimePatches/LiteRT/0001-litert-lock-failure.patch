+TEST(TensorBufferRegistryTest, FailedLockCanBeRetried) {
+  LITERT_ASSIGN_OR_ABORT(litert::Environment env,
+                         litert::Environment::Create({}));
+  litert::internal::TensorBufferRegistry* registry = nullptr;
+  LITERT_ASSERT_OK(LiteRtGetTensorBufferRegistry(
+      env.Get(), reinterpret_cast<void**>(&registry)));
+  LITERT_ASSERT_OK(registry->RegisterHandlers(
+      kLiteRtTensorBufferTypeUserCustomBuffer,
+      {.create_func = CreateMyCustomTensorBuffer,
+       .destroy_func = DestroyMyCustomTensorBuffer,
+       .lock_func = LockMyCustomTensorBuffer,
+       .unlock_func = UnlockMyCustomTensorBuffer}));
+  constexpr LiteRtRankedTensorType kTensorType = {
+      kLiteRtElementTypeInt32, litert::BuildLayout({8})};
+  LITERT_ASSIGN_OR_ABORT(auto tensor_buffer,
+                         LiteRtTensorBufferT::CreateManaged(
+                             env.Get(), kLiteRtTensorBufferTypeUserCustomBuffer,
+                             kTensorType, 32));
+  LITERT_ASSIGN_OR_ABORT(auto custom_buffer, tensor_buffer->GetCustomBuffer());
+  auto* memory_info =
+      static_cast<CustomHwMemoryInfo*>(custom_buffer->hw_memory_info());
+  memory_info->fail_next_lock = true;
+
+  EXPECT_FALSE(tensor_buffer->Lock(kLiteRtTensorBufferLockModeRead));
+  LITERT_ASSERT_OK_AND_ASSIGN(
+      void* data, tensor_buffer->Lock(kLiteRtTensorBufferLockModeRead));
+  ASSERT_NE(data, nullptr);
+  EXPECT_FALSE(tensor_buffer->Lock(kLiteRtTensorBufferLockModeRead));
+  LITERT_EXPECT_OK(tensor_buffer->Unlock());
+  EXPECT_FALSE(tensor_buffer->Unlock());
+}
