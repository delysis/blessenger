+// Match MTP: a single executor call advances through an entire token batch,
+// even when the task later discovers a stop inside that batch.
+class BatchedStopExecutor : public FakeLlmExecutor {
+ public:
+  explicit BatchedStopExecutor(std::vector<std::vector<int>> tokens)
+      : FakeLlmExecutor(2560, {{2}}, tokens, /*batch_size=*/1) {}
+  absl::StatusOr<std::vector<std::vector<int>>> Decode(
+      const ExecutorDecodeParams& params) override {
+    std::vector<int> batch;
+    for (int i = 0; i < 4; ++i) {
+      ABSL_ASSIGN_OR_RETURN(auto token, FakeLlmExecutor::Decode(params));
+      batch.push_back(token.at(0).at(0));
+    }
+    return std::vector<std::vector<int>>{std::move(batch)};
+  }
+};
+
+TEST_F(TasksTest, BatchedDecodePreservesTheCorrectStopBoundary) {
+  for (bool rollback : {false, true}) {
+    for (int stop_position = 0; stop_position < 4; ++stop_position) {
+      SCOPED_TRACE(::testing::Message() << rollback << ":" << stop_position);
+      std::vector<std::vector<int>> tokens = {{90}, {547}, {58}, {735}};
+      tokens[stop_position] = {0};
+      BatchedStopExecutor executor(std::move(tokens));
+      std::optional<BenchmarkInfo> benchmark_info;
+      ASSERT_OK_AND_ASSIGN(auto buffer, tokenizer_->TokenIdsToTensorBuffer({2}));
+      ExecutorInputs inputs(ExecutorTextData(std::move(buffer)), std::nullopt,
+                            std::nullopt);
+      ASSERT_OK(Tasks::Prefill(executor, inputs, true, benchmark_info));
+      StopTokenDetector detector(1);
+      ASSERT_OK(detector.AddStopTokenSequence({0}));
+      if (rollback) ASSERT_TRUE(detector.MarkForRollback(0));
+      absl::AnyInvocable<void(absl::StatusOr<Responses>)> callback = nullptr;
+      ASSERT_OK_AND_ASSIGN(auto response,
+          Tasks::Decode(executor, *tokenizer_, detector, 1, benchmark_info,
+              std::nullopt, RepetitionPenaltyConfig::Default(),
+              NoRepeatNgramConfig::Default(), SuppressTokensConfig::Default(),
+              nullptr, std::nullopt, callback, nullptr));
+      EXPECT_EQ(response.GetTaskState(), TaskState::kDone);
+      ASSERT_OK_AND_ASSIGN(int current_step, executor.GetCurrentStep());
+      EXPECT_EQ(current_step, 1 + stop_position + (rollback ? 0 : 1));
+    }
+  }
+}
