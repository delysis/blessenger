+absl::StatusOr<ProcessedTokens> ProcessedTokens::CreateFromTokens(
+    std::vector<std::vector<int>> token_ids,
+    std::vector<std::shared_ptr<TokenData>> pending_tokens) {
+  if (token_ids.empty() ||
+      (!pending_tokens.empty() && pending_tokens.size() != token_ids.size())) {
+    return absl::InvalidArgumentError("Invalid processed token candidate count.");
+  }
+  const size_t count = token_ids.front().size();
+  if (count >= std::numeric_limits<int>::max()) {
+    return absl::InvalidArgumentError("Too many processed tokens.");
+  }
+  for (size_t i = 0; i < token_ids.size(); ++i) {
+    if (token_ids[i].size() != count ||
+        (!pending_tokens.empty() && pending_tokens[i] == nullptr)) {
+      return absl::InvalidArgumentError("Invalid processed token rows.");
+    }
+  }
+  ProcessedTokens result;
+  result.tokens_.clear();
+  result.tokens_.reserve(token_ids.size());
+  for (size_t i = 0; i < token_ids.size(); ++i) {
+    result.tokens_.push_back(
+        {std::move(token_ids[i]),
+         pending_tokens.empty() ? nullptr : std::move(pending_tokens[i])});
+  }
+  return result;
+}
