+        std::vector<float> pcm(length);
+        for (int i = 0; i < length; ++i) pcm[i] = ((i * 37) % 997 - 498) / 997.0f;
+        ASSERT_OK_AND_ASSIGN(auto expected_audio, whole->Preprocess(InputAudio(pcm)));
+        ASSERT_OK_AND_ASSIGN(auto expected_tensor, expected_audio.GetPreprocessedAudioTensor());
+        ASSERT_OK_AND_ASSIGN(auto expected, GetDataAsVector<float>(*expected_tensor));
+        std::vector<float> actual;
+        auto append = [&](absl::StatusOr<InputAudio> audio) {
+          // A 640-sample PCM graph can legitimately have no complete frame yet.
+          if (!audio.ok()) {
+            EXPECT_TRUE(skip_mel && audio.status().message() == "Not enough samples to form any frame.")
+                << audio.status();
+            return;
+          }
+          ASSERT_OK_AND_ASSIGN(auto tensor, audio->GetPreprocessedAudioTensor());
+          ASSERT_OK_AND_ASSIGN(auto values, GetDataAsVector<float>(*tensor));
+          actual.insert(actual.end(), values.begin(), values.end());
+        };
+        for (int begin = 0; begin < length; begin += chunk) {
+          std::vector<float> part(pcm.begin() + begin,
+                                  pcm.begin() + std::min(length, begin + chunk));
+          append(stream->Preprocess(InputAudio(part)));
+        }
+        append(stream->Flush());
+        EXPECT_FALSE(stream->Flush().ok());
+        EXPECT_FALSE(stream->Preprocess(InputAudio(pcm)).ok());
+        stream->Reset();
+        EXPECT_TRUE(stream->Preprocess(InputAudio(pcm)).ok());
+        EXPECT_EQ(actual, expected) << "skip_mel=" << skip_mel << " length=" << length << " chunk=" << chunk;
+      }
+    }
+  }
+}
+
