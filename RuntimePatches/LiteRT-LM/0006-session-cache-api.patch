+absl::StatusOr<SerializedLlmContext>
+SerialExecutionManager::SerializeSessionContext(
+    SessionId session_id, const absl::flat_hash_set<TaskId>& completed_tasks) {
+  std::shared_ptr<SessionInfo> session;
+  {
+    const auto found = session_lookup_.find(session_id);
+    if (found == session_lookup_.end()) {
+      return absl::NotFoundError("Session not found.");
+    }
+    session = found->second;
+    if (!session->active_tasks.empty()) {
+      return absl::FailedPreconditionError("Session is busy.");
+    }
+    for (TaskId task_id : completed_tasks) {
+      const auto task = task_lookup_.find(task_id);
+      if (task == task_lookup_.end() ||
+          (task->second.task_state != TaskState::kDone &&
+           task->second.task_state != TaskState::kMaxNumTokensReached)) {
+        return absl::FailedPreconditionError(
+            "Session did not complete successfully.");
+      }
+    }
+  }
+  ABSL_ASSIGN_OR_RETURN(auto executor,
+                        resource_manager_->TryAcquireExecutorWithContextHandler(
+                            session->context_handler));
+  return executor->SerializeContext();
+}
+
+absl::Status SerialExecutionManager::LoadSessionContext(
+    SessionId session_id, absl::string_view metadata, absl::string_view state,
+    int last_prefill_token_id) {
+  std::shared_ptr<SessionInfo> session;
+  {
+    const auto found = session_lookup_.find(session_id);
+    if (found == session_lookup_.end()) {
+      return absl::NotFoundError("Session not found.");
+    }
+    session = found->second;
+    if (!session->active_tasks.empty()) {
+      return absl::FailedPreconditionError("Session is busy.");
+    }
+    for (const auto& [task_id, task] : task_lookup_) {
+      if (task.session_id == session_id) {
+        return absl::FailedPreconditionError("LoadCache requires a new session.");
+      }
+    }
+  }
+  ABSL_ASSIGN_OR_RETURN(auto executor,
+                        resource_manager_->TryAcquireExecutorWithContextHandler(
+                            session->context_handler));
+  ABSL_ASSIGN_OR_RETURN(int step, executor->GetCurrentStep());
+  if (step != 0) {
+    return absl::FailedPreconditionError("LoadCache requires a new LLM session.");
+  }
+  ABSL_RETURN_IF_ERROR(executor->LoadContext(metadata, state));
+  session->last_prefill_token_id = last_prefill_token_id;
+  return absl::OkStatus();
+}
