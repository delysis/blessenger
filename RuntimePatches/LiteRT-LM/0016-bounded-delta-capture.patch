+CapturedCacheFile::~CapturedCacheFile() {
+#if !defined(_WIN32)
+  close(fd_);
+#endif
+}
+
+absl::Status CapturedCacheFile::FlushRun() {
+  if (!run_size_) return absl::OkStatus();
+  constexpr size_t kMemoryLimit = 32 * 1024 * 1024;
+  if (!spilled_ && delta_bytes_.size() + run_size_ > kMemoryLimit) {
+    for (const auto& delta : deltas_) {
+      ABSL_RETURN_IF_ERROR(WriteAt(fd_, absl::string_view(delta_bytes_).substr(delta.payload, delta.size),
+                                  kStateOffset + delta.offset));
+    }
+    bytes_written_ += delta_bytes_.size();
+    std::string().swap(delta_bytes_);
+    spilled_ = true;
+  }
+  if (spilled_) {
+    ABSL_RETURN_IF_ERROR(WriteAt(fd_, absl::string_view(compare_.data(), run_size_), kStateOffset + run_start_));
+    bytes_written_ += run_size_;
+  } else {
+    // Reserve a fixed maximum once, avoiding allocator growth peaks above the
+    // advertised bound. Physical pages are touched only for actual deltas.
+    if (delta_bytes_.capacity() < kMemoryLimit) delta_bytes_.reserve(kMemoryLimit);
+    delta_bytes_.append(compare_.data(), run_size_);
+  }
+  deltas_.push_back({run_start_, run_size_, payload_size_});
+  payload_size_ += run_size_;
+  run_size_ = 0;
+  return absl::OkStatus();
+}
+
+absl::Status CapturedCacheFile::Block(const char* data, size_t bytes) {
+#if defined(__APPLE__)
+  static const std::array<char, 4096> zero{};
+  static const auto zero_hash = [] {
+    std::array<unsigned char, 32> hash;
+    CC_SHA256(zero.data(), zero.size(), hash.data());
+    return hash;
+  }();
+  std::array<unsigned char, 32> hash;
+  const bool is_zero = std::memcmp(data, zero.data(), bytes) == 0;
+  if (is_zero && bytes == zero.size()) hash = zero_hash;
+  else CC_SHA256(data, static_cast<CC_LONG>(bytes), hash.data());
+  const size_t index = hashes_->size();
+  const bool unchanged = base_ && index < base_->hashes->size() &&
+                         (*base_->hashes)[index] == hash;
+  hashes_->push_back(hash);
+  // Compare strong content hashes, never CRCs, when reusing a cloned block.
+  // CRC32C remains the independent on-disk framing/integrity check.
+  const bool write = !unchanged && (base_ || !is_zero);
+#else
+  // Non-cloning platforms have no base: stream a complete sparse snapshot.
+  static const std::array<char, 4096> zero{};
+  const bool write = std::memcmp(data, zero.data(), bytes) != 0;
+#endif
+  if (!write || (run_size_ && run_start_ + run_size_ != position_) ||
+      run_size_ + bytes > compare_.size()) ABSL_RETURN_IF_ERROR(FlushRun());
+  if (write) {
+    if (run_size_ == 0) run_start_ = position_;
+    std::memcpy(compare_.data() + run_size_, data, bytes);
+    run_size_ += bytes;
+  }
+  crc_ = static_cast<uint32_t>(absl::ExtendCrc32c(absl::crc32c_t(crc_), absl::string_view(data, bytes)));
+  position_ += bytes;
+  return absl::OkStatus();
+}
+
+std::streamsize CapturedCacheFile::xsputn(const char* data, std::streamsize size) {
+#if defined(_WIN32)
+  return 0;
+#else
+  if (finished_ || !status_.ok() || size < 0 ||
+      static_cast<uint64_t>(size) > static_cast<uint64_t>(std::numeric_limits<off_t>::max()) -
+          kStateOffset - position_ - partial_size_) return 0;
+  size_t consumed = 0;
+  while (consumed < static_cast<size_t>(size)) {
+    const size_t remaining = static_cast<size_t>(size) - consumed;
+    if (partial_size_ == 0 && remaining >= partial_.size()) {
+      status_ = Block(data + consumed, partial_.size());
+      if (!status_.ok()) return consumed;
+      consumed += partial_.size();
+    } else {
+      const size_t count = std::min(partial_.size() - partial_size_, remaining);
+      std::memcpy(partial_.data() + partial_size_, data + consumed, count);
+      partial_size_ += count;
+      consumed += count;
+      if (partial_size_ == partial_.size()) {
+        status_ = Block(partial_.data(), partial_size_);
+        if (!status_.ok()) return 0;
+        partial_size_ = 0;
+      }
+    }
+  }
+  return size;
+#endif
+}
+
+absl::Status CapturedCacheFile::Finish() {
+  ABSL_RETURN_IF_ERROR(status_);
+  if (finished_ || position_ + partial_size_ == 0) return absl::FailedPreconditionError("Capture is empty or already finished.");
+  if (partial_size_) {
+    status_ = Block(partial_.data(), partial_size_);
+    ABSL_RETURN_IF_ERROR(status_);
+    partial_size_ = 0;
+  }
+  status_ = FlushRun();
+  ABSL_RETURN_IF_ERROR(status_);
+#if !defined(_WIN32)
+  if (spilled_ && !base_) {
+    // A first spilled capture already contains the complete sparse state.
+    // Promote it immediately, avoiding a duplicate full-history materialization
+    // and allowing the next capture to use its hashes before publication finishes.
+    if (ftruncate(fd_, kStateOffset + position_) != 0)
+      return absl::ErrnoToStatus(errno, "Could not size initial captured state.");
+    const int fd = fcntl(fd_, F_DUPFD_CLOEXEC, 0);
+    if (fd < 0) return absl::ErrnoToStatus(errno, "Could not retain initial captured state.");
+    std::shared_ptr<const Base> base(new Base{fd, hashes_});
+    std::atomic_store(&materialized_, base);
+  }
+#endif
+  finished_ = true;
+  return absl::OkStatus();
+}
+
+absl::StatusOr<std::shared_ptr<const CapturedCacheFile::Base>>
+CapturedCacheFile::Materialize() const {
+  if (auto existing = std::atomic_load(&materialized_)) return existing;
+  ABSL_ASSIGN_OR_RETURN(int fd, CaptureFD(directory_, base_ ? base_->fd : -1));
+  auto base = std::shared_ptr<const Base>(new Base{fd, hashes_});
+  std::array<char, 65536> buffer;
+  for (const auto& delta : deltas_) {
+    if (!spilled_) {
+      ABSL_RETURN_IF_ERROR(WriteAt(fd, absl::string_view(delta_bytes_).substr(delta.payload, delta.size),
+                                  kStateOffset + delta.offset));
+    } else {
+#if !defined(_WIN32)
+      for (size_t offset = 0; offset < delta.size;) {
+        const ssize_t n = pread(fd_, buffer.data(), std::min(buffer.size(), delta.size - offset), kStateOffset + delta.offset + offset);
+        if (n < 0 && errno == EINTR) continue;
+        if (n <= 0) return absl::ErrnoToStatus(errno ? errno : EIO, "Could not read spilled capture.");
+        ABSL_RETURN_IF_ERROR(WriteAt(fd, absl::string_view(buffer.data(), n), kStateOffset + delta.offset + offset));
+        offset += n;
+      }
+#endif
+    }
+  }
+#if !defined(_WIN32)
+  if (ftruncate(fd, kStateOffset + position_) != 0)
+    return absl::ErrnoToStatus(errno, "Could not size captured state.");
+#endif
+  std::atomic_store(&materialized_, base);
+  std::string().swap(delta_bytes_);
+  return base;
+}
+
+absl::Status CapturedCacheFile::Publish(absl::string_view path, absl::string_view key,
+    int last_token, absl::string_view metadata, size_t* written_bytes) const {
+#if defined(_WIN32)
+  return absl::UnimplementedError("Bounded cache capture requires POSIX files.");
+#else
+  if (written_bytes) *written_bytes = 0;
+  ABSL_RETURN_IF_ERROR(CheckArguments(path, key));
+  if (!finished_ || metadata.empty() || metadata.size() > kMaxMetadataSize)
+    return absl::InvalidArgumentError("Invalid captured cache payload.");
+  std::lock_guard<std::mutex> lock(publish_mutex_);
+  ABSL_ASSIGN_OR_RETURN(auto materialized, Materialize());
+  std::string header(kIncrementalMagic);
+  AppendLittleEndian(header, key.size(), 8);
+  AppendLittleEndian(header, metadata.size(), 8);
+  AppendLittleEndian(header, position_, 8);
+  AppendLittleEndian(header, static_cast<uint32_t>(last_token), 4);
+  auto crc = absl::ExtendCrc32c(absl::ComputeCrc32c(header), key);
+  crc = absl::ExtendCrc32c(crc, metadata);
+  crc = absl::ConcatCrc32c(crc, absl::crc32c_t(crc_), position_);
+  AppendLittleEndian(header, static_cast<uint32_t>(crc), 4);
+  const auto destination = std::filesystem::u8path(path.begin(), path.end());
+  std::string directory = destination.parent_path().empty() ? "." : destination.parent_path().string();
+  directory += "/publish-XXXXXX";
+  if (!mkdtemp(directory.data())) return absl::ErrnoToStatus(errno, "Could not create publication directory.");
+  const std::filesystem::path temporary = std::filesystem::path(directory) / "state";
+  FILE* file = nullptr;
+  absl::Cleanup cleanup = [&] {
+    if (file) std::fclose(file);
+    unlink(temporary.c_str()); rmdir(directory.c_str());
+  };
+  bool cloned = false;
+#if defined(__APPLE__)
+  if (fclonefileat(materialized->fd, AT_FDCWD, temporary.c_str(), 0) == 0) cloned = true;
+  else if (errno != EXDEV && errno != ENOTSUP)
+    return absl::ErrnoToStatus(errno, "Could not clone captured checkpoint.");
+#endif
+  file = std::fopen(temporary.c_str(), cloned ? "r+b" : "wbx");
+  if (!file) return absl::ErrnoToStatus(errno, "Could not open captured checkpoint.");
+  if (fchmod(fileno(file), 0600) != 0) return absl::ErrnoToStatus(errno, "Could not restrict checkpoint.");
+  size_t written = bytes_written_ + ((spilled_ && !base_) ? 0 : payload_size_);
+  if (!cloned) {
+    if (fseek(file, kStateOffset, SEEK_SET) != 0) return absl::ErrnoToStatus(errno, "Could not seek checkpoint.");
+    std::array<char, 65536> buffer;
+    for (size_t offset = 0; offset < position_;) {
+      const ssize_t n = pread(materialized->fd, buffer.data(), std::min(buffer.size(), position_ - offset), kStateOffset + offset);
+      if (n < 0 && errno == EINTR) continue;
+      if (n <= 0) return absl::ErrnoToStatus(errno ? errno : EIO, "Could not copy captured checkpoint.");
+      ABSL_RETURN_IF_ERROR(WriteAll(file, absl::string_view(buffer.data(), n)));
+      offset += n;
+      written += n;
+    }
+  }
+  if (fseek(file, 0, SEEK_SET) != 0) return absl::ErrnoToStatus(errno, "Could not seek checkpoint header.");
+  ABSL_RETURN_IF_ERROR(WriteAll(file, header));
+  ABSL_RETURN_IF_ERROR(WriteAll(file, key));
+  ABSL_RETURN_IF_ERROR(WriteAll(file, metadata));
+  ABSL_RETURN_IF_ERROR(PublishFile(file, temporary, destination));
+  if (written_bytes) *written_bytes = written + header.size() + key.size() + metadata.size();
+  return absl::OkStatus();
+#endif
+}
