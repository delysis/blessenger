+TEST_F(LitertStateTest, DynamicLoadValidatesBeforeResize) {
+  ASSERT_NO_FATAL_FAILURE(SetUpKV(kTestDynamicModelPath,
+                                  LitertState::AllocationPolicy::kInplace,
+                                  /*batch_size=*/1));
+  ASSERT_OK_AND_ASSIGN(
+      auto source,
+      LitertState::Create(*env_, *compiled_model_, kDecodeSignatureRunner,
+                          /*executor_metadata=*/nullptr,
+                          LitertState::AllocationPolicy::kInplace,
+                          /*batch_size=*/1));
+  ASSERT_OK(source->Resize(*compiled_model_, kDecodeSignatureRunner, 16));
+  ASSERT_OK_AND_ASSIGN(
+      auto buffers,
+      source->GetStateBuffers(*compiled_model_, kDecodeSignatureRunner));
+  for (auto& [_, buffer] : buffers.input_buffers) {
+    ASSERT_NO_FATAL_FAILURE(FillBuffer(buffer, 6));
+  }
+  ASSERT_OK_AND_ASSIGN(auto serialized, source->Serialize());
+  ASSERT_OK_AND_ASSIGN(auto parsed, ParseSerializedState(serialized));
+  EXPECT_THAT(kv_cache_->ValidateLoad(parsed),
+              StatusIs(absl::StatusCode::kInvalidArgument));
+  ASSERT_OK(kv_cache_->ValidateLoad(parsed, /*allow_dynamic_resize=*/true));
+  ASSERT_OK(kv_cache_->Resize(*compiled_model_, kDecodeSignatureRunner, 16));
+  ASSERT_OK(kv_cache_->Load(parsed));
+  ASSERT_OK_AND_ASSIGN(
+      auto restored,
+      kv_cache_->GetStateBuffers(*compiled_model_, kDecodeSignatureRunner));
+  for (auto& [name, buffer] : restored.input_buffers) {
+    ASSERT_NO_FATAL_FAILURE(ExpectBufferFilledWith(buffer, 6)) << name;
+  }
+  // An executor may validate a smaller checkpoint before creating a fresh
+  // allocation; Resize itself only grows, so a direct Load must still fail.
+  ASSERT_OK(kv_cache_->Resize(*compiled_model_, kDecodeSignatureRunner, 32));
+  ASSERT_OK(kv_cache_->ValidateLoad(parsed, /*allow_dynamic_resize=*/true));
+  EXPECT_THAT(kv_cache_->Load(parsed),
+              StatusIs(absl::StatusCode::kInvalidArgument));
+  parsed.tensors[0].descriptor["type"] = -1;
+  EXPECT_THAT(kv_cache_->ValidateLoad(parsed, /*allow_dynamic_resize=*/true),
+              StatusIs(absl::StatusCode::kInvalidArgument));
+}
