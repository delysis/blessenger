+absl::Status LlmLiteRtCompiledModelExecutorBase::ValidateMtpCacheForPersistence(
+    const proto::ExecutorMetadata* executor_metadata,
+    const nlohmann::json& tensor_descriptors, int verify_steps,
+    int current_step, int token_count, int num_entries, uint32_t max_tokens) {
+  if (verify_steps == 0) return absl::OkStatus();
+  if (executor_metadata == nullptr ||
+      executor_metadata->llm_executor_metadata().state_buffers().empty() ||
+      !tensor_descriptors.is_object()) {
+    return absl::FailedPreconditionError(
+        "MTP persistence requires explicitly typed KV cache metadata.");
+  }
+  const auto attention = GetAttentionMaskParams(executor_metadata);
+  auto causal_text = [](proto::AttentionMaskType type) {
+    return type == proto::ATTENTION_MASK_TYPE_CAUSAL ||
+           type == proto::ATTENTION_MASK_TYPE_VISION_BIDIRECTIONAL;
+  };
+  if (!causal_text(attention.global_type)) {
     return absl::FailedPreconditionError(
-        "Disable speculative decoding for persistent sessions; verifier state "
-        "cannot be rolled back to the completed turn boundary.");
+        "MTP persistence requires causal generated-token attention.");
+  }
+  const int64_t rollback_steps =
+      std::max<int64_t>(0, static_cast<int64_t>(token_count) - current_step);
+  // A dynamic entry counter can coexist with smaller, fixed global tensors.
+  // Every global tensor must cover the verifier bound Decode actually used,
+  // including speculative rows hidden by an early stop.
+  int64_t verifier_capacity = num_entries;
+  if (max_tokens > 0) {
+    verifier_capacity = std::min<int64_t>(
+        verifier_capacity, static_cast<int64_t>(max_tokens) - 1);
+  }
+  size_t bank_sizes[2] = {};
+  absl::flat_hash_map<std::string, bool> names;
+  for (const auto& buffer :
+       executor_metadata->llm_executor_metadata().state_buffers()) {
+    const bool local =
+        buffer.type() == proto::StateBuffer::TYPE_LOCAL_KEY_CACHE ||
+        buffer.type() == proto::StateBuffer::TYPE_LOCAL_VALUE_CACHE;
+    if (!local && buffer.type() != proto::StateBuffer::TYPE_GLOBAL_KEY_CACHE &&
+        buffer.type() != proto::StateBuffer::TYPE_GLOBAL_VALUE_CACHE) {
+      return absl::FailedPreconditionError(
+          "MTP persistence cannot roll back recurrent or untyped state.");
+    }
+    std::string name;
+    for (const auto* candidate :
+         {&buffer.prefill_input_name(), &buffer.prefill_output_name(),
+          &buffer.decode_input_name(), &buffer.decode_output_name()}) {
+      if (candidate->empty()) continue;
+      if (!name.empty() && name != *candidate) {
+        return absl::FailedPreconditionError("Inconsistent KV cache names.");
+      }
+      name = *candidate;
+    }
+    if (name.empty() || !names.emplace(name, true).second ||
+        !buffer.has_sequence_axis() || buffer.sequence_axis() < 0) {
+      return absl::FailedPreconditionError("Invalid KV cache metadata.");
+    }
+    for (int bank = 0; bank < 2; ++bank) {
+      auto descriptor =
+          tensor_descriptors.find(absl::StrCat(bank + 1, "/", name));
+      if (descriptor == tensor_descriptors.end()) {
+        if (bank == 1) continue;
+        return absl::FailedPreconditionError("Missing KV cache buffer.");
+      }
+      ++bank_sizes[bank];
+      auto shape = descriptor->find("shape");
+      if (shape == descriptor->end() || !shape->is_array() ||
+          static_cast<size_t>(buffer.sequence_axis()) >= shape->size()) {
+        return absl::FailedPreconditionError("Invalid KV cache sequence axis.");
+      }
+      ABSL_ASSIGN_OR_RETURN(
+          int capacity, ReadContextInteger((*shape)[buffer.sequence_axis()]));
+      if (local) {
+        if (!causal_text(attention.local_type) ||
+            !IsMtpRingSnapshotSafe(
+                capacity, attention.sliding_window_size.value_or(0),
+                verify_steps, rollback_steps)) {
+          return absl::FailedPreconditionError(
+              "MTP local cache has insufficient ring capacity for the window, "
+              "verifier batch, and logical rewind.");
+        }
+      } else if (capacity < verify_steps || capacity < verifier_capacity ||
+                 static_cast<int64_t>(std::max(current_step, token_count)) >
+                     static_cast<int64_t>(capacity) + 1) {
+        return absl::FailedPreconditionError(
+            "MTP global cache capacity exceeded.");
+      }
+    }
+  }
+  if (bank_sizes[0] + bank_sizes[1] != tensor_descriptors.size() ||
+      (bank_sizes[1] != 0 && bank_sizes[1] != bank_sizes[0])) {
+    return absl::FailedPreconditionError("Unexpected MTP state buffers.");
   }
+  return absl::OkStatus();
+}
