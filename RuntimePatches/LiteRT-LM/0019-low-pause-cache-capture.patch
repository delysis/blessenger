+TEST_F(SessionCacheFileTest, SpilledScatteredDeltasPreserveLogicalOffsets) {
+  std::string bytes(80 * 1024 * 1024, 'a');
+  std::vector<uint32_t> versions(bytes.size() / 4096, 1);
+  auto first = CapturedCacheFile::Create(directory_.string());
+  ASSERT_TRUE(first.ok());
+  ASSERT_TRUE((*first)->WriteTracked(bytes.data(), bytes.size(), 101, versions.data(), versions.size()));
+  ASSERT_TRUE((*first)->Finish().ok());
+  ASSERT_TRUE((*first)->Publish(path_, "first", 1, "m", nullptr).ok());
+  // Forty MiB of disjoint four-KiB runs crosses the memory bound while
+  // ensuring payload offsets differ from logical state offsets.
+  for (size_t block = 0; block < versions.size(); block += 2) {
+    std::fill_n(bytes.data() + block * 4096, 4096, 'b');
+    versions[block] = 2;
+  }
+  auto pending = CapturedCacheFile::Create(directory_.string(), *first);
+  ASSERT_TRUE(pending.ok());
+  ASSERT_TRUE((*pending)->WriteTracked(bytes.data(), bytes.size(), 101, versions.data(), versions.size()));
+  ASSERT_TRUE((*pending)->Finish().ok());
+  // A newer capture must also preserve changes in an unpublished spilled base.
+  bytes[4096] = 'c';
+  versions[1] = 3;
+  auto latest = CapturedCacheFile::Create(directory_.string(), *pending);
+  ASSERT_TRUE(latest.ok());
+  ASSERT_TRUE((*latest)->WriteTracked(bytes.data(), bytes.size(), 101, versions.data(), versions.size()));
+  ASSERT_TRUE((*latest)->Finish().ok());
+  ASSERT_TRUE((*latest)->Publish(path_, "latest", 3, "m", nullptr).ok());
+  auto loaded = ReadSessionCacheFile(path_, "latest");
+  ASSERT_TRUE(loaded.ok()) << loaded.status();
+  EXPECT_EQ(loaded->state, bytes);
+}
