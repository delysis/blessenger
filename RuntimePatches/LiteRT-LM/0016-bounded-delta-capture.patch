+TEST_F(SessionCacheFileTest, BoundedCaptureDeathKeepsLastPublishedGeneration) {
+  const std::string old_state(2 * 1024 * 1024, 'a');
+  const std::string new_state(2 * 1024 * 1024, 'b');
+  for (const int delay_us : {0, 100, 1000, 5000, 20000, 100000}) {
+    auto base = CapturedCacheFile::Create(directory_.string());
+    ASSERT_TRUE(base.ok()) << base.status();
+    std::ostream output(base->get()); output.write(old_state.data(), old_state.size());
+    ASSERT_TRUE((*base)->Finish().ok());
+    ASSERT_TRUE((*base)->Publish(path_, "key", 1, "old", nullptr).ok());
+    const pid_t child = fork();
+    ASSERT_GE(child, 0);
+    if (child == 0) {
+      auto captured = CapturedCacheFile::Create(directory_.string(), *base);
+      if (!captured.ok()) _exit(1);
+      std::ostream next(captured->get()); next.write(new_state.data(), new_state.size());
+      if (!next.good() || !(*captured)->Finish().ok()) _exit(2);
+      _exit((*captured)->Publish(path_, "key", 2, "new", nullptr).ok() ? 0 : 3);
+    }
+    usleep(delay_us); kill(child, SIGKILL);
