+int LlmLiteRtNpuCompiledModelExecutor::SnapshotContextCapacity(
+    const ContextGroup& group) const {
+  int capacity = std::numeric_limits<int>::max();
+  if (is_dynamic_model_) {
+    capacity = dynamic_kv_cache_capacity_;
+  } else if (group.context_size > 0) {
+    capacity = group.context_size;
+  }
+  // Match the verifier's logical bound, including its uncached bonus token.
+  return std::min<int64_t>(
+      capacity, static_cast<int64_t>(executor_settings_.GetMaxNumTokens()) - 1);
+}
+
+void LlmLiteRtNpuCompiledModelExecutor::RecordMtpSnapshotGeometry() {
+  if (speculative_decoding_type_ == SpeculativeDecodingType::kNone ||
+      !mtp_snapshot_geometry_valid_) {
+    return;
+  }
+  if (executor_metadata_ == nullptr ||
+      !executor_metadata_->has_llm_executor_metadata()) {
+    mtp_snapshot_geometry_valid_ = false;
+    return;
+  }
+  const auto& metadata = executor_metadata_->llm_executor_metadata();
+  const int window = metadata.attention_mask_settings().sliding_window_size();
+  for (const auto& group : context_groups_) {
+    const int capacity = SnapshotContextCapacity(group);
+    const auto verify_steps = GetMtpVerifierSteps(group);
+    if (!verify_steps.ok()) {
+      mtp_snapshot_geometry_valid_ = false;
+      return;
+    }
+    for (const auto& state : metadata.state_buffers()) {
+      const bool local =
+          state.type() == proto::StateBuffer::TYPE_LOCAL_KEY_CACHE ||
+          state.type() == proto::StateBuffer::TYPE_LOCAL_VALUE_CACHE;
+      if (!local && state.type() != proto::StateBuffer::TYPE_GLOBAL_KEY_CACHE &&
+          state.type() != proto::StateBuffer::TYPE_GLOBAL_VALUE_CACHE) {
+        continue;
+      }
+      auto buffer = group.input_kv_cache_buffers.find(state.decode_input_name());
+      if (buffer == group.input_kv_cache_buffers.end()) {
+        buffer = group.input_kv_cache_buffers.find(state.prefill_input_name());
+      }
+      if (buffer == group.input_kv_cache_buffers.end() ||
+          !state.has_sequence_axis() || state.sequence_axis() < 0) {
+        mtp_snapshot_geometry_valid_ = false;
+        return;
+      }
+      auto type = buffer->second.TensorType();
+      if (!type.HasValue() ||
+          static_cast<size_t>(state.sequence_axis()) >=
+              type->Layout().Dimensions().size()) {
+        mtp_snapshot_geometry_valid_ = false;
+        return;
+      }
+      const int actual = type->Layout().Dimensions()[state.sequence_axis()];
+      if (local ? !IsMtpRingSnapshotSafe(actual, window, *verify_steps)
+                : actual < capacity) {
+        mtp_snapshot_geometry_valid_ = false;
+        return;
+      }
+    }
+  }
+}
