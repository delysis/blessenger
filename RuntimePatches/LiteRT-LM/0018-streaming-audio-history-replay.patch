+absl::Status Conversation::BeginAudioInput(const Message& prototype) {
+  ABSL_RETURN_IF_ERROR(CheckCacheConfig(config_));
+  if (streamed_audio_ || !prototype.is_object() ||
+      prototype.value("role", "") != "user") {
+    return absl::FailedPreconditionError("Audio input requires an idle user turn.");
+  }
+  ABSL_RETURN_IF_ERROR(session_->WaitUntilDone());
+  ABSL_ASSIGN_OR_RETURN(auto properties, engine_.GetAudioExecutorProperties());
+  if (properties.input_frame_count <= 0 || properties.streaming_chunk_overlap_size != 0) {
+    return absl::UnimplementedError("Incremental input requires an independent encoder window.");
+  }
+  ABSL_LOG(INFO) << "Audio input window=" << properties.input_frame_count
+                 << " shrink=" << properties.audio_shrink_factor
+                 << " streaming=" << properties.is_streaming_model;
+  auto stream = std::make_unique<StreamedAudio>();
+  stream->window_frames = properties.input_frame_count;
+  ABSL_ASSIGN_OR_RETURN(stream->rendered, GetSingleTurnText(prototype, OptionalArgs()));
+  ABSL_ASSIGN_OR_RETURN(auto inputs, model_data_processor_->ToInputDataVector(
+      stream->rendered, nlohmann::ordered_json::array({prototype}), std::monostate()));
+  std::vector<InputData> prefix;
+  bool audio_seen = false, end_seen = false;
+  for (auto& input : inputs) {
+    if (std::holds_alternative<InputAudio>(input)) {
+      if (audio_seen) return absl::InvalidArgumentError("Expected exactly one audio input.");
+      audio_seen = true;
+    } else if (std::holds_alternative<InputAudioEnd>(input)) {
+      if (!audio_seen || end_seen) return absl::InvalidArgumentError("Invalid audio end marker.");
+      end_seen = true;
+      stream->suffix.push_back(std::move(input));
+    } else if (!std::holds_alternative<InputText>(input)) {
+      return absl::InvalidArgumentError("Streaming input supports audio and text only.");
+    } else if (!audio_seen) {
+      prefix.push_back(std::move(input));
+    } else {
+      if (!end_seen) return absl::InvalidArgumentError("Text inside audio input.");
+      stream->suffix.push_back(std::move(input));
+    }
+  }
+  if (!audio_seen || !end_seen || prefix.empty()) {
+    return absl::InvalidArgumentError("Missing audio template boundary.");
+  }
+  const auto& processor_config = std::get<Gemma4DataProcessorConfig>(config_.GetProcessorConfig());
+  auto audio_config = litert::support::AudioPreprocessorConfig::CreateDefaultGemma4Config(
+      processor_config.skip_mel_spectrogram_extraction);
+  audio_config.SetBufferLastFrame(true);
+  ABSL_ASSIGN_OR_RETURN(stream->processor,
+      litert::support::AudioPreprocessorMiniAudio::Create(audio_config));
+  ABSL_RETURN_IF_ERROR(session_->RunPrefill(prefix));
+  streamed_audio_ = std::move(stream);
+  return absl::OkStatus();
+}
+
+absl::Status Conversation::AppendAudioInput(absl::Span<const float> samples) {
+  if (!streamed_audio_ || streamed_audio_->finished || samples.empty() ||
+      samples.size() > 16000 || streamed_audio_->samples + samples.size() > 30 * 16000) {
+    return absl::InvalidArgumentError("Invalid streaming audio append.");
+  }
+  for (float sample : samples) {
+    if (!std::isfinite(sample)) return absl::InvalidArgumentError("Nonfinite PCM.");
+  }
+  auto audio = streamed_audio_->processor->Preprocess(
+      InputAudio(std::vector<float>(samples.begin(), samples.end())));
+  streamed_audio_->samples += samples.size();
+  if (!audio.ok()) {
+    if (audio.status().message() == "Not enough samples to form any frame.") return absl::OkStatus();
+    return audio.status();
+  }
+  return PrefillAudioFeatures(std::move(*audio), false);
+}
+
+absl::Status Conversation::PrefillAudioFeatures(InputAudio audio, bool flush) {
+  ABSL_ASSIGN_OR_RETURN(auto tensor, audio.GetPreprocessedAudioTensor());
+  LITERT_ASSIGN_OR_RETURN(auto type, tensor->TensorType());
+  const auto& dims = type.Layout().Dimensions();
+  if (dims.size() != 3 || dims[0] != 1 || dims[1] < 0 || dims[2] <= 0) {
+    return absl::InvalidArgumentError("Unexpected audio feature shape.");
+  }
+  auto& stream = *streamed_audio_;
+  if (stream.feature_width && stream.feature_width != dims[2]) {
+    return absl::InvalidArgumentError("Audio feature width changed.");
+  }
+  stream.feature_width = dims[2];
+  const size_t old = stream.features.size();
+  stream.features.resize(old + dims[1] * dims[2]);
+  LITERT_RETURN_IF_ERROR(const_cast<TensorBuffer*>(tensor)->Read<float>(absl::MakeSpan(stream.features).subspan(old)));
+  return PrefillBufferedAudio(flush);
+}
+
+absl::Status Conversation::PrefillBufferedAudio(bool flush) {
+  auto& stream = *streamed_audio_;
+  if (stream.features.empty()) return absl::OkStatus();
+  const size_t window = stream.window_frames * stream.feature_width;
+  size_t consumed = 0;
+  while (stream.features.size() - consumed >= window ||
+         (flush && consumed < stream.features.size())) {
+    const size_t count = std::min(window, stream.features.size() - consumed);
+    RankedTensorType block_type(GetElementType<float>(),
+        Layout(Dimensions({1, static_cast<int>(count / stream.feature_width), stream.feature_width})));
+    LITERT_ASSIGN_OR_RETURN(auto block, TensorBuffer::CreateManagedHostMemory(block_type, count * sizeof(float)));
+    LITERT_RETURN_IF_ERROR(block.Write<float>(absl::MakeConstSpan(stream.features).subspan(consumed, count)));
+    std::vector<InputData> inputs;
+    inputs.emplace_back(InputAudio(std::move(block)));
+    ABSL_RETURN_IF_ERROR(session_->RunPrefill(inputs));
+    consumed += count;
+  }
+  stream.features.erase(stream.features.begin(), stream.features.begin() + consumed);
+  return absl::OkStatus();
+}
+
+absl::Status Conversation::FinishAudioInput() {
+  if (!streamed_audio_ || streamed_audio_->finished || streamed_audio_->samples == 0) {
+    return absl::FailedPreconditionError("No open audio input.");
+  }
+  auto audio = streamed_audio_->processor->Flush();
+  if (audio.ok()) {
+    ABSL_RETURN_IF_ERROR(PrefillAudioFeatures(std::move(*audio), true));
+  } else if (audio.status().message() != "Not enough samples to form any frame.") {
+    return audio.status();
+  }
+  ABSL_RETURN_IF_ERROR(PrefillBufferedAudio(true));
+  streamed_audio_->finished = true;
+  return absl::OkStatus();
+}
+
+absl::Status Conversation::PrefillHistorySuffix(std::vector<Message> messages) {
+  ABSL_RETURN_IF_ERROR(CheckCacheConfig(config_));
+  ABSL_RETURN_IF_ERROR(CheckCacheHistory(messages));
+  if (streamed_audio_) return absl::FailedPreconditionError("Audio input is open.");
+  ABSL_RETURN_IF_ERROR(session_->WaitUntilDone());
+  std::vector<Message> old;
+  {
+    absl::MutexLock lock(history_mutex_);
+    if (is_appending_message_ || checkpoint_message_index_.has_value()) {
+      return absl::FailedPreconditionError("Cannot replay into a pending turn.");
+    }
+    if (!history_.empty()) ABSL_RETURN_IF_ERROR(CheckCacheHistory(history_));
+    old = history_;
+  }
+  ABSL_ASSIGN_OR_RETURN(auto inputs, GetInputDataVectorForMessages(
+      old, messages, OptionalArgs(), /*include_preface=*/old.empty()));
+  ABSL_RETURN_IF_ERROR(session_->RunPrefill(inputs));
+  {
+    absl::MutexLock lock(history_mutex_);
+    history_.insert(history_.end(), messages.begin(), messages.end());
+  }
+  return absl::OkStatus();
+}
