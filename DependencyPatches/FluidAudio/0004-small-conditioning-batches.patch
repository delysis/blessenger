+/// Immutable model handles; inference state remains in the caller-owned KV arrays.
+struct PocketTtsConditioners: @unchecked Sendable {
+    let primary: MLModel
+    var small: MLModel? = nil
+
+    func model(for tokenCount: Int) -> MLModel {
+        if tokenCount <= 16, let small { return small }
+        return primary
+    }
+}
