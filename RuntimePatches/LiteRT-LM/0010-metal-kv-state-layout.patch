 using ::testing::status::StatusIs;
 
+// A registered provider for testing codec admission and transfer calls. This
+// deliberately supplies canonical host bytes; it does not emulate Metal's
+// physical layout, conversion, or synchronization.
+struct MappedTestMemory : HwMemoryInfo {
+  std::vector<char> bytes;
+  int locks = 0;
+};
+
+LiteRtStatus CreateMappedTestMemory(
+    LiteRtGpuDeviceId, LiteRtGpuQueueId, const LiteRtRankedTensorType*,
+    LiteRtTensorBufferType, size_t, size_t packed_bytes,
+    HwMemoryInfoPtr* memory) {
+  auto* info = new MappedTestMemory{};
+  info->bytes.resize(packed_bytes);
+  info->memory_handle = info;
+  *memory = info;
+  return kLiteRtStatusOk;
+}
+
+LiteRtStatus DestroyMappedTestMemory(HwMemoryInfoPtr memory) {
+  delete static_cast<MappedTestMemory*>(memory);
+  return kLiteRtStatusOk;
+}
+
+LiteRtStatus LockMappedTestMemory(HwMemoryInfoPtr memory,
+                                 LiteRtTensorBufferLockMode, void** data) {
+  auto* info = static_cast<MappedTestMemory*>(memory);
+  ++info->locks;
+  *data = info->bytes.data();
+  return kLiteRtStatusOk;
+}
+
+LiteRtStatus FinishMappedTestMemory(HwMemoryInfoPtr) {
+  return kLiteRtStatusOk;
+}
