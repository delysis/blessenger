+absl::Status CheckCacheConfig(const ConversationConfig& config) {
+  // Gemma4's processor has no mutable state between complete turns. Other
+  // processors need their own state contract before enabling persistence.
+  const auto& tools = std::get<JsonPreface>(config.GetPreface()).tools;
+  if (!config.GetSessionConfig().GetLlmModelType().has_gemma4() ||
+      !std::holds_alternative<Gemma4DataProcessorConfig>(
+          config.GetProcessorConfig()) ||
+      !tools.empty() ||
+      config.prefill_preface_on_init() ||
+      config.filter_channel_content_from_kv_cache() ||
+      config.constrained_decoding_enabled() ||
+      config.constraint_provider_config().has_value()) {
+    return absl::FailedPreconditionError(
+        "Conversation cache requires Gemma4 without prefilled preface, "
+        "channel filtering, constraints, or tools.");
+  }
+  return absl::OkStatus();
+}
+
+absl::Status CheckCacheHistory(absl::Span<const Message> history) {
+  if (history.empty() || history.size() % 2 != 0) {
+    return absl::InvalidArgumentError("History must contain complete turns.");
+  }
+  for (size_t i = 0; i < history.size(); ++i) {
+    const auto& message = history[i];
+    if (!message.is_object() || !message.contains("role") ||
+        message["role"] != (i % 2 == 0 ? "user" : "assistant") ||
+        !message.contains("content") || message.contains("tool_calls")) {
+      return absl::InvalidArgumentError("Invalid text/audio conversation history.");
+    }
+    const auto& content = message["content"];
+    if (content.is_string()) continue;
+    if (!content.is_array()) {
+      return absl::InvalidArgumentError("History content must be text or an array.");
+    }
+    for (const auto& part : content) {
+      if (!part.is_object() || !part.contains("type")) {
+        return absl::InvalidArgumentError("Invalid history content part.");
+      }
+      if (part["type"] == "text" && part.contains("text") &&
+          part["text"].is_string()) continue;
+      if (i % 2 == 0 && part["type"] == "audio" &&
+          part.contains("path") != part.contains("blob")) {
+        const auto& source = part[part.contains("path") ? "path" : "blob"];
+        if (source.is_string() && !source.get_ref<const std::string&>().empty()) {
+          continue;
+        }
+      }
+      return absl::InvalidArgumentError("Unsupported history content part.");
+    }
+  }
+  return absl::OkStatus();
+}
