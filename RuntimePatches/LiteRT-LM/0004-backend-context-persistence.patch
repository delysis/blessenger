+absl::StatusOr<StateTensorBuffers> DuplicateNpuState(const ContextGroup& group) {
+  StateTensorBuffers buffers;
+  buffers.reserve(group.input_kv_cache_buffers.size());
+  for (const auto& [name, buffer] : group.input_kv_cache_buffers) {
+    LITERT_ASSIGN_OR_RETURN(auto alias, buffer.Duplicate());
+    buffers.emplace(std::string(name), std::move(alias));
+  }
+  return buffers;
+}
+
+// Before reallocating a dynamic context, check names, types and every axis that
+// cannot change with its sequence capacity. Exact allocated descriptors are
+// checked again before writing any tensor.
+absl::Status ValidateNpuStateForResize(
+    const ParsedSerializedState& state, const StateTensorBuffers& buffers,
+    const NpuModelGeometry& geometry, int capacity,
+    const proto::ExecutorMetadata* metadata) {
+  if (state.tensors.size() != buffers.size()) {
+    return absl::FailedPreconditionError("NPU state buffer count mismatch.");
+  }
+  for (const auto& tensor : state.tensors) {
+    auto buffer = buffers.find(tensor.name);
+    if (buffer == buffers.end()) {
+      return absl::FailedPreconditionError("Unknown NPU state buffer.");
+    }
+    ABSL_ASSIGN_OR_RETURN(auto expected, DescribeStateTensor(buffer->second));
+    // Match ResizeDynamicInputs: K grows along axis 2, V along axis 3;
+    // recurrent C state does not grow with the context length.
+    int axis = -1;
+    if (expected["shape"].size() >= 4) {
+      if (absl::StartsWith(tensor.name, kKvCacheKRootName)) axis = 2;
+      if (absl::StartsWith(tensor.name, kKvCacheVRootName)) axis = 3;
+    }
+    if (axis >= 0) {
+      int entries = capacity;
+      const proto::StateBuffer* declared = nullptr;
+      if (metadata != nullptr) {
+        for (const auto& info : metadata->llm_executor_metadata().state_buffers()) {
+          if (tensor.name == info.prefill_input_name() ||
+              tensor.name == info.decode_input_name()) {
+            declared = &info;
+            break;
+          }
+        }
+      }
+      if (declared != nullptr) {
+        if (declared->has_sequence_axis() && declared->sequence_axis() != axis) {
+          return absl::FailedPreconditionError("Incompatible NPU sequence axis.");
+        }
+        if (declared->has_minimum_sequence_length()) {
+          entries = std::max(entries, declared->minimum_sequence_length());
+        }
+        if (declared->has_maximum_sequence_length()) {
+          entries = std::min(entries, declared->maximum_sequence_length());
+        }
+      } else {
+        const auto info = geometry.kv_buffer_info.find(tensor.name);
+        if (info != geometry.kv_buffer_info.end() && info->second.is_local) {
+          // Heuristic local caches have a fixed physical ring-buffer length.
+          ABSL_ASSIGN_OR_RETURN(entries,
+                                ReadContextInteger(expected["shape"][axis]));
+        }
+      }
+      if (entries <= 0) {
+        return absl::FailedPreconditionError("Invalid NPU cache capacity.");
+      }
+      expected["shape"][axis] = entries;
+    }
+    // The parser has already checked that bytes exactly matches shape/type.
+    expected["bytes"] = tensor.descriptor.at("bytes");
+    if (expected.dump() != tensor.descriptor.dump()) {
+      return absl::FailedPreconditionError("NPU state descriptor mismatch.");
+    }
+  }
+  return absl::OkStatus();
+}
