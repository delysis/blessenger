+#ifndef THIRD_PARTY_ODML_LITERT_LM_RUNTIME_EXECUTOR_CONTEXT_SERIALIZATION_H_
+#define THIRD_PARTY_ODML_LITERT_LM_RUNTIME_EXECUTOR_CONTEXT_SERIALIZATION_H_
+
+#include <cstddef>
+#include <string>
+
+#include "absl/status/status.h"  // from @com_google_absl
+#include "absl/status/statusor.h"  // from @com_google_absl
+#include "absl/strings/string_view.h"  // from @com_google_absl
+#include "nlohmann/json.hpp"  // from @nlohmann_json
+#include "runtime/executor/llm_executor_processed_tokens.h"
+#include "runtime/executor/llm_executor_settings.h"
+
+namespace litert::lm {
+
+inline constexpr size_t kMaxContextMetadataBytes = 16 * 1024 * 1024;
+
+struct ContextMetadata {
+  ProcessedTokens tokens;
+  int current_step = 0;
+  bool ran_decode = false;
+  size_t candidate_count = 1;
+  nlohmann::json backend;
+};
+
+absl::StatusOr<std::string> SerializeContextMetadata(
+    const LlmExecutorSettings& settings, const ProcessedTokens& tokens,
+    int current_step, bool ran_decode, nlohmann::json backend);
+
+// Parses and validates all token bookkeeping before any live state is changed.
+// Model/build identity is checked by the caller; this checks execution settings.
+absl::StatusOr<ContextMetadata> ParseContextMetadata(
+    absl::string_view serialized, const LlmExecutorSettings& settings);
+
+// Checks token IDs before lookup/sampling and optional pending embeddings
+// against the target model's per-token input sizes (in floats).
+absl::Status ValidateContextTokens(const ProcessedTokens& tokens, int vocab_size,
+                                  size_t embedding_size,
+                                  size_t per_layer_embedding_size);
+
+absl::StatusOr<int> ReadContextInteger(const nlohmann::json& value);
+
+}  // namespace litert::lm
+
+#endif  // THIRD_PARTY_ODML_LITERT_LM_RUNTIME_EXECUTOR_CONTEXT_SERIALIZATION_H_
