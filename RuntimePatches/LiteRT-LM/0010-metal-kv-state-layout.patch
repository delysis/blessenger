+TEST_F(StateSerializationTest, AdmitsConvertedMetalWithoutPhysicalPadding) {
+  const std::vector<RankedTensorType> types = {
+      {ElementType::Float16, Layout({1, 4}, {16, 0})},
+      {ElementType::Float16, Layout({1, 8, 4}, {16, 0, 0})},
+      {ElementType::Float16, Layout({1, 8, 4, 12}, {16, 0, 0, 0})},
+      {ElementType::Float16, Layout(Dimensions{1, 8, 4, 12})},
+  };
+  for (const auto& type : types) {
+    StateTensorBuffers source, target;
+    const auto dims = type.Layout().Dimensions();
+    ASSERT_NO_FATAL_FAILURE(AddBuffer(
+        source, "kv", ElementType::Float16, Dimensions(dims.begin(), dims.end()),
+        7));
+    ASSERT_NO_FATAL_FAILURE(AddMappedBuffer(target, "kv", type));
+    ASSERT_OK_AND_ASSIGN(auto serialized,
+                         SerializeState(nlohmann::json::object(), source));
+    ASSERT_OK_AND_ASSIGN(auto parsed, ParseSerializedState(serialized));
+    const auto handle = target.at("kv").Get();
+    ASSERT_OK(LoadSerializedState(parsed, target));
+    EXPECT_EQ(target.at("kv").Get(), handle);
+    ASSERT_OK_AND_ASSIGN(auto restored,
+                         SerializeState(nlohmann::json::object(), target));
+    EXPECT_EQ(restored, serialized);
+  }
+}
+
+TEST_F(StateSerializationTest, RejectsUnsafeMetalLayoutsBeforeMapping) {
+  struct Case {
+    RankedTensorType type;
+    TensorBufferType buffer_type = TensorBufferType::kMetalBufferFp16;
+    size_t extra_bytes = 0;
+  };
+  const std::vector<Case> cases = {
+      {{ElementType::Float16, Layout({1, 8, 4, 11}, {16, 0, 0, 0})}},
+      {{ElementType::Float16, Layout(Dimensions{1, 8, 4, 11})}},
+      {{ElementType::Float32, Layout({1, 8, 4, 12}, {16, 0, 0, 0})}},
+      {{ElementType::Float16, Layout({4}, {16})}},
+      {{ElementType::Float16, Layout({1, 1, 1, 1, 4}, {16, 0, 0, 0, 0})}},
+      {{ElementType::Float16, Layout({1, 0, 4, 12}, {16, 0, 0, 0})}},
+      {{ElementType::Float16, Layout({1, 8, 4, 12}, {8, 0, 0, 0})}},
+      {{ElementType::Float16, Layout({1, 8, 4, 12}, {16, 0, 0, 0})},
+       TensorBufferType::kMetalBufferFp16, 2},
+      {{ElementType::Float16, Layout({1, 8, 4, 12}, {16, 0, 0, 0})},
+       TensorBufferType::kMetalBufferPacked},
+  };
+  for (size_t i = 0; i < cases.size(); ++i) {
+    SCOPED_TRACE(i);
+    StateTensorBuffers buffers;
+    ASSERT_NO_FATAL_FAILURE(AddMappedBuffer(buffers, "kv", cases[i].type,
+                                            cases[i].buffer_type,
+                                            cases[i].extra_bytes));
+    EXPECT_THAT(DescribeStateTensor(buffers.at("kv")),
+                StatusIs(absl::StatusCode::kUnimplemented));
+    EXPECT_FALSE(SerializeState(nlohmann::json::object(), buffers).ok());
+    HwMemoryHandle memory;
+    LITERT_ASSERT_OK(LiteRtGetTensorBufferCustomTensorBufferHandle(
+        buffers.at("kv").Get(), &memory));
+    EXPECT_EQ(static_cast<MappedTestMemory*>(memory)->locks, 0);
+  }
+}
