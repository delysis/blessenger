+TEST(TensorBufferRegistryTest, ExplicitHostStagingRelease) {
+  LITERT_ASSERT_OK_AND_ASSIGN(auto env, litert::Environment::Create({}));
+  litert::internal::TensorBufferRegistry* registry = nullptr;
+  LITERT_ASSERT_OK(LiteRtGetTensorBufferRegistry(
+      env.Get(), reinterpret_cast<void**>(&registry)));
+  const litert::internal::CustomTensorBufferHandlers handlers = {
+      .create_func = CreateMyCustomTensorBuffer,
+      .destroy_func = DestroyMyCustomTensorBuffer,
+      .lock_func = LockMyCustomTensorBuffer,
+      .unlock_func = UnlockMyCustomTensorBuffer};
+  constexpr auto type = kLiteRtTensorBufferTypeUserCustomBuffer;
+  LITERT_ASSERT_OK(registry->RegisterHandlers(type, handlers));
+  constexpr LiteRtRankedTensorType tensor_type = {
+      kLiteRtElementTypeInt32, litert::BuildLayout({8})};
+  LITERT_ASSERT_OK_AND_ASSIGN(auto buffer, LiteRtTensorBufferT::CreateManaged(
+                                              env.Get(), type, tensor_type, 32));
+  LITERT_ASSERT_OK_AND_ASSIGN(auto custom, buffer->GetCustomBuffer());
+  auto* info = static_cast<CustomHwMemoryInfo*>(custom->hw_memory_info());
+
+  auto unsupported = buffer->ReleaseHostStagingMemory();
+  ASSERT_FALSE(unsupported);
+  EXPECT_EQ(unsupported.Error().Status(), kLiteRtStatusErrorUnsupported);
+  EXPECT_EQ(info->mapped_ptr, nullptr);
+
+  LITERT_ASSERT_OK(registry->RegisterHostStagingMemoryHandler(
+      type, ReleaseMyHostStagingMemory));
+  // Re-registering a V1 provider must preserve its separately registered tail.
+  LITERT_ASSERT_OK(registry->RegisterHandlers(type, handlers));
+  LITERT_ASSERT_OK_AND_ASSIGN(void* data,
+                             buffer->Lock(kLiteRtTensorBufferLockModeWrite));
+  memset(data, 0x5a, 32);
+  EXPECT_FALSE(buffer->ReleaseHostStagingMemory());
+  EXPECT_EQ(info->releases, 0);
+  LITERT_ASSERT_OK(buffer->Unlock());
+  EXPECT_EQ(info->releases, 0);
+  EXPECT_NE(info->mapped_ptr, nullptr);
+
+  info->release_status = kLiteRtStatusErrorRuntimeFailure;
+  EXPECT_FALSE(buffer->ReleaseHostStagingMemory());
+  EXPECT_NE(info->mapped_ptr, nullptr);
+  info->release_status = kLiteRtStatusOk;
+  LITERT_ASSERT_OK(buffer->ReleaseHostStagingMemory());
+  EXPECT_EQ(info->mapped_ptr, nullptr);
+  LITERT_ASSERT_OK(buffer->ReleaseHostStagingMemory());
+  LITERT_ASSERT_OK_AND_ASSIGN(data,
+                             buffer->Lock(kLiteRtTensorBufferLockModeRead));
+  EXPECT_EQ(memcmp(data, info->contents.data(), 32), 0);
+  EXPECT_EQ(static_cast<char*>(data)[0], 0x5a);
+  LITERT_ASSERT_OK(buffer->Unlock());
+  LITERT_ASSERT_OK(buffer->ReleaseHostStagingMemory());
+}
