+absl::StatusOr<int> GetMtpVerifierSteps(const ContextGroup& group) {
+  const auto& outputs =
+      group.text_decoder_inference_context.verify_output_buffers;
+  const auto activations =
+      outputs.find(TextDecoderSignatures::kLastLayerActivationsOutput);
+  if (activations == outputs.end()) {
+    return absl::FailedPreconditionError("MTP verifier activations unavailable.");
+  }
+  LITERT_ASSIGN_OR_RETURN(auto type, activations->second.TensorType());
+  const auto dimensions = type.Layout().Dimensions();
+  if (dimensions.size() != 3 || dimensions[0] != 1 || dimensions[1] <= 0 ||
+      dimensions[2] <= 0) {
+    return absl::FailedPreconditionError("Invalid MTP verifier activation shape.");
+  }
+  return dimensions[1];
+}
+
+absl::StatusOr<int> GetMtpVerifierSteps(
+    const std::vector<ContextGroup>& groups) {
+  if (groups.empty()) {
+    return absl::FailedPreconditionError("MTP context groups unavailable.");
+  }
+  ABSL_ASSIGN_OR_RETURN(const int steps, GetMtpVerifierSteps(groups.front()));
+  for (size_t i = 1; i < groups.size(); ++i) {
+    ABSL_ASSIGN_OR_RETURN(const int group_steps, GetMtpVerifierSteps(groups[i]));
+    if (group_steps != steps) {
+      return absl::FailedPreconditionError(
+          "MTP verifier length differs between context groups.");
+    }
+  }
+  return steps;
+}
