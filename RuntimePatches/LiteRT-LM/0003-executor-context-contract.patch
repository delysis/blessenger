+#include "runtime/executor/context_serialization.h"
+
+#include <cstdint>
+#include <cstring>
+#include <limits>
+#include <memory>
+#include <optional>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include <gmock/gmock.h>
+#include <gtest/gtest.h>
+#include "absl/status/status.h"  // from @com_google_absl
+#include "nlohmann/json.hpp"  // from @nlohmann_json
+#include "runtime/executor/executor_settings_base.h"
+#include "runtime/executor/llm_executor_processed_tokens.h"
+#include "runtime/executor/llm_executor_settings.h"
+#include "runtime/util/test_utils.h"  // IWYU pragma: keep
+
+namespace litert::lm {
+namespace {
+
+using ::testing::status::StatusIs;
+
+class ContextSerializationTest : public ::testing::Test {
+ protected:
+  void SetUp() override {
+    ASSERT_OK_AND_ASSIGN(auto assets, ModelAssets::Create("model.litertlm"));
+    ASSERT_OK_AND_ASSIGN(auto settings,
+                         LlmExecutorSettings::CreateDefault(std::move(assets)));
+    settings.SetMaxNumTokens(64);
+    AdvancedSettings advanced;
+    advanced.num_output_candidates = 2;
+    settings.SetAdvancedSettings(advanced);
+    settings_ = std::move(settings);
+  }
+
+  const LlmExecutorSettings& settings() const { return *settings_; }
+
+ private:
+  std::optional<LlmExecutorSettings> settings_;
+};
+
+TEST_F(ContextSerializationTest, PreservesCandidatesAndPendingEmbeddingBits) {
+  // Include negative modality IDs and float representations JSON numbers
+  // cannot preserve (negative zero and a NaN payload).
+  const std::vector<uint32_t> bits = {0x80000000, 0x7fc12345, 0x3f800000};
+  std::vector<float> embedding(bits.size());
+  std::memcpy(embedding.data(), bits.data(), bits.size() * sizeof(uint32_t));
+  ASSERT_OK_AND_ASSIGN(
+      auto tokens,
+      ProcessedTokens::CreateFromTokens(
+          {{-1, 11}, {-1, 21}},
+          {std::make_shared<TokenData>(42, embedding, std::vector<float>{2}),
+           std::make_shared<TokenData>(43, std::vector<float>{}, embedding)}));
+  const nlohmann::json backend = {{"kind", "test"}, {"phase", 3}};
+  ASSERT_OK_AND_ASSIGN(auto serialized, SerializeContextMetadata(
+                                            settings(), tokens, 3, true, backend));
+  ASSERT_OK_AND_ASSIGN(auto restored,
+                       ParseContextMetadata(serialized, settings()));
+  EXPECT_EQ(restored.current_step, 3);
+  EXPECT_TRUE(restored.ran_decode);
+  EXPECT_EQ(restored.candidate_count, 2);
+  EXPECT_EQ(restored.backend, backend);
+  EXPECT_EQ(restored.tokens.GetCopyOfTokens(), tokens.GetCopyOfTokens());
+  const auto pending = restored.tokens.GetNextUnprocessedToken();
+  ASSERT_EQ(pending.token.size(), 2);
+  EXPECT_EQ(pending.step, 2);
+  ASSERT_EQ(pending.token[0]->embedding().size(), bits.size());
+  EXPECT_EQ(std::memcmp(pending.token[0]->embedding().data(), bits.data(),
+                        bits.size() * sizeof(uint32_t)), 0);
+  ASSERT_EQ(pending.token[1]->per_layer_embedding().size(), bits.size());
+  EXPECT_EQ(std::memcmp(pending.token[1]->per_layer_embedding().data(), bits.data(),
+                        bits.size() * sizeof(uint32_t)), 0);
+}
+
+TEST_F(ContextSerializationTest, PreservesAbsenceOfPendingInput) {
+  ProcessedTokens tokens;
+  tokens.AddProcessedTokens({1, 2});
+  ASSERT_OK_AND_ASSIGN(auto serialized, SerializeContextMetadata(
+                                            settings(), tokens, 3, true,
+                                            nlohmann::json::object()));
+  ASSERT_OK_AND_ASSIGN(auto restored,
+                       ParseContextMetadata(serialized, settings()));
+  EXPECT_EQ(restored.tokens.GetCopyOfTokens(), tokens.GetCopyOfTokens());
+  EXPECT_TRUE(restored.tokens.GetNextUnprocessedToken().token.empty());
+}
+
+TEST_F(ContextSerializationTest, RejectsMalformedTokenBookkeeping) {
+  ProcessedTokens tokens;
+  tokens.AddProcessedTokens({1, 2});
+  ASSERT_OK_AND_ASSIGN(auto serialized, SerializeContextMetadata(
+                                            settings(), tokens, 2, true,
+                                            nlohmann::json::object()));
+  const auto valid = nlohmann::json::parse(serialized);
+  const std::vector<nlohmann::json> invalid_steps = {
+      -1, 65, 4, 2.0, std::numeric_limits<uint64_t>::max(), nullptr};
+  for (const auto& value : invalid_steps) {
+    auto invalid = valid;
+    invalid["current_step"] = value;
+    EXPECT_THAT(ParseContextMetadata(invalid.dump(), settings()),
+                StatusIs(absl::StatusCode::kInvalidArgument));
+  }
+  for (const auto& rows : std::vector<nlohmann::json>{
+           nlohmann::json::array(), {{1, 2}, {3}}, {{1.5, 2}},
+           {{1, 2}, {1, 2}, {1, 2}}}) {
+    auto invalid = valid;
+    invalid["tokens"] = rows;
+    EXPECT_THAT(ParseContextMetadata(invalid.dump(), settings()),
+                StatusIs(absl::StatusCode::kInvalidArgument));
+  }
+  auto invalid = valid;
+  invalid["pending"] = {{{"id", 3}, {"embedding", "!"},
+                         {"per_layer_embedding", ""}}};
+  EXPECT_THAT(ParseContextMetadata(invalid.dump(), settings()),
+              StatusIs(absl::StatusCode::kInvalidArgument));
+}
+
+TEST_F(ContextSerializationTest, RejectsChangedSettingsAndInvalidFraming) {
+  ProcessedTokens tokens;
+  ASSERT_OK_AND_ASSIGN(auto serialized, SerializeContextMetadata(
+                                            settings(), tokens, 0, false,
+                                            nlohmann::json::object()));
+  auto changed = nlohmann::json::parse(serialized);
+  changed["settings"]["max_tokens"] = 32;
+  EXPECT_THAT(ParseContextMetadata(changed.dump(), settings()),
+              StatusIs(absl::StatusCode::kFailedPrecondition));
+  changed = nlohmann::json::parse(serialized);
+  changed["version"] = 2;
+  EXPECT_THAT(ParseContextMetadata(changed.dump(), settings()),
+              StatusIs(absl::StatusCode::kFailedPrecondition));
+  EXPECT_THAT(ParseContextMetadata(serialized.substr(1), settings()),
+              StatusIs(absl::StatusCode::kInvalidArgument));
+  EXPECT_THAT(ParseContextMetadata(std::string(33, '[') + std::string(33, ']'),
+                                  settings()),
+              StatusIs(absl::StatusCode::kInvalidArgument));
+  EXPECT_THAT(ParseContextMetadata(
+                  std::string(kMaxContextMetadataBytes + 1, ' '), settings()),
+              StatusIs(absl::StatusCode::kInvalidArgument));
+  // Duplicate keys must not acquire a meaning that differs between readers.
+  serialized.insert(1, "\"version\":1,");
+  EXPECT_THAT(ParseContextMetadata(serialized, settings()),
+              StatusIs(absl::StatusCode::kInvalidArgument));
+}
+
+TEST_F(ContextSerializationTest, RejectsInvalidLookupAndEmbeddingInputs) {
+  ProcessedTokens tokens;
+  tokens.AddProcessedTokens({-1, 2});
+  ASSERT_OK(tokens.AddPendingInputToken({std::make_shared<TokenData>(3)}));
+  EXPECT_OK(ValidateContextTokens(tokens, 8, 4, 2));
+  EXPECT_THAT(ValidateContextTokens(tokens, 3, 4, 2),
+              StatusIs(absl::StatusCode::kInvalidArgument));
+  tokens.InvalidatePendingInputToken();
+  ASSERT_OK(tokens.AddPendingInputToken({std::make_shared<TokenData>(-1)}));
+  EXPECT_THAT(ValidateContextTokens(tokens, 8, 4, 2),
+              StatusIs(absl::StatusCode::kInvalidArgument));
+  tokens.InvalidatePendingInputToken();
+  ASSERT_OK(tokens.AddPendingInputToken({std::make_shared<TokenData>(
+      -1, std::vector<float>(4), std::vector<float>(2))}));
+  EXPECT_OK(ValidateContextTokens(tokens, 8, 4, 2));
+  EXPECT_THAT(ValidateContextTokens(tokens, 8, 3, 2),
+              StatusIs(absl::StatusCode::kInvalidArgument));
+  EXPECT_THAT(ValidateContextTokens(tokens, 8, 4, 1),
+              StatusIs(absl::StatusCode::kInvalidArgument));
+}
