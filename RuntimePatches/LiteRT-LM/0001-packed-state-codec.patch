+class StateSerializationTest : public ::testing::Test {
+ protected:
+  void SetUp() override {
+    LITERT_ASSERT_OK_AND_ASSIGN(
+        auto env, Environment::Create(std::vector<Environment::Option>()));
+    env_ = std::move(env);
+  }
+
+  void AddBuffer(StateTensorBuffers& buffers, const std::string& name,
+                 ElementType element_type, const Dimensions& shape,
+                 uint8_t value) {
+    const RankedTensorType type(element_type, Layout(shape));
+    LITERT_ASSERT_OK_AND_ASSIGN(size_t size, type.Bytes());
+    LITERT_ASSERT_OK_AND_ASSIGN(
+        auto buffer, TensorBuffer::CreateManaged(
+                         *env_, TensorBufferType::kHostMemory, type, size));
+    LITERT_ASSERT_OK_AND_ASSIGN(void* data,
+                                buffer.Lock(TensorBuffer::LockMode::kWrite));
+    std::memset(data, value, size);
+    ASSERT_TRUE(buffer.Unlock());
+    buffers.emplace(name, std::move(buffer));
+  }
+
+  std::optional<Environment> env_;
+};
