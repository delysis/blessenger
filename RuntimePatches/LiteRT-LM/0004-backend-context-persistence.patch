+TEST(LlmLiteRtCompiledModelExecutorStaticTest, PersistentContextAcrossExecutors) {
+  auto model_path =
+      std::filesystem::path(::testing::SrcDir()) / kTestStaticModelPath;
+  ASSERT_OK_AND_ASSIGN(auto resources,
+                       CreateExecutorModelResourcesLitertLm(model_path.string()));
+  ASSERT_OK_AND_ASSIGN(auto assets, ModelAssets::Create(model_path.string()));
+  ASSERT_OK_AND_ASSIGN(auto settings,
+                       LlmExecutorSettings::CreateDefault(std::move(assets)));
+  settings.SetCacheDir(":nocache");
+  settings.SetMaxNumTokens(kMaxNumTokens);
+  LITERT_ASSERT_OK_AND_ASSIGN(auto env, Environment::Create({}));
+  ASSERT_OK_AND_ASSIGN(auto source, LlmLiteRtCompiledModelExecutorStatic::Create(
+                                       settings, env, *resources));
+  ASSERT_OK_AND_ASSIGN(auto target, LlmLiteRtCompiledModelExecutorStatic::Create(
+                                       settings, env, *resources));
+  const std::vector<int> ids = {1, 2, 3};
+  LITERT_ASSERT_OK_AND_ASSIGN(auto buffer,
+                              CopyToTensorBuffer<int>(absl::MakeSpan(ids), {1, 3}));
+  ExecutorInputs inputs;
+  inputs.SetTextData(ExecutorTextData(std::move(buffer)));
+  ASSERT_OK(source->Prefill(inputs));
+  ASSERT_OK(source->Decode());
+  ASSERT_OK_AND_ASSIGN(auto saved, source->SerializeContext());
+  ASSERT_OK_AND_ASSIGN(auto empty, target->SerializeContext());
+
+  std::string corrupt = saved.state;
+  corrupt.back() ^= 1;
+  EXPECT_FALSE(target->LoadContext(saved.metadata, corrupt).ok());
+  ASSERT_OK_AND_ASSIGN(auto unchanged, target->SerializeContext());
+  EXPECT_EQ(unchanged.metadata, empty.metadata);
+  EXPECT_EQ(unchanged.state, empty.state);
+
+  ASSERT_OK(target->LoadContext(saved.metadata, saved.state));
+  ASSERT_OK_AND_ASSIGN(auto restored, target->SerializeContext());
+  EXPECT_EQ(restored.metadata, saved.metadata);
+  EXPECT_EQ(restored.state, saved.state);
+  ASSERT_OK_AND_ASSIGN(auto expected, source->Decode());
+  ASSERT_OK_AND_ASSIGN(auto actual, target->Decode());
+  EXPECT_EQ(actual, expected);
+  ASSERT_OK_AND_ASSIGN(auto expected_state, source->SerializeContext());
+  ASSERT_OK_AND_ASSIGN(auto actual_state, target->SerializeContext());
+  EXPECT_EQ(actual_state.state, expected_state.state);
+
+  // A restored completed turn must accept the next prompt with its pending
+  // output token, using the existing decode-to-prefill transition.
+  ASSERT_OK(source->Prefill(inputs));
+  ASSERT_OK(target->Prefill(inputs));
+  ASSERT_OK_AND_ASSIGN(expected, source->Decode());
+  ASSERT_OK_AND_ASSIGN(actual, target->Decode());
+  EXPECT_EQ(actual, expected);
+}
