+LlmLiteRtCompiledModelExecutorBase::GetMtpVerifySteps() const {
+  for (int i = 0; i < compiled_model_->GetNumSignatures(); ++i) {
+    LITERT_ASSIGN_OR_RETURN(auto signature, compiled_model_->GetSignature(i));
+    if (signature.Key() != "verify") continue;
+    LITERT_ASSIGN_OR_RETURN(auto positions,
+                            signature.InputTensorType("input_pos"));
+    const auto dimensions = positions.Layout().Dimensions();
+    if (dimensions.size() != 1 || dimensions[0] <= 0) {
+      return absl::FailedPreconditionError("Invalid MTP verifier length.");
+    }
+    return dimensions[0];
+  }
+  return 0;
+}
