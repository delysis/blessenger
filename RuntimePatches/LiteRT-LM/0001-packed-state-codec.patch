+TEST_F(StateSerializationTest, RoundTripPreservesTypesAndExistingAllocations) {
+  StateTensorBuffers source, target;
+  const std::vector<ElementType> types = {
+      ElementType::Float32, ElementType::Float16, ElementType::BFloat16,
+      ElementType::Int8, ElementType::Int4, ElementType::Int2};
+  for (size_t i = 0; i < types.size(); ++i) {
+    ASSERT_NO_FATAL_FAILURE(AddBuffer(source, std::to_string(i), types[i], {5},
+                                      static_cast<uint8_t>(i + 1)));
+  }
+  // Deliberately insert the destination in the opposite order.
+  for (size_t i = types.size(); i > 0; --i) {
+    ASSERT_NO_FATAL_FAILURE(
+        AddBuffer(target, std::to_string(i - 1), types[i - 1], {5}, 0));
+  }
+  ASSERT_OK_AND_ASSIGN(auto serialized, SerializeState({{"step", 7}}, source));
+  ASSERT_OK_AND_ASSIGN(auto parsed, ParseSerializedState(serialized));
+  ASSERT_EQ(parsed.tensors.size(), types.size());
+  for (size_t i = 0; i < types.size(); ++i) {
+    EXPECT_EQ(parsed.tensors[i].name, std::to_string(i));
+    EXPECT_EQ(parsed.tensors[i].descriptor["type"], static_cast<int>(types[i]));
+  }
+  const auto handle = target.at("0").Get();
+  ASSERT_OK(LoadSerializedState(parsed, target));
+  EXPECT_EQ(target.at("0").Get(), handle);
+  for (size_t i = 0; i < types.size(); ++i) {
+    ASSERT_NO_FATAL_FAILURE(
+        ExpectBytes(target.at(std::to_string(i)), static_cast<uint8_t>(i + 1)));
+  }
+  ASSERT_OK_AND_ASSIGN(auto restored, SerializeState({{"step", 7}}, target));
+  EXPECT_EQ(restored, serialized);
+}
+
+TEST_F(StateSerializationTest, ValidatesEveryDescriptorBeforeWriting) {
+  StateTensorBuffers source, target;
+  ASSERT_NO_FATAL_FAILURE(AddBuffer(source, "a", ElementType::UInt8, {4}, 1));
+  ASSERT_NO_FATAL_FAILURE(AddBuffer(source, "z", ElementType::UInt8, {4}, 2));
+  ASSERT_NO_FATAL_FAILURE(AddBuffer(target, "a", ElementType::UInt8, {4}, 9));
+  ASSERT_NO_FATAL_FAILURE(AddBuffer(target, "z", ElementType::Int8, {4}, 8));
+  ASSERT_OK_AND_ASSIGN(auto serialized,
+                       SerializeState(nlohmann::json::object(), source));
+  ASSERT_OK_AND_ASSIGN(auto parsed, ParseSerializedState(serialized));
+  EXPECT_THAT(LoadSerializedState(parsed, target),
+              StatusIs(absl::StatusCode::kInvalidArgument));
+  ASSERT_NO_FATAL_FAILURE(ExpectBytes(target.at("a"), 9));
+  ASSERT_NO_FATAL_FAILURE(ExpectBytes(target.at("z"), 8));
+}
+
+TEST_F(StateSerializationTest, RejectsCorruptAndTruncatedData) {
+  StateTensorBuffers buffers;
+  ASSERT_NO_FATAL_FAILURE(AddBuffer(buffers, "kv", ElementType::Float32, {4}, 7));
+  ASSERT_OK_AND_ASSIGN(auto serialized,
+                       SerializeState(nlohmann::json::object(), buffers));
+  for (size_t size = 0; size < serialized.size(); ++size) {
+    EXPECT_FALSE(ParseSerializedState(absl::string_view(serialized).substr(0, size))
+                     .ok())
+        << size;
+  }
+  std::string corrupt = serialized;
+  corrupt[corrupt.size() - 5] ^= 1;
+  EXPECT_THAT(ParseSerializedState(corrupt),
+              StatusIs(absl::StatusCode::kDataLoss));
+  corrupt = serialized;
+  corrupt.append(1, '\0');
+  EXPECT_FALSE(ParseSerializedState(corrupt).ok());
+  corrupt = serialized;
+  std::memset(corrupt.data() + 8, 255, 8);
+  EXPECT_FALSE(ParseSerializedState(corrupt).ok());
+}
+
+TEST_F(StateSerializationTest, RejectsInvalidDescriptorNumbersAndShapes) {
+  StateTensorBuffers buffers;
+  ASSERT_NO_FATAL_FAILURE(AddBuffer(buffers, "kv", ElementType::UInt8, {4}, 7));
+  ASSERT_OK_AND_ASSIGN(auto serialized,
+                       SerializeState(nlohmann::json::object(), buffers));
+  const auto header = Header(serialized);
+  const std::vector<nlohmann::json> invalid_numbers = {
+      nullptr, true, "4", 4.0, -1, std::numeric_limits<uint64_t>::max()};
+  for (const auto& value : invalid_numbers) {
+    for (const char* field : {"type", "bytes"}) {
+      auto malformed = header;
+      malformed["tensors"][0][field] = value;
+      EXPECT_FALSE(ParseSerializedState(ReplaceHeader(serialized, malformed)).ok())
+          << field << " = " << value;
+    }
+    auto malformed = header;
+    malformed["tensors"][0]["shape"][0] = value;
+    EXPECT_FALSE(ParseSerializedState(ReplaceHeader(serialized, malformed)).ok())
+        << value;
+  }
+  auto malformed = header;
+  malformed["tensors"][0]["shape"] = {
+      std::numeric_limits<int32_t>::max(), std::numeric_limits<int32_t>::max(),
+      std::numeric_limits<int32_t>::max()};
+  EXPECT_FALSE(ParseSerializedState(ReplaceHeader(serialized, malformed)).ok());
+  // These shapes and byte counts agree with each other but not the payload.
+  for (int bytes : {3, 5}) {
+    malformed = header;
+    malformed["tensors"][0]["shape"] = {bytes};
+    malformed["tensors"][0]["bytes"] = bytes;
+    EXPECT_FALSE(ParseSerializedState(ReplaceHeader(serialized, malformed)).ok());
+  }
+}
+
+TEST_F(StateSerializationTest, RejectsDuplicateNamesAndUnsupportedVersion) {
+  StateTensorBuffers buffers;
+  ASSERT_NO_FATAL_FAILURE(AddBuffer(buffers, "a", ElementType::UInt8, {4}, 1));
+  ASSERT_NO_FATAL_FAILURE(AddBuffer(buffers, "z", ElementType::UInt8, {4}, 2));
+  ASSERT_OK_AND_ASSIGN(auto serialized,
+                       SerializeState(nlohmann::json::object(), buffers));
+  auto header = Header(serialized);
+  header["tensors"][1]["name"] = "a";
+  EXPECT_FALSE(ParseSerializedState(ReplaceHeader(serialized, header)).ok());
+  header = Header(serialized);
+  header["version"] = 2;
+  EXPECT_THAT(ParseSerializedState(ReplaceHeader(serialized, header)),
+              StatusIs(absl::StatusCode::kFailedPrecondition));
+  header = Header(serialized);
+  header["byte_order"] = "unknown";
+  EXPECT_THAT(ParseSerializedState(ReplaceHeader(serialized, header)),
+              StatusIs(absl::StatusCode::kFailedPrecondition));
+}
