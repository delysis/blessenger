+#include "absl/status/status.h"  // from @com_google_absl
+#include "absl/status/statusor.h"  // from @com_google_absl
+#include "absl/strings/string_view.h"  // from @com_google_absl
+#include "nlohmann/json.hpp"  // from @nlohmann_json
+#include "litert/cc/litert_tensor_buffer.h"  // from @litert
+
+namespace litert::lm {
+
+using StateTensorBuffers = absl::flat_hash_map<std::string, TensorBuffer>;
+
+struct SerializedStateTensor {
+  std::string name;
+  // The declared element type, logical shape and exact packed byte count.
+  nlohmann::json descriptor;
+  absl::string_view bytes;
+};
+
+struct ParsedSerializedState {
+  nlohmann::json metadata;
+  std::vector<SerializedStateTensor> tensors;
+};
+
+// Returns {"type": integer, "shape": [dimensions], "bytes": integer}.
+// Also validates the buffer's packed-transfer layout and offset.
+absl::StatusOr<nlohmann::json> DescribeStateTensor(const TensorBuffer& buffer);
+
+// These operations require exclusive access to the underlying buffers. The
+// format is a bounded, canonical JSON header followed by packed tensor bytes
+// in name order and a CRC32C covering the header and payload. It preserves
+// declared tensor types; a hardware buffer's storage type is not its dtype.
+absl::StatusOr<std::string> SerializeState(
+    const nlohmann::json& metadata, const StateTensorBuffers& buffers);
+
+// Checks the complete framing, checksum, descriptors and lengths. The result
+// borrows tensor bytes from serialized_state, which must outlive the result.
+absl::StatusOr<ParsedSerializedState> ParseSerializedState(
+    absl::string_view serialized_state);
+
+// Checks every descriptor before any destination buffer is written.
+absl::Status ValidateSerializedState(const ParsedSerializedState& state,
+                                     const StateTensorBuffers& buffers);
+
+// Copies into existing allocations and checks both Lock and Unlock. Malformed
+// or incompatible input is rejected before writing. A device-transfer failure
+// may leave partial contents; callers must discard that restore destination.
+absl::Status LoadSerializedState(const ParsedSerializedState& state,
+                                 StateTensorBuffers& buffers);
+
+}  // namespace litert::lm
