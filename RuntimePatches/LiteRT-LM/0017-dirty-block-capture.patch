+  bytes[4097] = 'b'; versions[1] = 2;
+  auto pending = CapturedCacheFile::Create(directory_.string(), *first);
+  ASSERT_TRUE(pending.ok());
+  ASSERT_TRUE((*pending)->WriteTracked(bytes.data(), bytes.size(), 77, versions.data(), versions.size()));
+  ASSERT_TRUE((*pending)->Finish().ok());
+  bytes[7 * 4096 + 8] = 'c'; versions[7] = 3;
+  auto latest = CapturedCacheFile::Create(directory_.string(), *pending);
+  ASSERT_TRUE(latest.ok());
