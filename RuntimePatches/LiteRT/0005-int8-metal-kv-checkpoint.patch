+- (void)testCheckpointAllocatedInt8KvBuffers {
+  if (!_device) return;
+
+  // E4B has two KV heads, 256/512 head widths, and INT8 external tensors.
+  // Test the app's minimum aligned context rather than the export's magic size.
+  const int32_t shapes[][4] = {
+      {1, 2, 2048, 256}, {1, 2, 256, 2048},
+      {1, 2, 2048, 512}, {1, 2, 512, 2048}};
+  using MetalMemory = std::unique_ptr<HwMemoryInfo, decltype(&LiteRtDestroyMetalMemory)>;
+  const auto gpuCopy = [&](id<MTLBuffer> source, id<MTLBuffer> destination) {
+    if (source == nil || destination == nil || source.length != destination.length) return false;
+    id<MTLCommandBuffer> command = [_commandQueue commandBuffer];
+    if (command == nil) return false;
+    id<MTLBlitCommandEncoder> encoder = [command blitCommandEncoder];
+    if (encoder == nil) return false;
+    [encoder copyFromBuffer:source sourceOffset:0 toBuffer:destination
+         destinationOffset:0 size:source.length];
+    [encoder endEncoding];
+    [command commit];
+    [command waitUntilCompleted];
+    return command.status == MTLCommandBufferStatusCompleted;
+  };
+  for (const auto& shape : shapes) {
+    LiteRtRankedTensorType tensorType = {};
+    tensorType.element_type = kLiteRtElementTypeInt8;
+    tensorType.layout.rank = 4;
+    tensorType.layout.has_strides = true;
+    tensorType.layout.strides[0] = 16;
+    size_t bytes = 1;
+    for (int i = 0; i < 4; ++i) {
+      tensorType.layout.dimensions[i] = shape[i];
+      bytes *= shape[i];
+    }
+    const auto allocate = [&] {
+      HwMemoryInfoPtr info = nullptr;
+      XCTAssertEqual(LiteRtCreateMetalMemory(
+                         (__bridge void*)_device, (__bridge void*)_commandQueue, &tensorType,
+                         kLiteRtTensorBufferTypeMetalBuffer, bytes, bytes, &info),
+                     kLiteRtStatusOk);
+      return MetalMemory(info, &LiteRtDestroyMetalMemory);
+    };
+    auto source = allocate();
+    XCTAssertTrue(source != nullptr);
+    if (!source) return;
+    id<MTLBuffer> sourceBuffer = (__bridge id<MTLBuffer>)source->raw_handle;
+    XCTAssertNotNil(sourceBuffer);
+    XCTAssertEqual(sourceBuffer.storageMode, MTLStorageModeShared);
+    XCTAssertEqual(sourceBuffer.length, bytes);
+    if (sourceBuffer == nil || sourceBuffer.length != bytes) return;
+    // Cover all 256 bit patterns, including INT8_MIN/-1/0/INT8_MAX, with
+    // different values across channel slices and token rows.
+    std::vector<uint8_t> pattern(bytes);
+    for (size_t i = 0; i < bytes; ++i) {
+      pattern[i] = static_cast<uint8_t>(i ^ (i >> 8) ^ (i >> 16));
+    }
+    id<MTLBuffer> upload = [_device newBufferWithBytes:pattern.data()
+                                              length:bytes options:MTLResourceStorageModeShared];
+    const bool uploaded = gpuCopy(upload, sourceBuffer);
+    XCTAssertTrue(uploaded);
+    if (!uploaded) return;
+    XCTAssertEqual(LiteRtReleaseMetalHostStagingMemory(source.get()), kLiteRtStatusOk);
+    void* hostMemory = nullptr;
+    auto status = LiteRtLockMetalMemory(source.get(), kLiteRtTensorBufferLockModeRead, &hostMemory);
+    XCTAssertEqual(status, kLiteRtStatusOk);
+    XCTAssertTrue(hostMemory != nullptr);
+    if (status != kLiteRtStatusOk || hostMemory == nullptr) return;
+    std::vector<uint8_t> checkpoint(bytes);
+    std::memcpy(checkpoint.data(), hostMemory, bytes);
+    XCTAssertEqual(LiteRtUnlockMetalMemory(source.get()), kLiteRtStatusOk);
+    XCTAssertEqual(LiteRtReleaseMetalHostStagingMemory(source.get()), kLiteRtStatusOk);
+    source.reset();
+
+    auto restored = allocate();
+    XCTAssertTrue(restored != nullptr);
+    if (!restored) return;
+    id<MTLBuffer> restoredBuffer = (__bridge id<MTLBuffer>)restored->raw_handle;
+    XCTAssertNotNil(restoredBuffer);
+    XCTAssertEqual(restoredBuffer.storageMode, MTLStorageModeShared);
+    XCTAssertEqual(restoredBuffer.length, bytes);
+    if (restoredBuffer == nil || restoredBuffer.length != bytes) return;
+    // A fresh alias with no device must still update Shared storage. The old
+    // unchecked upload allocated its staging buffer via that absent device.
+    HwMemoryInfoPtr aliasInfo = nullptr;
+    XCTAssertEqual(LiteRtImportMetalMemory(
+                       nullptr, (__bridge void*)_commandQueue, &tensorType,
+                       kLiteRtTensorBufferTypeMetalBuffer, (__bridge void*)restoredBuffer,
+                       bytes, bytes, &aliasInfo),
+                   kLiteRtStatusOk);
+    MetalMemory alias(aliasInfo, &LiteRtDestroyMetalMemory);
+    XCTAssertTrue(alias != nullptr);
+    if (!alias) return;
+    XCTAssertEqual(LiteRtReleaseMetalHostStagingMemory(alias.get()), kLiteRtStatusOk);
+    hostMemory = nullptr;
+    status = LiteRtLockMetalMemory(alias.get(), kLiteRtTensorBufferLockModeWrite, &hostMemory);
+    XCTAssertEqual(status, kLiteRtStatusOk);
+    XCTAssertTrue(hostMemory != nullptr);
+    if (status != kLiteRtStatusOk || hostMemory == nullptr) return;
+    std::memcpy(hostMemory, checkpoint.data(), bytes);
+    XCTAssertEqual(LiteRtUnlockMetalMemory(alias.get()), kLiteRtStatusOk);
+    XCTAssertEqual(LiteRtReleaseMetalHostStagingMemory(alias.get()), kLiteRtStatusOk);
+    id<MTLBuffer> readback =
+        [_device newBufferWithLength:bytes options:MTLResourceStorageModeShared];
+    const bool downloaded = gpuCopy(restoredBuffer, readback);
+    XCTAssertTrue(downloaded);
+    if (!downloaded) return;
+    XCTAssertEqual(std::memcmp(readback.contents, pattern.data(), bytes), 0);
+  }
+}
