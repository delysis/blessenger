+#ifndef THIRD_PARTY_ODML_LITERT_LM_RUNTIME_CORE_SESSION_CACHE_FILE_H_
+#define THIRD_PARTY_ODML_LITERT_LM_RUNTIME_CORE_SESSION_CACHE_FILE_H_
+
+#include <memory>
+
+#include "absl/status/status.h"  // from @com_google_absl
+#include "absl/status/statusor.h"  // from @com_google_absl
+#include "absl/strings/string_view.h"  // from @com_google_absl
+#include "runtime/util/memory_mapped_file.h"
+
+namespace litert::lm {
+
+// Views remain valid for the lifetime of mapping. The tensor payload is never
+// copied into a second, cache-sized host allocation during file loading.
+struct MappedSessionCache {
+  std::unique_ptr<MemoryMappedFile> mapping;
+  absl::string_view metadata;
+  absl::string_view state;
+  int last_prefill_token_id;
+};
+
+// Writes a complete file in the destination directory, flushes it, and replaces
+// path atomically. On a post-publication directory-sync error, the new file is
+// visible but its durability is uncertain; the returned error says so.
+absl::Status WriteSessionCacheFile(absl::string_view path,
+                                  absl::string_view compatibility_key,
+                                  int last_prefill_token_id,
+                                  absl::string_view metadata,
+                                  absl::string_view state);
+
+// Checks framing, compatibility key, and checksum before returning any views.
+// The application must not modify/truncate a published cache file in place.
+absl::StatusOr<MappedSessionCache> ReadSessionCacheFile(
+    absl::string_view path, absl::string_view compatibility_key);
+
+}  // namespace litert::lm
+
+#endif  // THIRD_PARTY_ODML_LITERT_LM_RUNTIME_CORE_SESSION_CACHE_FILE_H_
