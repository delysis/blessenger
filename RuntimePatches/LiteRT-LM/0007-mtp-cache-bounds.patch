+
+namespace litert::lm {
+namespace {
+
+TEST(MtpCacheTest, Gemma4TwelveBHasRoomForSpeculationAndLogicalRollback) {
+  EXPECT_TRUE(IsMtpRingSnapshotSafe(1152, 1024, 4));
+  EXPECT_TRUE(IsMtpRingSnapshotSafe(1152, 1024, 4, 124));
+  EXPECT_FALSE(IsMtpRingSnapshotSafe(1152, 1024, 4, 125));
+}
+
+TEST(MtpCacheTest, RetainsEveryHistoryRowNeededAfterAnyAcceptedPrefix) {
+  // Each slot records the absolute position of its last write. Acceptance and
+  // stop handling can resume anywhere from the previous cold-prime input to
+  // the pending bonus token after a fully accepted batch. Unaccepted future
+  // positions are masked and overwritten as the next prefill advances.
+  for (int64_t window = 2; window <= 8; ++window) {
+    for (int64_t verify = 1; verify <= 6; ++verify) {
+      for (int64_t rollback = 0; rollback <= 3; ++rollback) {
+        for (int64_t size = window; size <= window + verify + rollback + 2;
+             ++size) {
+          if (!IsMtpRingSnapshotSafe(size, window, verify, rollback)) continue;
+          for (int64_t start = 2 * size; start < 3 * size; ++start) {
+            std::vector<int64_t> snapshot(size, -1);
+            for (int64_t position = 0; position < start + verify; ++position) {
+              snapshot[position % size] = position;
+            }
+            for (int64_t resume = start - 1 - rollback;
+                 resume <= start + verify; ++resume) {
+              auto restored = snapshot;
+              // Cross two further wraps, including the first replayed input.
+              for (int64_t query = resume; query < resume + 2 * size; ++query) {
+                restored[query % size] = query;
+                for (int64_t history = query - window + 1; history <= query;
+                     ++history) {
+                  ASSERT_EQ(restored[history % size], history)
+                      << "window=" << window << " verify=" << verify
+                      << " rollback=" << rollback << " ring=" << size
+                      << " start=" << start << " resume=" << resume
+                      << " query=" << query;
+                }
+              }
+            }
+          }
+        }
+      }
+    }
+  }
+}
+
+TEST(MtpCacheTest, OneRowShortCanDestroyHistoryBeforeAStopOnThePrimeToken) {
+  constexpr int64_t kWindow = 8;
+  constexpr int64_t kVerify = 4;
+  constexpr int64_t kRing = 11;
+  constexpr int64_t kStart = 29;
+  std::vector<int64_t> ring(kRing, -1);
+  for (int64_t position = 0; position < kStart + kVerify; ++position) {
+    ring[position % kRing] = position;
+  }
+  // Replaying kStart - 1 still needs kStart - kWindow. The last speculative
+  // write has replaced that row, even though every draft token may be rejected.
+  EXPECT_NE(ring[(kStart - kWindow) % kRing], kStart - kWindow);
+  EXPECT_FALSE(IsMtpRingSnapshotSafe(kRing, kWindow, kVerify));
+  EXPECT_TRUE(IsMtpRingSnapshotSafe(kRing + 1, kWindow, kVerify));
+}
+
+TEST(MtpCacheTest, RejectsInvalidAndOverflowingRingGeometry) {
+  constexpr int64_t kMax = std::numeric_limits<int64_t>::max();
+  EXPECT_FALSE(IsMtpRingSnapshotSafe(-1, 1, 1));
+  EXPECT_FALSE(IsMtpRingSnapshotSafe(8, 0, 1));
+  EXPECT_FALSE(IsMtpRingSnapshotSafe(8, 1, 0));
+  EXPECT_FALSE(IsMtpRingSnapshotSafe(8, 1, 1, -1));
+  EXPECT_FALSE(IsMtpRingSnapshotSafe(8, 9, 1));
+  EXPECT_FALSE(IsMtpRingSnapshotSafe(kMax, kMax, 1));
+  EXPECT_FALSE(IsMtpRingSnapshotSafe(kMax, 1, kMax));
+  EXPECT_FALSE(IsMtpRingSnapshotSafe(kMax, 1, 1, kMax));
+  EXPECT_TRUE(IsMtpRingSnapshotSafe(kMax, 1, 1, kMax - 2));
+}
+
+TEST(MtpCacheTest, VerifierBatchMustFitBeforeAnyInputOrCacheWrite) {
+  EXPECT_TRUE(MtpBatchFits(0, 4, 4));
+  EXPECT_TRUE(MtpBatchFits(12, 4, 16));
+  EXPECT_FALSE(MtpBatchFits(13, 4, 16));
+  EXPECT_FALSE(MtpBatchFits(0, 4, 3));
+  EXPECT_FALSE(MtpBatchFits(-1, 4, 16));
+  EXPECT_FALSE(MtpBatchFits(0, 0, 16));
+  EXPECT_FALSE(MtpBatchFits(0, -1, 16));
+  EXPECT_FALSE(MtpBatchFits(0, 1, -1));
+  // Reserve one logical token for the pending bonus after accepting all drafts.
+  EXPECT_TRUE(MtpBatchFits(11, 4, 16 - 1));
+  EXPECT_FALSE(MtpBatchFits(12, 4, 16 - 1));
+  constexpr int64_t kMax = std::numeric_limits<int64_t>::max();
+  EXPECT_TRUE(MtpBatchFits(kMax - 4, 4, kMax));
+  EXPECT_FALSE(MtpBatchFits(kMax - 3, 4, kMax));
+  EXPECT_FALSE(MtpBatchFits(kMax, kMax, kMax));
+}
