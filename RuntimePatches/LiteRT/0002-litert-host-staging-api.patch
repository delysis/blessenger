+litert::Expected<void> TensorBufferRegistry::RegisterHostStagingMemoryHandler(
+    LiteRtTensorBufferType buffer_type,
+    ::ReleaseCustomTensorBufferHostStagingMemory handler) {
+  auto it = handlers_.find(buffer_type);
+  if (it == handlers_.end()) {
+    return litert::Unexpected(kLiteRtStatusErrorNotFound,
+                              "Register the buffer handlers first.");
+  }
+  auto& registered = it->second.release_host_staging_memory;
+  if (registered != nullptr && registered != handler) {
+    return litert::Unexpected(kLiteRtStatusErrorAlreadyExists,
+                              "Different host staging handler registered.");
+  }
+  registered = handler;
+  return {};
+}
