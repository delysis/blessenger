+LiteRtLmStatusCode litert_lm_conversation_begin_audio_input(
+    LiteRtLmConversation* conversation, const char* prototype_json) {
+  if (!conversation || !conversation->conversation || !prototype_json) {
+    return litert::lm::c::ReturnError(absl::StatusCode::kInvalidArgument, "Invalid audio input.");
+  }
+  auto message = nlohmann::ordered_json::parse(prototype_json, nullptr, false);
+  if (message.is_discarded()) {
+    return litert::lm::c::ReturnError(absl::StatusCode::kInvalidArgument, "Invalid audio JSON.");
+  }
+  return litert::lm::c::ToCStatus(conversation->conversation->BeginAudioInput(message));
+}
+LiteRtLmStatusCode litert_lm_conversation_append_audio_input(
+    LiteRtLmConversation* conversation, const float* samples, size_t count) {
+  if (!conversation || !conversation->conversation || !samples || count == 0 || count > 16000) {
+    return litert::lm::c::ReturnError(absl::StatusCode::kInvalidArgument, "Invalid audio samples.");
+  }
+  return litert::lm::c::ToCStatus(conversation->conversation->AppendAudioInput({samples, count}));
+}
+LiteRtLmStatusCode litert_lm_conversation_finish_audio_input(
+    LiteRtLmConversation* conversation) {
+  if (!conversation || !conversation->conversation) {
+    return litert::lm::c::ReturnError(absl::StatusCode::kInvalidArgument, "Invalid conversation.");
+  }
+  return litert::lm::c::ToCStatus(conversation->conversation->FinishAudioInput());
+}
+
+LiteRtLmStatusCode litert_lm_conversation_prefill_history_suffix(
+    LiteRtLmConversation* conversation, const char* messages_json) {
+  if (!conversation || !conversation->conversation || !messages_json) {
+    return litert::lm::c::ReturnError(absl::StatusCode::kInvalidArgument,
+                                    "Invalid history suffix arguments.");
+  }
+  auto parsed = nlohmann::ordered_json::parse(messages_json, nullptr, false);
+  if (parsed.is_discarded() || !parsed.is_array()) {
+    return litert::lm::c::ReturnError(absl::StatusCode::kInvalidArgument,
+                                    "History suffix must be an array.");
+  }
+  std::vector<litert::lm::Message> messages;
+  for (auto& message : parsed) messages.push_back(std::move(message));
+  return litert::lm::c::ToCStatus(
+      conversation->conversation->PrefillHistorySuffix(std::move(messages)));
+}
