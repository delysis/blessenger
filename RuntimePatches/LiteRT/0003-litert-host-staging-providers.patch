+
+LiteRtStatus LiteRtReleaseMetalHostStagingMemory(
+    HwMemoryInfoPtr hw_memory_info) {
+  if (hw_memory_info == nullptr) {
+    return kLiteRtStatusErrorInvalidArgument;
+  }
+  auto* memory_info = static_cast<MetalMemoryInfo*>(hw_memory_info);
+  if (memory_info->lock_state != LockState::kUnlocked) {
+    return kLiteRtStatusErrorRuntimeFailure;
+  }
+  if (memory_info->buffer_type == kLiteRtTensorBufferTypeMetalBufferPacked) {
+    id<MTLBuffer> buffer = memory_info->metal_tensor.GetBufferHandle();
+    if (buffer == nil) {
+      return kLiteRtStatusErrorInvalidArgument;
+    }
+    // The private/managed packed transfer helpers do not propagate the actual
+    // command's errors. Only direct shared-memory transfers are checkpointable.
+    if (buffer.storageMode != MTLStorageModeShared ||
+        memory_info->packed_bytes > static_cast<size_t>(std::numeric_limits<int>::max())) {
+      return kLiteRtStatusErrorUnsupported;
+    }
+    if ([buffer contents] == nullptr || memory_info->packed_bytes > buffer.length) {
+      return kLiteRtStatusErrorInvalidArgument;
+    }
+  }
+  if (memory_info->host_memory == nullptr) {
+    return kLiteRtStatusOk;
+  }
+  @autoreleasepool {
+    id<MTLCommandBuffer> completion =
+        [memory_info->command_queue commandBuffer];
+    if (completion == nil) {
+      return kLiteRtStatusErrorRuntimeFailure;
+    }
+    [completion commit];
+    [completion waitUntilCompleted];
+    if (completion.status != MTLCommandBufferStatusCompleted) {
+      return kLiteRtStatusErrorRuntimeFailure;
+    }
+  }
+  litert_aligned_free(memory_info->host_memory);
+  memory_info->host_memory = nullptr;
   return kLiteRtStatusOk;
 }
 
