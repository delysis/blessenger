+// Version 2 is deliberately restricted to homogeneous, exact-size shared
+// Metal INT8/FP16 tensors. The compatibility key must include the delegate build.
+// Version 1 remains readable and remains the format for other providers.
+bool IsPhysicalMetal(const TensorBuffer& buffer) {
+#if defined(__APPLE__)
+  auto storage = buffer.BufferType();
+  auto type = buffer.TensorType();
+  auto handle = buffer.GetMetalBuffer();
+  return storage && type && handle && *handle != nullptr &&
+      ((*storage == TensorBufferType::kMetalBuffer &&
+        type->ElementType() == ElementType::Int8) ||
+       (*storage == TensorBufferType::kMetalBufferFp16 &&
+        type->ElementType() == ElementType::Float16));
+#else
+  return false;
+#endif
+}
+
+absl::StatusOr<void*> PhysicalMetalBytes(const TensorBuffer& source, size_t bytes) {
+#if defined(__APPLE__)
+  if (!IsPhysicalMetal(source))
+    return absl::InvalidArgumentError("Physical Metal snapshot storage mismatch.");
+  // A completed executor operation owns the fence. Still honor any buffer event.
+  LITERT_ASSIGN_OR_RETURN(auto buffer, source.Duplicate());
+  if (buffer.HasEvent()) {
+    LITERT_ASSIGN_OR_RETURN(auto event, buffer.GetEvent());
+    LITERT_RETURN_IF_ERROR(event.Wait(-1));
+  }
+  LITERT_RETURN_IF_ERROR(buffer.ReleaseHostStagingMemory());
+  LITERT_ASSIGN_OR_RETURN(auto handle, buffer.GetMetalBuffer());
+  void* data = SharedMetalSnapshotBytes(handle, bytes);
+  if (data == nullptr)
+    return absl::UnimplementedError("Physical snapshot requires exact-size shared Metal storage.");
+  return data;
+#else
+  return absl::UnimplementedError("Physical Metal snapshot requires Apple Metal.");
+#endif
+}
