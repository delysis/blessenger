+  ASSERT_TRUE(third.ok()) << third.status();
+  std::ostream shrink(third->get());
+  shrink.write("tiny", 4);
+  ASSERT_TRUE((*third)->Finish().ok());
+  ASSERT_TRUE((*third)->Publish(other, "third", 3, "m", nullptr).ok());
+  auto small = ReadSessionCacheFile(other, "third");
+  ASSERT_TRUE(small.ok()) << small.status();
