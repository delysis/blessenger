+absl::Status AudioLiteRtCompiledModelExecutor::ValidateContextForCache(
+    const AudioContext* audio_context) const {
+  const auto& inputs = audio_encoder_->GetInputBuffersMap();
+  const auto& outputs = audio_encoder_->GetOutputBuffersMap();
+  // Adapter-less Gemma4 exports are classified as streaming, but their sole
+  // audio input and features output carry no state between Encode calls.
+  // Without buffering or overlap, each call consumes its whole utterance.
+  if (audio_adapter_ != nullptr || !audio_encoder_->IsStreaming() ||
+      executor_settings_.GetAudioBufferingEnabled() ||
+      executor_properties_.streaming_chunk_overlap_size != 0 ||
+      inputs.size() != 1 ||
+      absl::c_find(kAudioInputNames, inputs.begin()->first) ==
+          kAudioInputNames.end() ||
+      outputs.size() != 1 || !outputs.contains(kFeaturesName)) {
+    return absl::UnimplementedError(
+        "LLM cache requires an unbuffered, stateless audio encoder.");
+  }
+  if (audio_context != nullptr) {
+    if (!static_cast<const AudioStreamingContext&>(*audio_context).IsEmpty()) {
+      return absl::FailedPreconditionError("Audio context retains stream state.");
+    }
+  } else if (!audio_encoder_->GetBufferedSpectrogram().empty() ||
+             !static_cast<const AudioStreamingEncoder*>(audio_encoder_.get())
+                  ->IsFirstChunk()) {
+    return absl::FailedPreconditionError("Audio executor retains stream state.");
+  }
+  return absl::OkStatus();
+}
