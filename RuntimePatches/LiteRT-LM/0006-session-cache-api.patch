+absl::Status SessionAdvanced::SaveCache(absl::string_view path,
+                                       absl::string_view compatibility_key) {
+  absl::MutexLock lock(mutex_);
+  if (session_state_ != SessionState::kDecoded) {
+    return absl::FailedPreconditionError(
+        "SaveCache requires a completed decode turn.");
+  }
+  auto manager = execution_manager_.lock();
+  if (manager == nullptr) {
+    return absl::FailedPreconditionError("Execution manager is not available.");
+  }
+  // Reject active work rather than waiting under mutex_: a completion callback
+  // can itself enqueue another session operation.
+  ABSL_ASSIGN_OR_RETURN(
+      auto context,
+      manager->SerializeSessionContext(session_id_, last_task_ids_));
+  return WriteSessionCacheFile(path, compatibility_key,
+                              session_info_->last_prefill_token_id,
+                              context.metadata, context.state);
+}
+
+absl::Status SessionAdvanced::LoadCache(absl::string_view path,
+                                       absl::string_view compatibility_key) {
+  absl::MutexLock lock(mutex_);
+  if (session_state_ != SessionState::kFresh || !last_task_ids_.empty()) {
+    return absl::FailedPreconditionError("LoadCache requires a new session.");
+  }
+  auto manager = execution_manager_.lock();
+  if (manager == nullptr) {
+    return absl::FailedPreconditionError("Execution manager is not available.");
+  }
+  ABSL_ASSIGN_OR_RETURN(auto cache, ReadSessionCacheFile(path, compatibility_key));
+  ABSL_RETURN_IF_ERROR(manager->LoadSessionContext(
+      session_id_, cache.metadata, cache.state, cache.last_prefill_token_id));
+  session_state_ = SessionState::kDecoded;
+  return absl::OkStatus();
+}
