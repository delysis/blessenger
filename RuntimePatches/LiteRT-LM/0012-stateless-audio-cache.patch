+  }
+  EXPECT_OK(manager_->TryAcquireExecutorWithContextHandler(handler_));
+  EXPECT_EQ(audio_->restores, 3);
+}
+
+TEST_F(AudioCacheLeaseTest, BusyAudioRejectsBeforeContextSwitchAndCanBeRetried) {
+  {
+    ASSERT_OK_AND_ASSIGN(auto audio_lease, manager_->AcquireAudioExecutor());
+    EXPECT_THAT(manager_->TryAcquireExecutorWithContextHandler(handler_),
+                testing::status::StatusIs(absl::StatusCode::kFailedPrecondition));
+    EXPECT_EQ(audio_->restores, 0);
+  }
+  EXPECT_OK(manager_->TryAcquireExecutorWithContextHandler(handler_));
+  EXPECT_EQ(audio_->restores, 1);
+}
+
+TEST_F(AudioCacheLeaseTest, StatefulAndPartialAudioRejectBeforeContextSwitch) {
+  audio_->stateless = false;
+  EXPECT_THAT(manager_->TryAcquireExecutorWithContextHandler(handler_),
+              testing::status::StatusIs(absl::StatusCode::kUnimplemented));
+  audio_->stateless = true;
+  audio_->pending = true;
+  EXPECT_THAT(manager_->TryAcquireExecutorWithContextHandler(handler_),
+              testing::status::StatusIs(absl::StatusCode::kFailedPrecondition));
+  audio_->pending = false;
+  ASSERT_OK(handler_->SetAudioContext(std::make_unique<CacheAudioContext>(true)));
+  EXPECT_THAT(manager_->TryAcquireExecutorWithContextHandler(handler_),
+              testing::status::StatusIs(absl::StatusCode::kFailedPrecondition));
+  EXPECT_EQ(audio_->restores, 0);
+  ASSERT_OK(handler_->SetAudioContext(std::make_unique<CacheAudioContext>()));
+  EXPECT_OK(manager_->TryAcquireExecutorWithContextHandler(handler_));
+}
+
 }  // namespace
