+namespace {
+absl::StatusOr<int> CaptureFD(absl::string_view directory, int previous_fd = -1) {
+#if defined(_WIN32)
+  return absl::UnimplementedError("Bounded cache capture requires POSIX files.");
+#else
+  if (directory.empty() || directory.find('\0') != absl::string_view::npos)
+    return absl::InvalidArgumentError("Invalid capture directory.");
+  std::string temporary = std::string(directory) + "/capture-XXXXXX";
+  if (!mkdtemp(temporary.data()))
+    return absl::ErrnoToStatus(errno, "Could not create private capture directory.");
+  const std::string path = temporary + "/state";
+  absl::Cleanup cleanup = [&] { unlink(path.c_str()); rmdir(temporary.c_str()); };
+  bool cloned = false;
+#if defined(__APPLE__)
+  if (previous_fd >= 0) {
+    if (fclonefileat(previous_fd, AT_FDCWD, path.c_str(), 0) == 0) cloned = true;
+    else return absl::ErrnoToStatus(errno, "Could not clone captured state.");
+  }
+#endif
+  const int fd = open(path.c_str(), O_RDWR | O_CLOEXEC | (cloned ? 0 : O_CREAT | O_EXCL), 0600);
+  if (fd < 0) return absl::ErrnoToStatus(errno, "Could not open captured state.");
+#if defined(__APPLE__)
+  if (fcntl(fd, F_NOCACHE, 1) != 0) {
+    const int error = errno; close(fd);
+    return absl::ErrnoToStatus(error, "Could not bound capture file caching.");
+  }
+#endif
+  return fd;
+#endif
+}
+
+absl::Status WriteAt(int fd, absl::string_view data, size_t position) {
+#if defined(_WIN32)
+  return absl::UnimplementedError("Bounded cache capture requires POSIX files.");
+#else
+  while (!data.empty()) {
+    const ssize_t n = pwrite(fd, data.data(), data.size(), position);
+    if (n < 0 && errno == EINTR) continue;
+    if (n <= 0) return absl::ErrnoToStatus(errno ? errno : EIO, "Could not write capture blocks.");
+    data.remove_prefix(n); position += n;
+  }
+  return absl::OkStatus();
+#endif
+}
+}  // namespace
+
+absl::StatusOr<std::shared_ptr<CapturedCacheFile>> CapturedCacheFile::Create(
+    absl::string_view directory, std::shared_ptr<const CapturedCacheFile> previous) {
+  ABSL_ASSIGN_OR_RETURN(int fd, CaptureFD(directory));
+  auto result = std::shared_ptr<CapturedCacheFile>(new CapturedCacheFile(fd, std::string(directory)));
+#if defined(__APPLE__)
+  if (previous) {
+    if (!previous->finished_) return absl::FailedPreconditionError("Capture base is unfinished.");
+    // Never wait for a pending materialization or retain a chain of deltas.
+    // A published base owns only a descriptor and hashes, not its ancestors.
+    result->base_ = std::atomic_load(&previous->materialized_);
+    if (!result->base_) result->base_ = previous->base_;
+    if (result->base_) result->hashes_->reserve(result->base_->hashes->size());
+  }
+#endif
+  return result;
+}
+
+CapturedCacheFile::Base::~Base() {
+#if !defined(_WIN32)
+  close(fd);
+#endif
+}
