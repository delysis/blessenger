+- (void)testWriteImportedSharedFp16WithoutDevice {
+  if (!_device) return;
+
+  LiteRtRankedTensorType tensorType = {};
+  tensorType.element_type = kLiteRtElementTypeFloat16;
+  tensorType.layout.rank = 2;
+  tensorType.layout.dimensions[0] = 1;
+  tensorType.layout.dimensions[1] = 8;
+  tensorType.layout.has_strides = true;
+  tensorType.layout.strides[0] = 16;
+  const uint16_t values[] = {0x3001, 0x3002, 0x3003, 0x3004,
+                             0x3005, 0x3006, 0x3007, 0x3008};
+  const size_t bytes = sizeof(values);
+  id<MTLBuffer> buffer = [_device newBufferWithLength:bytes options:MTLResourceStorageModeShared];
+  XCTAssertNotNil(buffer);
+  if (buffer == nil) return;
+  std::memset(buffer.contents, 0, bytes);
+
+  // Import permits an absent device. The old upload helper silently skipped
+  // its blit on a nil device; a Shared write must update the actual allocation.
+  HwMemoryInfoPtr info = nullptr;
+  XCTAssertEqual(LiteRtImportMetalMemory(
+                     nullptr, (__bridge void*)_commandQueue, &tensorType,
+                     kLiteRtTensorBufferTypeMetalBufferFp16, (__bridge void*)buffer,
+                     bytes, bytes, &info),
+                 kLiteRtStatusOk);
+  std::unique_ptr<HwMemoryInfo, decltype(&LiteRtDestroyMetalMemory)> memory(
+      info, &LiteRtDestroyMetalMemory);
+  XCTAssertTrue(memory != nullptr);
+  if (!memory) return;
+  XCTAssertEqual(LiteRtReleaseMetalHostStagingMemory(memory.get()), kLiteRtStatusOk);
+  void* hostMemory = nullptr;
+  const auto status =
+      LiteRtLockMetalMemory(memory.get(), kLiteRtTensorBufferLockModeWrite, &hostMemory);
+  XCTAssertEqual(status, kLiteRtStatusOk);
+  XCTAssertTrue(hostMemory != nullptr);
+  if (status != kLiteRtStatusOk || hostMemory == nullptr) return;
+  std::memcpy(hostMemory, values, bytes);
+  XCTAssertEqual(LiteRtUnlockMetalMemory(memory.get()), kLiteRtStatusOk);
+  XCTAssertEqual(LiteRtReleaseMetalHostStagingMemory(memory.get()), kLiteRtStatusOk);
+  XCTAssertEqual(std::memcmp(buffer.contents, values, bytes), 0);
+}
