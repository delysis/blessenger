+absl::StatusOr<SerializedLlmContext>
+LlmLiteRtCompiledModelExecutorBase::SerializeContext() const {
+  if (mtp_drafter_ != nullptr ||
+      (executor_settings_.GetAdvancedSettings().has_value() &&
+       executor_settings_.GetAdvancedSettings()->enable_speculative_decoding)) {
+    return absl::FailedPreconditionError(
+        "Disable speculative decoding for persistent sessions; verifier state "
+        "cannot be rolled back to the completed turn boundary.");
+  }
+  if (llm_context_ == nullptr) {
+    return absl::FailedPreconditionError("No context to serialize.");
+  }
+  const auto& config = llm_context_->runtime_config();
+  const auto& runtime = llm_context_->runtime_state();
+  const int heads = config.output_heads.value_or(1);
+  if (heads < 1) {
+    return absl::FailedPreconditionError("Invalid output candidate count.");
+  }
+  StateInterface* active =
+      runtime.ran_decode && heads > 1 ? decode_state_.get() : state_.get();
+  if (active == nullptr) {
+    return absl::FailedPreconditionError("No state to serialize.");
+  }
+  nlohmann::json backend = {
+      {"kind", "litert"},
+      {"output_heads", heads},
+      {"tokens_per_decode", config.tokens_per_decode.has_value()
+                                ? nlohmann::json(*config.tokens_per_decode)
+                                : nlohmann::json(nullptr)},
+      {"lora_active", llm_context_->processed_context().lora_id().has_value()},
+  };
+  SerializedLlmContext result;
+  ABSL_ASSIGN_OR_RETURN(
+      result.metadata,
+      SerializeContextMetadata(
+          executor_settings_, llm_context_->processed_context().processed_tokens(),
+          runtime.current_step, runtime.ran_decode, std::move(backend)));
+  ABSL_ASSIGN_OR_RETURN(result.state, active->Serialize());
+  return result;
+}
+
+absl::Status LlmLiteRtCompiledModelExecutorBase::LoadContext(
+    absl::string_view metadata, absl::string_view state) {
+  if (mtp_drafter_ != nullptr ||
+      (executor_settings_.GetAdvancedSettings().has_value() &&
+       executor_settings_.GetAdvancedSettings()->enable_speculative_decoding)) {
+    return absl::FailedPreconditionError(
+        "Disable speculative decoding for persistent sessions; verifier state "
+        "cannot be rolled back to the completed turn boundary.");
+  }
+  if (llm_context_ == nullptr || llm_context_->runtime_state().current_step != 0) {
+    return absl::FailedPreconditionError("LoadContext requires a fresh context.");
+  }
+  ABSL_ASSIGN_OR_RETURN(auto context,
+                        ParseContextMetadata(metadata, executor_settings_));
+  const auto& config = llm_context_->runtime_config();
+  const int heads = config.output_heads.value_or(1);
+  const nlohmann::json expected_backend = {
+      {"kind", "litert"},
+      {"output_heads", heads},
+      {"tokens_per_decode", config.tokens_per_decode.has_value()
+                                ? nlohmann::json(*config.tokens_per_decode)
+                                : nlohmann::json(nullptr)},
+      {"lora_active", llm_context_->processed_context().lora_id().has_value()},
+  };
+  const int active_batch = context.ran_decode ? heads : 1;
+  if (context.backend.dump() != expected_backend.dump() || heads < 1 ||
+      context.candidate_count != static_cast<size_t>(active_batch)) {
+    return absl::FailedPreconditionError("Incompatible executor context.");
+  }
+  auto embedding_size = [&](const std::optional<std::string>& name)
+      -> absl::StatusOr<size_t> {
+    if (!name.has_value()) return 0;
+    auto buffer = decode_input_buffers_.find(*name);
+    if (buffer == decode_input_buffers_.end()) {
+      return absl::FailedPreconditionError("Embedding input buffer unavailable.");
+    }
+    LITERT_ASSIGN_OR_RETURN(size_t bytes, buffer->second.PackedSize());
+    if (bytes % sizeof(float) != 0 || bytes / sizeof(float) % heads != 0) {
+      return absl::FailedPreconditionError("Invalid embedding input layout.");
+    }
+    return bytes / heads / sizeof(float);
+  };
+  ABSL_ASSIGN_OR_RETURN(size_t embedding_elements,
+                        embedding_size(signatures_.input_embeddings));
+  ABSL_ASSIGN_OR_RETURN(size_t per_layer_elements,
+                        embedding_size(signatures_.input_per_layer_embeddings));
+  ABSL_ASSIGN_OR_RETURN(int vocab_size, GetVocabSize());
+  ABSL_RETURN_IF_ERROR(ValidateContextTokens(
+      context.tokens, vocab_size, embedding_elements, per_layer_elements));
+  auto& target = active_batch > 1 ? decode_state_ : state_;
+  auto* litert_state = dynamic_cast<LitertState*>(target.get());
+  if (litert_state == nullptr) {
+    return absl::FailedPreconditionError("No compatible target state.");
+  }
+  ABSL_ASSIGN_OR_RETURN(auto parsed, ParseSerializedState(state));
+  ABSL_RETURN_IF_ERROR(litert_state->ValidateLoad(parsed, true));
+  ABSL_ASSIGN_OR_RETURN(
+      int entries, ReadContextInteger(parsed.metadata.at("num_entries")));
+  // The final logical token may still be pending and absent from the cache.
+  if (static_cast<int64_t>(context.current_step) >
+      static_cast<int64_t>(entries) + 1) {
+    return absl::InvalidArgumentError("Execution step exceeds cache capacity.");
+  }
+  if (entries != litert_state->GetNumEntries()) {
+    ABSL_ASSIGN_OR_RETURN(auto signature, GetPrefillSignatureKey());
+    if (entries < litert_state->GetNumEntries()) {
+      // Resize only grows. A fresh allocation is needed when this engine has
+      // previously hosted a larger dynamic CPU context.
+      ABSL_ASSIGN_OR_RETURN(
+          auto replacement,
+          LitertState::Create(env_, *compiled_model_, signature,
+                              executor_metadata_,
+                              LitertState::AllocationPolicy::kInplace,
+                              active_batch, false));
+      ABSL_RETURN_IF_ERROR(
+          replacement->Resize(*compiled_model_, signature, entries));
+      ABSL_RETURN_IF_ERROR(replacement->Load(parsed));
+      target = std::move(replacement);
+    } else {
+      ABSL_RETURN_IF_ERROR(
+          litert_state->Resize(*compiled_model_, signature, entries));
+      ABSL_RETURN_IF_ERROR(litert_state->Load(parsed));
+    }
+  } else {
+    ABSL_RETURN_IF_ERROR(litert_state->Load(parsed));
+  }
+  llm_context_->processed_context().processed_tokens() = std::move(context.tokens);
+  llm_context_->runtime_state().current_step = context.current_step;
+  llm_context_->runtime_state().ran_decode = context.ran_decode;
+  // The target session retains its sampling configuration and fresh RNG.
+  sampler_.reset();
+  force_prepare_needed_ = false;
+  return absl::OkStatus();
+}
