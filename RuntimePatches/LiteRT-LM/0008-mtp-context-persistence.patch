+  // smaller fixed globals when the dynamic entry counter allowed more rows.
+  EXPECT_THAT(validate(10, 10, 2048, 4096),
+              StatusIs(absl::StatusCode::kFailedPrecondition));
+  // The configured limit also bounds Decode, including its pending bonus.
+  EXPECT_OK(validate(10, 10, 2048, 1024));
+  descriptors["1/local_k"]["shape"][2] = 1027;
+  EXPECT_THAT(validate(), StatusIs(absl::StatusCode::kFailedPrecondition));
+  descriptors["1/local_k"]["shape"][2] = 1028;
