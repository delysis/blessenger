+absl::StatusOr<SerializedLlmContext>
+LlmLiteRtNpuCompiledModelExecutor::SerializeContext() const {
+  if (speculative_decoding_type_ != SpeculativeDecodingType::kNone) {
+    return absl::FailedPreconditionError(
+        "Disable speculative decoding for persistent NPU sessions; verifier "
+        "state cannot be rolled back to the completed turn boundary.");
+  }
+  if (context_groups_.empty()) {
+    return absl::FailedPreconditionError("No NPU context to serialize.");
+  }
+  nlohmann::json backend = {
+      {"kind", "npu"},
+      {"configuration",
+       {{"dynamic", is_dynamic_model_},
+        {"speculative_decoding", static_cast<int>(speculative_decoding_type_)},
+        {"kv_initial_value", kv_cache_init_value_}}},
+      {"group", active_context_group_index_},
+      {"capacity", dynamic_kv_cache_capacity_},
+  };
+  SerializedLlmContext result;
+  ABSL_ASSIGN_OR_RETURN(
+      result.metadata,
+      SerializeContextMetadata(executor_settings_, processed_tokens_,
+                               current_step_, ran_decode_, std::move(backend)));
+  ABSL_ASSIGN_OR_RETURN(auto buffers, DuplicateNpuState(ActiveContextGroup()));
+  LegacyMapState state(std::move(buffers));
+  ABSL_ASSIGN_OR_RETURN(result.state, state.Serialize());
+  return result;
+}
+
+absl::Status LlmLiteRtNpuCompiledModelExecutor::LoadContext(
+    absl::string_view metadata, absl::string_view state) {
+  if (speculative_decoding_type_ != SpeculativeDecodingType::kNone) {
+    return absl::FailedPreconditionError(
+        "Disable speculative decoding for persistent NPU sessions; verifier "
+        "state cannot be rolled back to the completed turn boundary.");
+  }
+  if (current_step_ != 0 || context_groups_.empty()) {
+    return absl::FailedPreconditionError("LoadContext requires a fresh context.");
+  }
+  ABSL_ASSIGN_OR_RETURN(auto context,
+                        ParseContextMetadata(metadata, executor_settings_));
+  const auto& backend = context.backend;
+  const nlohmann::json configuration = {
+      {"dynamic", is_dynamic_model_},
+      {"speculative_decoding", static_cast<int>(speculative_decoding_type_)},
+      {"kv_initial_value", kv_cache_init_value_},
+  };
+  if (backend.size() != 4 || !backend.contains("kind") ||
+      backend["kind"] != "npu" || !backend.contains("configuration") ||
+      backend["configuration"].dump() != configuration.dump() ||
+      !backend.contains("group") || !backend.contains("capacity") ||
+      context.candidate_count != 1) {
+    return absl::FailedPreconditionError("Incompatible NPU execution context.");
+  }
+  ABSL_ASSIGN_OR_RETURN(int group_index, ReadContextInteger(backend["group"]));
+  ABSL_ASSIGN_OR_RETURN(int capacity, ReadContextInteger(backend["capacity"]));
+  if (group_index < 0 ||
+      static_cast<size_t>(group_index) >= context_groups_.size() ||
+      (is_dynamic_model_ && (group_index != 0 || capacity <= 0)) ||
+      (!is_dynamic_model_ && capacity != 0)) {
+    return absl::FailedPreconditionError("Invalid NPU context group.");
+  }
+  const int context_limit = is_dynamic_model_
+                                ? capacity
+                                : context_groups_[group_index].context_size;
+  // The final logical token may still be pending and absent from the cache.
+  if (context_limit > 0 &&
+      static_cast<int64_t>(context.current_step) >
+          static_cast<int64_t>(context_limit) + 1) {
+    return absl::InvalidArgumentError("NPU execution step exceeds cache capacity.");
+  }
+  ABSL_ASSIGN_OR_RETURN(int vocab_size, GetVocabSize());
+  auto input_elements = [&](absl::string_view name, bool raw_float)
+      -> absl::StatusOr<size_t> {
+    const auto& inputs = context_groups_[group_index]
+                             .text_decoder_inference_context
+                             .decode_input_buffers;
+    auto input = inputs.find(name);
+    if (input == inputs.end()) return 0;
+    if (raw_float) {
+      LITERT_ASSIGN_OR_RETURN(size_t bytes, input->second.PackedSize());
+      if (bytes % sizeof(float) != 0) {
+        return absl::FailedPreconditionError("Invalid NPU embedding layout.");
+      }
+      return bytes / sizeof(float);
+    }
+    LITERT_ASSIGN_OR_RETURN(auto type, input->second.TensorType());
+    LITERT_ASSIGN_OR_RETURN(size_t elements, type.Layout().NumElements());
+    return elements;
+  };
+  ABSL_ASSIGN_OR_RETURN(size_t embedding_elements,
+                        input_elements(TextDecoderSignatures::kInputEmbeddings,
+                                       true));
+  ABSL_ASSIGN_OR_RETURN(size_t per_layer_elements,
+                        input_elements(kPerLayerEmbedderTensor, false));
+  ABSL_RETURN_IF_ERROR(ValidateContextTokens(
+      context.tokens, vocab_size, embedding_elements, per_layer_elements));
+  ABSL_ASSIGN_OR_RETURN(auto parsed, ParseSerializedState(state));
+  if (parsed.metadata != nlohmann::json{{"kind", "legacy_map"}}) {
+    return absl::FailedPreconditionError("Invalid NPU state representation.");
+  }
+  ABSL_ASSIGN_OR_RETURN(auto buffers,
+                        DuplicateNpuState(context_groups_[group_index]));
+  if (is_dynamic_model_ && capacity != dynamic_kv_cache_capacity_) {
+    ABSL_RETURN_IF_ERROR(ValidateNpuStateForResize(
+        parsed, buffers, context_groups_[0].geometry, capacity,
+        executor_metadata_));
+    if (text_decoder_model_ == nullptr) {
+      return absl::FailedPreconditionError("NPU model unavailable for resizing.");
+    }
+    absl::flat_hash_map<absl::string_view, HWQuantParams> unused_quant_params;
+    LITERT_ASSIGN_OR_RETURN(
+        auto built,
+        CreateDynamicContextGroup(env_, text_decoder_model_,
+                                  text_decoder_compiled_model_,
+                                  prefill_signatures_.size, unused_quant_params,
+                                  kv_cache_init_value_, capacity,
+                                  executor_metadata_));
+    if (built.resolved_context_size != capacity) {
+      return absl::FailedPreconditionError("NPU cache capacity changed.");
+    }
+    built.group.decode_aux_signatures = context_groups_[0].decode_aux_signatures;
+    built.group.verify_aux_signatures = context_groups_[0].verify_aux_signatures;
+    ABSL_ASSIGN_OR_RETURN(buffers, DuplicateNpuState(built.group));
+    ABSL_RETURN_IF_ERROR(ValidateSerializedState(parsed, buffers));
+    LITERT_RETURN_IF_ERROR(ResizeAuxiliaryMaskInputs(
+        npu_auxiliary_context_.npu_auxiliary_compiled_model, built.group,
+        built.resolved_context_size));
+    LITERT_RETURN_IF_ERROR(main_mask_.RecreateContextLengthInputBuffers(
+        built.group.prefill_signatures.mask, built.group.decode_aux_signatures.mask,
+        built.group.verify_aux_signatures.mask));
+    ABSL_RETURN_IF_ERROR(LoadSerializedState(parsed, buffers));
+    // Keep the old aliases alive until all auxiliary consumers are rebound.
+    ContextGroup retired = std::move(context_groups_[0]);
+    context_groups_[0] = std::move(built.group);
+    active_context_group_index_ = 0;
+    dynamic_kv_cache_capacity_ = built.resolved_context_size;
+    LITERT_RETURN_IF_ERROR(RebindActiveContextGroup());
+  } else {
+    ABSL_RETURN_IF_ERROR(LoadSerializedState(parsed, buffers));
+    active_context_group_index_ = group_index;
+    LITERT_RETURN_IF_ERROR(RebindActiveContextGroup());
+  }
+  processed_tokens_ = std::move(context.tokens);
+  current_step_ = context.current_step;
+  ran_decode_ = context.ran_decode;
+  return absl::OkStatus();
+}
