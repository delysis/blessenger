+#include "runtime/core/session_cache_file.h"
+
+#include <atomic>
+#include <cerrno>
+#include <chrono>
+#include <cstddef>
+#include <cstdint>
+#include <cstdio>
+#include <filesystem>
+#include <limits>
+#include <string>
+#include <system_error>
+#include <utility>
+
+#if defined(_WIN32)
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <io.h>
+#include <windows.h>
+#else
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#endif
+
+#include "absl/cleanup/cleanup.h"       // from @com_google_absl
+#include "absl/crc/crc32c.h"            // from @com_google_absl
+#include "absl/status/status.h"        // from @com_google_absl
+#include "absl/status/status_macros.h"  // from @com_google_absl
+#include "absl/status/statusor.h"      // from @com_google_absl
+#include "absl/strings/str_cat.h"       // from @com_google_absl
+#include "absl/strings/string_view.h"  // from @com_google_absl
+#include "runtime/util/memory_mapped_file.h"
+
+namespace litert::lm {
+namespace {
+
+constexpr absl::string_view kMagic = "LRTLMCS1";
+constexpr size_t kHeaderSize = 40;
+constexpr size_t kMaxKeySize = 4096;
+constexpr size_t kMaxMetadataSize = 16 * 1024 * 1024;
+
+void AppendLittleEndian(std::string& out, uint64_t value, int bytes) {
+  for (int i = 0; i < bytes; ++i) {
+    out.push_back(static_cast<char>(value & 0xff));
+    value >>= 8;
+  }
+}
+
+uint64_t ReadLittleEndian(absl::string_view data) {
+  uint64_t value = 0;
+  for (size_t i = 0; i < data.size(); ++i) {
+    value |= uint64_t{static_cast<unsigned char>(data[i])} << (8 * i);
+  }
+  return value;
+}
+
+absl::Status CheckArguments(absl::string_view path, absl::string_view key) {
+  if (path.empty() || path.find('\0') != absl::string_view::npos ||
+      key.empty() || key.size() > kMaxKeySize) {
+    return absl::InvalidArgumentError("Invalid session cache path or key.");
+  }
+  return absl::OkStatus();
+}
+
+absl::crc32c_t Checksum(absl::string_view header, absl::string_view key,
+                        absl::string_view metadata, absl::string_view state) {
+  auto crc = absl::ComputeCrc32c(header);
+  crc = absl::ExtendCrc32c(crc, key);
+  crc = absl::ExtendCrc32c(crc, metadata);
+  return absl::ExtendCrc32c(crc, state);
+}
+
+absl::Status WriteAll(FILE* file, absl::string_view data) {
+  while (!data.empty()) {
+    const size_t written = std::fwrite(data.data(), 1, data.size(), file);
+    if (written == 0) {
+      return absl::ErrnoToStatus(errno ? errno : EIO,
+                                "Could not write session cache.");
+    }
+    data.remove_prefix(written);
+  }
+  return absl::OkStatus();
+}
+
+}  // namespace
+
+absl::Status WriteSessionCacheFile(absl::string_view path,
+                                   absl::string_view compatibility_key,
+                                   int last_prefill_token_id,
+                                   absl::string_view metadata,
+                                   absl::string_view state) {
+  ABSL_RETURN_IF_ERROR(CheckArguments(path, compatibility_key));
+  if (metadata.empty() || metadata.size() > kMaxMetadataSize || state.empty()) {
+    return absl::InvalidArgumentError("Invalid session cache payload.");
+  }
+  std::string header(kMagic);
+  AppendLittleEndian(header, compatibility_key.size(), 8);
+  AppendLittleEndian(header, metadata.size(), 8);
+  AppendLittleEndian(header, state.size(), 8);
+  AppendLittleEndian(header, static_cast<uint32_t>(last_prefill_token_id), 4);
+  AppendLittleEndian(header,
+                     static_cast<uint32_t>(Checksum(
+                         header, compatibility_key, metadata, state)),
+                     4);
+
+  const auto destination = std::filesystem::u8path(path.begin(), path.end());
+  std::filesystem::path temporary;
+  FILE* file = nullptr;
+  static std::atomic<uint64_t> sequence{0};
+  for (int attempt = 0; attempt < 16 && file == nullptr; ++attempt) {
+    temporary = destination;
+    temporary += absl::StrCat(
+        ".tmp.", std::chrono::steady_clock::now().time_since_epoch().count(),
+        ".", sequence.fetch_add(1, std::memory_order_relaxed));
+#if defined(_WIN32)
+    file = _wfopen(temporary.c_str(), L"wbx");
+#else
+    file = std::fopen(temporary.c_str(), "wbx");
+#endif
+    if (file == nullptr && errno != EEXIST) {
+      return absl::ErrnoToStatus(errno, "Could not create session cache.");
+    }
+  }
+  if (file == nullptr) {
+    return absl::AlreadyExistsError("Could not create a unique cache file.");
+  }
+  absl::Cleanup cleanup = [&] {
+    if (file != nullptr) std::fclose(file);
+    std::error_code ignored;
+    std::filesystem::remove(temporary, ignored);
+  };
+#if !defined(_WIN32)
+  if (fchmod(fileno(file), S_IRUSR | S_IWUSR) != 0) {
+    return absl::ErrnoToStatus(errno, "Could not restrict cache permissions.");
+  }
+#endif
+  ABSL_RETURN_IF_ERROR(WriteAll(file, header));
+  ABSL_RETURN_IF_ERROR(WriteAll(file, compatibility_key));
+  ABSL_RETURN_IF_ERROR(WriteAll(file, metadata));
+  ABSL_RETURN_IF_ERROR(WriteAll(file, state));
+  if (std::fflush(file) != 0) {
+    return absl::ErrnoToStatus(errno, "Could not flush session cache.");
+  }
+#if defined(_WIN32)
+  const int sync_result = _commit(_fileno(file));
+#else
+  int sync_result;
+  do {
+    sync_result = fsync(fileno(file));
+  } while (sync_result != 0 && errno == EINTR);
+#endif
+  if (sync_result != 0) {
+    return absl::ErrnoToStatus(errno, "Could not sync session cache.");
+  }
+  const int close_result = std::fclose(std::exchange(file, nullptr));
+  if (close_result != 0) {
+    return absl::ErrnoToStatus(errno, "Could not close session cache.");
+  }
+#if defined(_WIN32)
+  if (!MoveFileExW(temporary.c_str(), destination.c_str(),
+                  MOVEFILE_REPLACE_EXISTING | MOVEFILE_WRITE_THROUGH)) {
+    return absl::InternalError(
+        absl::StrCat("Could not publish session cache: ", GetLastError()));
+  }
+#else
+  if (std::rename(temporary.c_str(), destination.c_str()) != 0) {
+    return absl::ErrnoToStatus(errno, "Could not publish session cache.");
+  }
+  const auto parent = destination.has_parent_path()
+                          ? destination.parent_path()
+                          : std::filesystem::path(".");
+  const int dir_fd = open(parent.c_str(), O_RDONLY | O_DIRECTORY | O_CLOEXEC);
+  if (dir_fd < 0) {
+    return absl::ErrnoToStatus(
+        errno, "Cache published; directory durability could not be confirmed.");
+  }
+  do {
+    sync_result = fsync(dir_fd);
+  } while (sync_result != 0 && errno == EINTR);
+  const int sync_errno = errno;
+  close(dir_fd);
+  if (sync_result != 0) {
+    return absl::ErrnoToStatus(
+        sync_errno, "Cache published; directory durability is uncertain.");
+  }
+#endif
+  return absl::OkStatus();
+}
+
+absl::StatusOr<MappedSessionCache> ReadSessionCacheFile(
+    absl::string_view path, absl::string_view compatibility_key) {
+  ABSL_RETURN_IF_ERROR(CheckArguments(path, compatibility_key));
+  ABSL_ASSIGN_OR_RETURN(
+      auto mapping,
+      MemoryMappedFile::Create(path, MemoryMappedFile::Access::kRead));
+  if (mapping->length() < kHeaderSize ||
+      mapping->length() > std::numeric_limits<size_t>::max()) {
+    return absl::DataLossError("Invalid session cache size.");
+  }
+  absl::string_view bytes(static_cast<const char*>(mapping->data()),
+                         static_cast<size_t>(mapping->length()));
+  const auto header = bytes.substr(0, kHeaderSize);
+  if (header.substr(0, 8) != kMagic) {
+    return absl::InvalidArgumentError("Unsupported session cache format.");
+  }
+  const uint64_t key_size = ReadLittleEndian(header.substr(8, 8));
+  const uint64_t metadata_size = ReadLittleEndian(header.substr(16, 8));
+  const uint64_t state_size = ReadLittleEndian(header.substr(24, 8));
+  bytes.remove_prefix(kHeaderSize);
+  if (key_size == 0 || key_size > kMaxKeySize || key_size > bytes.size()) {
+    return absl::DataLossError("Invalid session cache key length.");
+  }
+  const auto key = bytes.substr(0, key_size);
+  bytes.remove_prefix(key_size);
+  if (metadata_size == 0 || metadata_size > kMaxMetadataSize ||
+      metadata_size > bytes.size()) {
+    return absl::DataLossError("Invalid session cache metadata length.");
+  }
+  const auto metadata = bytes.substr(0, metadata_size);
+  bytes.remove_prefix(metadata_size);
+  if (state_size == 0 || state_size != bytes.size()) {
+    return absl::DataLossError("Invalid session cache state length.");
+  }
+  if (key != compatibility_key) {
+    return absl::FailedPreconditionError(
+        "Session cache compatibility key differs.");
+  }
+  const auto expected_crc = ReadLittleEndian(header.substr(36, 4));
+  if (static_cast<uint32_t>(Checksum(header.substr(0, 36), key, metadata, bytes)) !=
+      expected_crc) {
+    return absl::DataLossError("Session cache checksum mismatch.");
+  }
+  const uint32_t token_bits = ReadLittleEndian(header.substr(32, 4));
+  const int token_id = token_bits <= std::numeric_limits<int32_t>::max()
+                           ? static_cast<int>(token_bits)
+                           : -1 - static_cast<int>(UINT32_MAX - token_bits);
+  return MappedSessionCache{std::move(mapping), metadata, bytes, token_id};
+}
+
+}  // namespace litert::lm
