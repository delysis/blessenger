+LiteRtStatus ReleaseCudaHostStagingMemory(HwMemoryInfoPtr hw_memory_info) {
+  auto* info = AsCudaTensorBufferInfo(hw_memory_info);
+  if (info == nullptr) {
+    return kLiteRtStatusErrorInvalidArgument;
+  }
+  if (info->locked) {
+    return kLiteRtStatusErrorRuntimeFailure;
+  }
+  cudaPointerAttributes attributes;
+  LITERT_RETURN_IF_ERROR(CudaStatus(
+      cudaPointerGetAttributes(&attributes, info->memory_handle),
+      "cudaPointerGetAttributes release host staging"));
+  int previous_device;
+  LITERT_RETURN_IF_ERROR(
+      CudaStatus(cudaGetDevice(&previous_device), "cudaGetDevice host staging"));
+  if (previous_device != attributes.device) {
+    LITERT_RETURN_IF_ERROR(CudaStatus(cudaSetDevice(attributes.device),
+                                      "cudaSetDevice host staging"));
+  }
+
+  // A cacheless imported alias may still have pending writes through another
+  // wrapper of this allocation. Complete those before returning success.
+  // A device wait also protects pinned staging read by earlier async uploads.
+  LiteRtStatus status =
