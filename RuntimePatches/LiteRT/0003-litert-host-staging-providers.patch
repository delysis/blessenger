+  // Checkpoint transfers keep dirty flags until the upload has completed, so
+  // a failed checkpoint does not silently discard a pending host write.
+  LiteRtStatus CompleteHostWrites(void* handle) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    const auto range = buffers_.equal_range(handle);
+    LiteRtStatus status = kLiteRtStatusOk;
+    for (auto it = range.first; it != range.second; ++it) {
+      auto* info = it->second;
+      if (info->host_dirty && info->host_cache != nullptr) {
+        status = CudaStatus(cudaMemcpyAsync(
+                                info->memory_handle, info->host_cache,
+                                CopyBytes(*info), cudaMemcpyHostToDevice,
+                                /*stream=*/nullptr),
+                            "checkpoint CUDA host upload");
+        if (status != kLiteRtStatusOk) {
+          break;
+        }
+      }
+    }
+    const auto wait_status =
+        CudaStatus(cudaDeviceSynchronize(), "complete host staging upload");
+    if (status == kLiteRtStatusOk) {
+      status = wait_status;
+    }
+    if (status == kLiteRtStatusOk) {
+      for (auto it = range.first; it != range.second; ++it) {
+        it->second->host_dirty = false;
+      }
+    }
+    return status;
+  }
