+
+#include "runtime/core/session_cache_file.h"
+
+#include <chrono>
+#include <filesystem>
+#include <fstream>
+#include <iterator>
+#include <string>
+#include <system_error>
+
+#include <gtest/gtest.h>
+#include "absl/status/status.h"  // from @com_google_absl
+
+namespace litert::lm {
+namespace {
+
+class SessionCacheFileTest : public ::testing::Test {
+ protected:
+  void SetUp() override {
+    directory_ = std::filesystem::path(::testing::TempDir()) /
+                 ("session-cache-" + std::to_string(
+                     std::chrono::steady_clock::now().time_since_epoch().count()));
+    ASSERT_TRUE(std::filesystem::create_directory(directory_));
+    path_ = (directory_ / "session.cache").string();
+  }
+  void TearDown() override {
+    std::error_code ignored;
+    std::filesystem::remove_all(directory_, ignored);
+  }
+  std::string ReadBytes() {
+    std::ifstream file(path_, std::ios::binary);
+    return {std::istreambuf_iterator<char>(file), std::istreambuf_iterator<char>()};
+  }
+  void ReplaceBytes(const std::string& data) {
+    std::ofstream file(path_, std::ios::binary | std::ios::trunc);
+    file.write(data.data(), data.size());
+    ASSERT_TRUE(file.good());
+  }
+  std::filesystem::path directory_;
+  std::string path_;
+};
+
+TEST_F(SessionCacheFileTest, RoundTripAndReplacement) {
+  const std::string state("\0\1\2\xff\0", 5);
+  ASSERT_TRUE(WriteSessionCacheFile(path_, "verified-key", -3, "metadata", state).ok());
+  {
+    auto result = ReadSessionCacheFile(path_, "verified-key");
+    ASSERT_TRUE(result.ok()) << result.status();
+    EXPECT_EQ(result->metadata, "metadata");
+    EXPECT_EQ(result->state, state);
+    EXPECT_EQ(result->last_prefill_token_id, -3);
+    const auto* begin = static_cast<const char*>(result->mapping->data());
+    EXPECT_GE(result->state.data(), begin);
+    EXPECT_LE(result->state.data() + result->state.size(),
+              begin + result->mapping->length());
+  }
+  ASSERT_TRUE(WriteSessionCacheFile(path_, "verified-key", 42, "new", "new-state").ok());
+  auto result = ReadSessionCacheFile(path_, "verified-key");
+  ASSERT_TRUE(result.ok()) << result.status();
+  EXPECT_EQ(result->metadata, "new");
+  EXPECT_EQ(result->state, "new-state");
+  EXPECT_EQ(result->last_prefill_token_id, 42);
+  EXPECT_EQ(std::distance(std::filesystem::directory_iterator(directory_),
+                          std::filesystem::directory_iterator()), 1);
+}
+
+TEST_F(SessionCacheFileTest, WrongKeyDoesNotModifyFile) {
+  ASSERT_TRUE(WriteSessionCacheFile(path_, "model-a", 1, "meta", "state").ok());
+  const auto original = ReadBytes();
+  EXPECT_EQ(ReadSessionCacheFile(path_, "model-b").status().code(),
+            absl::StatusCode::kFailedPrecondition);
+  EXPECT_EQ(ReadBytes(), original);
+}
+
+TEST_F(SessionCacheFileTest, RejectsEveryTruncationAndTrailingData) {
+  ASSERT_TRUE(WriteSessionCacheFile(path_, "key", 1, "meta", "state").ok());
+  const auto original = ReadBytes();
+  for (size_t length = 0; length < original.size(); ++length) {
+    ReplaceBytes(original.substr(0, length));
+    EXPECT_FALSE(ReadSessionCacheFile(path_, "key").ok()) << length;
+  }
+  ReplaceBytes(original + "x");
+  EXPECT_EQ(ReadSessionCacheFile(path_, "key").status().code(),
+            absl::StatusCode::kDataLoss);
+}
+
+TEST_F(SessionCacheFileTest, RejectsCorruptionAcrossHeaderMetadataAndState) {
+  ASSERT_TRUE(WriteSessionCacheFile(path_, "key", 7, "metadata", "payload").ok());
+  const auto original = ReadBytes();
+  for (size_t offset = 0; offset < original.size(); ++offset) {
+    auto changed = original;
+    changed[offset] ^= 0x40;
+    ReplaceBytes(changed);
+    EXPECT_FALSE(ReadSessionCacheFile(path_, "key").ok()) << offset;
+  }
+}
+
+TEST_F(SessionCacheFileTest, InvalidSavePreservesPreviousFile) {
+  ASSERT_TRUE(WriteSessionCacheFile(path_, "key", 1, "meta", "state").ok());
+  const auto original = ReadBytes();
+  EXPECT_FALSE(WriteSessionCacheFile(path_, "", 2, "new", "new-state").ok());
+  EXPECT_FALSE(WriteSessionCacheFile(path_, "key", 2, "", "new-state").ok());
+  EXPECT_FALSE(WriteSessionCacheFile(path_, "key", 2, "new", "").ok());
+  EXPECT_EQ(ReadBytes(), original);
+}
+
+TEST_F(SessionCacheFileTest, PublicationFailureRemovesOnlyTemporaryFile) {
+  ASSERT_TRUE(std::filesystem::create_directory(path_));
+  EXPECT_FALSE(WriteSessionCacheFile(path_, "key", 1, "meta", "state").ok());
+  EXPECT_TRUE(std::filesystem::is_directory(path_));
+  EXPECT_EQ(std::distance(std::filesystem::directory_iterator(directory_),
+                          std::filesystem::directory_iterator()), 1);
+}
+
+}  // namespace
+}  // namespace litert::lm
