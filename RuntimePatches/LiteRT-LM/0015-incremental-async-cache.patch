+
+TEST_F(SessionCacheFileTest, IncrementalClonePreservesParentAndGrowingMetadata) {
+  std::string before(3 * 65536 + 17, 'a');
+  ASSERT_TRUE(WriteSessionCacheFile(path_, "old-key", 1, "small", before, "", nullptr, true).ok());
+  const auto parent_bytes = ReadBytes();
+  const auto child = (directory_ / "child.cache").string();
+  std::string after = before;
+  after[65536 + 9] = 'z';
+  after.back() = 'q';
+  size_t written = 0;
+  ASSERT_TRUE(WriteSessionCacheFile(child, "new-key", 2, std::string(8192, 'm'),
+                                   after, path_, &written, true).ok());
+#if defined(__APPLE__)
+  EXPECT_LT(written, after.size());
+#endif
+  EXPECT_EQ(ReadBytes(), parent_bytes);
+  auto restored = ReadSessionCacheFile(child, "new-key");
+  ASSERT_TRUE(restored.ok()) << restored.status();
+  EXPECT_EQ(restored->state, after);
+  EXPECT_EQ(restored->metadata, std::string(8192, 'm'));
+  EXPECT_EQ(restored->last_prefill_token_id, 2);
+  EXPECT_FALSE(ReadSessionCacheFile(child, "old-key").ok());
+}
+
+TEST_F(SessionCacheFileTest, IncrementalCloneCanShrinkAndRepairsCorruptParentData) {
+  std::string before(4 * 65536, 'a');
+  ASSERT_TRUE(WriteSessionCacheFile(path_, "key", 1, "metadata", before, "", nullptr, true).ok());
+  auto corrupt = ReadBytes();
+  corrupt.back() = 'x';
+  ReplaceBytes(corrupt);
+  const auto child = (directory_ / "child.cache").string();
+  ASSERT_TRUE(WriteSessionCacheFile(child, "key", 2, "metadata", before, path_, nullptr, true).ok());
+  auto repaired = ReadSessionCacheFile(child, "key");
+  ASSERT_TRUE(repaired.ok()) << repaired.status();
+  EXPECT_EQ(repaired->state, before);
+  before.resize(123);
+  const auto short_path = (directory_ / "short.cache").string();
+  ASSERT_TRUE(WriteSessionCacheFile(short_path, "key", 3, "m", before, child, nullptr, true).ok());
+  auto shortened = ReadSessionCacheFile(short_path, "key");
+  ASSERT_TRUE(shortened.ok()) << shortened.status();
+  EXPECT_EQ(shortened->state, before);
+}
+
+
+#if !defined(_WIN32)
+TEST_F(SessionCacheFileTest, ProcessDeathLeavesOnlyOldOrCompleteNewCheckpoint) {
+  const std::string old_state(8 * 1024 * 1024, 'a');
+  const std::string new_state(8 * 1024 * 1024, 'b');
+  for (const int delay_us : {0, 100, 1000, 5000, 20000, 100000}) {
+    ASSERT_TRUE(WriteSessionCacheFile(path_, "key", 1, "old", old_state, "", nullptr, true).ok());
+    const pid_t child = fork();
+    ASSERT_GE(child, 0);
+    if (child == 0) {
+      const auto status = WriteSessionCacheFile(path_, "key", 2, "new", new_state, path_, nullptr, true);
+      _exit(status.ok() ? 0 : 1);
+    }
+    usleep(delay_us);
+    kill(child, SIGKILL);
+    int status = 0;
+    ASSERT_EQ(waitpid(child, &status, 0), child);
+    auto restored = ReadSessionCacheFile(path_, "key");
+    ASSERT_TRUE(restored.ok()) << restored.status();
+    if (restored->last_prefill_token_id == 1) {
+      EXPECT_EQ(restored->metadata, "old");
+      EXPECT_EQ(restored->state, old_state);
+    } else {
+      EXPECT_EQ(restored->last_prefill_token_id, 2);
+      EXPECT_EQ(restored->metadata, "new");
+      EXPECT_EQ(restored->state, new_state);
+    }
+  }
+}
+#endif
