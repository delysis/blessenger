@@ -146,17 +146,20 @@ absl::StatusOr<size_t> TransferOffset(const TensorBuffer& buffer,
   LITERT_ASSIGN_OR_RETURN(auto type, buffer.TensorType());
   LITERT_ASSIGN_OR_RETURN(auto buffer_type, buffer.BufferType());
   const auto& layout = type.Layout();
-  if (buffer_type == TensorBufferType::kMetalBufferFp16) {
+  const bool is_int8_metal = buffer_type == TensorBufferType::kMetalBuffer &&
+                            type.ElementType() == ElementType::Int8;
+  if (buffer_type == TensorBufferType::kMetalBufferFp16 || is_int8_metal) {
     // Metal reports PHWC4 storage as {16}, but Lock/Unlock convert to/from
     // contiguous host data. Gemma's KV kernels use a different blocked layout;
     // the conversion preserves every device word only when there is no padding.
     const auto dimensions = layout.Dimensions();
-    if (type.ElementType() != ElementType::Float16 || dimensions.size() < 2 ||
+    if ((!is_int8_metal && type.ElementType() != ElementType::Float16) ||
+        dimensions.size() < 2 ||
         dimensions.size() > 4 || dimensions.back() % 4 != 0 ||
         std::any_of(dimensions.begin(), dimensions.end(),
                     [](int32_t dim) { return dim <= 0; })) {
       return absl::UnimplementedError(
-          "Metal FP16 state requires an unpadded rank-2 to rank-4 FP16 tensor.");
+          "Metal state requires an unpadded rank-2 to rank-4 FP16 or INT8 tensor.");
     }
     const auto strides = layout.Strides();
     if (layout.HasStrides() &&
@@ -170,7 +173,8 @@ absl::StatusOr<size_t> TransferOffset(const TensorBuffer& buffer,
       return absl::UnimplementedError("Padded Metal state storage is unsupported.");
     }
     // The descriptor conversion uses signed int element indices.
-    if (packed_bytes / sizeof(uint16_t) >
+    const size_t element_bytes = is_int8_metal ? sizeof(int8_t) : sizeof(uint16_t);
+    if (packed_bytes / element_bytes >
         static_cast<size_t>(std::numeric_limits<int>::max())) {
       return absl::UnimplementedError("Metal state exceeds the conversion index range.");
     }
