+template <typename Bank>
+absl::StatusOr<std::pair<nlohmann::json, StateTensorBuffers>> SerializationData(
+    int batch_size, int num_entries, LitertState::AllocationPolicy policy,
+    bool bank_1_is_input, const Bank& bank_1, const std::optional<Bank>& bank_2) {
+  nlohmann::json metadata = {{"kind", "litert"},
+                            {"allocation_policy", static_cast<int>(policy)},
+                            {"batch_size", batch_size},
+                            {"num_entries", num_entries},
+                            {"bank_1_is_input", bank_1_is_input},
+                            {"state_buffers", nlohmann::json::object()}};
+  StateTensorBuffers buffers;
+  auto add_bank = [&](const Bank& bank, absl::string_view prefix) -> absl::Status {
+    for (const auto& [name, state] : bank) {
+      std::string key = absl::StrCat(prefix, name);
+      LITERT_ASSIGN_OR_RETURN(auto buffer, state.buffer.Duplicate());
+      buffers.emplace(key, std::move(buffer));
+      metadata["state_buffers"][key] = {
+          {"state_type", static_cast<int>(state.type)},
+          {"dynamic_dim", state.dynamic_dim.has_value()
+                              ? nlohmann::json(*state.dynamic_dim)
+                              : nlohmann::json(nullptr)}};
+    }
+    return absl::OkStatus();
+  };
+  ABSL_RETURN_IF_ERROR(add_bank(bank_1, "1/"));
+  if (bank_2.has_value()) ABSL_RETURN_IF_ERROR(add_bank(*bank_2, "2/"));
+  return std::make_pair(std::move(metadata), std::move(buffers));
+}
+
 }  // namespace
 
+absl::StatusOr<std::string> LitertState::Serialize() const {
+  ABSL_ASSIGN_OR_RETURN(
+      auto data, SerializationData(batch_size_, num_entries_, allocation_policy_,
+                                   bank_1_is_input_, bank_1_state_buffers_,
+                                   bank_2_state_buffers_));
+  return SerializeState(data.first, data.second);
+}
+
+absl::Status LitertState::ValidateLoad(const ParsedSerializedState& state,
+                                      bool allow_dynamic_resize) const {
+  const auto& metadata = state.metadata;
+  if (!metadata.is_object() || !metadata.contains("num_entries") ||
+      !metadata["num_entries"].is_number_integer() ||
+      !metadata.contains("bank_1_is_input") ||
+      !metadata["bank_1_is_input"].is_boolean() ||
+      (!bank_2_state_buffers_.has_value() &&
+       !metadata["bank_1_is_input"].get<bool>())) {
+    return absl::InvalidArgumentError("Invalid LiteRT state metadata.");
+  }
+  const auto& entries = metadata["num_entries"];
+  if ((entries.is_number_unsigned() &&
+       entries.get<uint64_t>() > std::numeric_limits<int>::max()) ||
+      (!entries.is_number_unsigned() &&
+       (entries.get<int64_t>() < 0 ||
+        entries.get<int64_t>() > std::numeric_limits<int>::max()))) {
+    return absl::InvalidArgumentError("Invalid LiteRT state capacity.");
+  }
+  const int saved_entries = entries.get<int>();
+  const bool resizing = saved_entries != num_entries_;
+  if (resizing && (!allow_dynamic_resize || saved_entries <= 0 ||
+                   allocation_policy_ != AllocationPolicy::kInplace)) {
+    return absl::InvalidArgumentError("Incompatible LiteRT state capacity.");
+  }
+  ABSL_ASSIGN_OR_RETURN(
+      auto data, SerializationData(batch_size_, saved_entries, allocation_policy_,
+                                   metadata["bank_1_is_input"].get<bool>(),
+                                   bank_1_state_buffers_, bank_2_state_buffers_));
+  if (metadata.dump() != data.first.dump()) {
+    return absl::InvalidArgumentError("Incompatible LiteRT state metadata.");
+  }
+  if (!resizing) return ValidateSerializedState(state, data.second);
+  if (state.tensors.size() != data.second.size()) {
+    return absl::InvalidArgumentError("State tensor count mismatch.");
+  }
+  bool has_dynamic_dimension = false;
+  absl::string_view previous_name;
+  for (const auto& tensor : state.tensors) {
+    const auto it = data.second.find(tensor.name);
+    if (it == data.second.end() || tensor.name <= previous_name) {
+      return absl::InvalidArgumentError("State tensor name mismatch.");
+    }
+    previous_name = tensor.name;
+    ABSL_ASSIGN_OR_RETURN(auto expected, DescribeStateTensor(it->second));
+    const auto& axis = data.first["state_buffers"][tensor.name]["dynamic_dim"];
+    if (!axis.is_null()) {
+      const int index = axis.get<int>();
+      if (index < 0 || static_cast<size_t>(index) >= expected["shape"].size() ||
+          expected["shape"][index] != num_entries_) {
+        return absl::InvalidArgumentError("Invalid dynamic state tensor axis.");
+      }
+      expected["shape"][index] = saved_entries;
+      size_t elements = 1;
+      for (const auto& dim : expected["shape"]) {
+        const size_t value = dim.get<size_t>();
+        if (value != 0 && elements > std::numeric_limits<size_t>::max() / value) {
+          return absl::InvalidArgumentError("Dynamic state tensor size overflows.");
+        }
+        elements *= value;
+      }
+      const auto width = GetByteWidth(
+          static_cast<ElementType>(expected["type"].get<int>()));
+      if (elements > (std::numeric_limits<size_t>::max() - 3) /
+                         static_cast<size_t>(*width)) {
+        return absl::InvalidArgumentError("Dynamic state tensor size overflows.");
+      }
+      expected["bytes"] = width->NumBytes(elements);
+      has_dynamic_dimension = true;
+    }
+    if (tensor.descriptor.dump() != expected.dump() ||
+        tensor.bytes.size() != expected["bytes"].get<size_t>()) {
+      return absl::InvalidArgumentError("State tensor descriptor mismatch.");
+    }
+  }
+  return has_dynamic_dimension
+             ? absl::OkStatus()
+             : absl::InvalidArgumentError("State has no dynamic dimensions.");
+}
+
+absl::Status LitertState::Load(absl::string_view serialized_state) {
+  ABSL_ASSIGN_OR_RETURN(auto state, ParseSerializedState(serialized_state));
+  return Load(state);
+}
+
+absl::Status LitertState::Load(const ParsedSerializedState& state) {
+  ABSL_RETURN_IF_ERROR(ValidateLoad(state));
+  ABSL_ASSIGN_OR_RETURN(
+      auto data, SerializationData(batch_size_, num_entries_, allocation_policy_,
+                                   bank_1_is_input_, bank_1_state_buffers_,
+                                   bank_2_state_buffers_));
+  ABSL_RETURN_IF_ERROR(LoadSerializedState(state, data.second));
+  bank_1_is_input_ = state.metadata["bank_1_is_input"].get<bool>();
+  return absl::OkStatus();
+}
