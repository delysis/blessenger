+// limitations under the License.
+
+#include "runtime/executor/litert/state_serialization.h"
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "absl/crc/crc32c.h"  // from @com_google_absl
+#include "absl/status/status.h"  // from @com_google_absl
+#include "absl/status/status_macros.h"  // from @com_google_absl
+#include "absl/status/statusor.h"  // from @com_google_absl
+#include "absl/strings/string_view.h"  // from @com_google_absl
+#include "nlohmann/json.hpp"  // from @nlohmann_json
+#include "litert/c/litert_layout.h"  // from @litert
+#include "litert/cc/litert_element_type.h"  // from @litert
+#include "litert/cc/litert_macros.h"  // from @litert
+#include "litert/cc/litert_tensor_buffer_types.h"  // from @litert
+
+namespace litert::lm {
+namespace {
+
+constexpr absl::string_view kMagic = "LRTSTATE";
+constexpr size_t kPrefixBytes = 16;
+constexpr size_t kChecksumBytes = 4;
+constexpr size_t kMaxHeaderBytes = 1024 * 1024;
+constexpr size_t kMaxTensors = 4096;
+constexpr size_t kMaxNameBytes = 1024;
+
+void AppendInteger(std::string& out, uint64_t value, int bytes) {
+  for (int i = 0; i < bytes; ++i) {
+    out.push_back(static_cast<char>(value & 255));
+    value >>= 8;
+  }
+}
+
+uint64_t ReadInteger(absl::string_view bytes) {
+  uint64_t value = 0;
+  for (size_t i = 0; i < bytes.size(); ++i) {
+    value |= static_cast<uint64_t>(static_cast<uint8_t>(bytes[i])) << (8 * i);
+  }
+  return value;
+}
+
+const char* ByteOrder() {
+  const uint32_t one = 1;
+  return *reinterpret_cast<const uint8_t*>(&one) == 1 ? "little" : "big";
+}
+
+bool UnsignedInteger(const nlohmann::json& value, uint64_t& result) {
+  if (value.is_number_unsigned()) {
+    result = value.get<uint64_t>();
+    return true;
+  }
+  if (value.is_number_integer() && value.get<int64_t>() >= 0) {
+    result = static_cast<uint64_t>(value.get<int64_t>());
+    return true;
+  }
+  return false;
+}
+
+// Bound nesting before entering the JSON parser. Syntax and canonical encoding
+// are checked separately; braces inside strings do not contribute to depth.
+bool BoundedJsonDepth(absl::string_view text) {
+  int depth = 0;
+  bool in_string = false;
+  bool escaped = false;
+  for (char c : text) {
+    if (in_string) {
+      if (escaped) {
+        escaped = false;
+      } else if (c == '\\') {
+        escaped = true;
+      } else if (c == '"') {
+        in_string = false;
+      }
+    } else if (c == '"') {
+      in_string = true;
+    } else if (c == '{' || c == '[') {
+      if (++depth > 32) return false;
+    } else if (c == '}' || c == ']') {
+      if (--depth < 0) return false;
+    }
+  }
+  return depth == 0 && !in_string;
+}
+
+absl::StatusOr<size_t> DescriptorBytes(const nlohmann::json& descriptor) {
+  uint64_t type, bytes;
+  if (!descriptor.is_object() || descriptor.size() != 3 ||
+      !descriptor.contains("type") || !descriptor.contains("shape") ||
+      !descriptor.contains("bytes") ||
+      !UnsignedInteger(descriptor["type"], type) ||
+      type > std::numeric_limits<int>::max() ||
+      !UnsignedInteger(descriptor["bytes"], bytes) ||
+      !descriptor["shape"].is_array() ||
+      descriptor["shape"].size() > LITERT_TENSOR_MAX_RANK) {
+    return absl::DataLossError("Invalid state tensor descriptor.");
+  }
+  auto width = GetByteWidth(static_cast<ElementType>(type));
+  if (!width.has_value()) {
+    return absl::DataLossError("Unsupported state tensor element type.");
+  }
+  size_t elements = 1;
+  for (const auto& dim : descriptor["shape"]) {
+    uint64_t value;
+    if (!UnsignedInteger(dim, value) ||
+        value > std::numeric_limits<int32_t>::max() ||
+        (value != 0 && elements > std::numeric_limits<size_t>::max() / value)) {
+      return absl::DataLossError("Invalid state tensor shape.");
+    }
+    elements *= value;
+  }
+  // ByteWidth supports sub-byte types. Reserve room for its rounding as well
+  // as multiplication; NumBytes() itself does not check overflow.
+  if (elements > (std::numeric_limits<size_t>::max() - 3) /
+                     static_cast<size_t>(*width)) {
+    return absl::DataLossError("State tensor size overflows.");
+  }
+  const size_t expected = width->NumBytes(elements);
+  if (bytes != expected) {
+    return absl::DataLossError("State tensor byte count does not match its type.");
+  }
+  return expected;
+}
+
+absl::StatusOr<size_t> TransferOffset(const TensorBuffer& buffer,
+                                    size_t packed_bytes) {
+  LITERT_ASSIGN_OR_RETURN(auto type, buffer.TensorType());
+  if (type.Layout().HasStrides()) {
+    return absl::UnimplementedError(
+        "Strided state tensor layouts are unsupported.");
+  }
+  LITERT_ASSIGN_OR_RETURN(auto buffer_type, buffer.BufferType());
+  LITERT_ASSIGN_OR_RETURN(size_t offset, buffer.Offset());
+  switch (buffer_type) {
+    case TensorBufferType::kHostMemory:
+    case TensorBufferType::kAhwb:
+    case TensorBufferType::kIon:
+    case TensorBufferType::kDmaBuf:
+    case TensorBufferType::kFastRpc: {
+      // These mappings return the allocation base, including for NPU aliases.
+      LITERT_ASSIGN_OR_RETURN(size_t size, buffer.Size());
+      if (offset > size || packed_bytes > size - offset) {
+        return absl::InvalidArgumentError("State tensor exceeds its allocation.");
+      }
+      return offset;
+    }
+    default:
+      // GPU mappings perform their own packing/conversion. Physical storage
+      // size may differ from the declared dtype's packed host representation.
+      if (offset != 0) {
+        return absl::UnimplementedError("GPU state tensor offsets are unsupported.");
+      }
+      return size_t{0};
+  }
+}
+
+absl::Status UnlockAfterTransfer(TensorBuffer& buffer) {
+  auto unlocked = buffer.Unlock();
+  auto cleanup = buffer.ReleaseHostStagingMemory();
+  if (!unlocked) {
+    ErrorStatusBuilder error(unlocked);
+    if (!cleanup) {
+      error << "; staging cleanup failed: " << cleanup.Error().Message();
+    }
+    return error;
+  }
+  LITERT_RETURN_IF_ERROR(cleanup);
+  return absl::OkStatus();
+}
+
+absl::StatusOr<void*> LockForTransfer(TensorBuffer& buffer,
+                                     TensorBuffer::LockMode mode) {
+  auto data = buffer.Lock(mode);
+  if (!data) {
+    ErrorStatusBuilder error(data);
+    auto cleanup = buffer.ReleaseHostStagingMemory();
+    if (!cleanup) {
+      error << "; staging cleanup failed: " << cleanup.Error().Message();
+    }
+    return error;
+  }
+  if (*data == nullptr) {
+    ABSL_RETURN_IF_ERROR(UnlockAfterTransfer(buffer));
+    return absl::InternalError("State tensor mapping returned a null address.");
+  }
+  return *data;
+}
+
+}  // namespace
+
+absl::StatusOr<nlohmann::json> DescribeStateTensor(const TensorBuffer& buffer) {
+  LITERT_ASSIGN_OR_RETURN(auto type, buffer.TensorType());
+  LITERT_ASSIGN_OR_RETURN(size_t size, buffer.PackedSize());
+  const auto dimensions = type.Layout().Dimensions();
+  nlohmann::json descriptor = {
+      {"type", static_cast<int>(type.ElementType())},
+      {"shape", std::vector<int32_t>(dimensions.begin(), dimensions.end())},
+      {"bytes", size}};
+  ABSL_RETURN_IF_ERROR(DescriptorBytes(descriptor).status());
+  ABSL_RETURN_IF_ERROR(TransferOffset(buffer, size).status());
+  return descriptor;
+}
+
+absl::StatusOr<std::string> SerializeState(
+    const nlohmann::json& metadata, const StateTensorBuffers& buffers) {
+  if (!metadata.is_object() || buffers.size() > kMaxTensors) {
+    return absl::InvalidArgumentError("Invalid state metadata or tensor count.");
+  }
+  std::vector<std::string> names;
+  names.reserve(buffers.size());
+  for (const auto& [name, _] : buffers) names.push_back(name);
+  std::sort(names.begin(), names.end());
+  nlohmann::json tensors = nlohmann::json::array();
+  size_t payload_bytes = 0;
+  for (const auto& name : names) {
+    if (name.empty() || name.size() > kMaxNameBytes) {
+      return absl::InvalidArgumentError("Invalid state tensor name.");
+    }
+    ABSL_ASSIGN_OR_RETURN(auto descriptor, DescribeStateTensor(buffers.at(name)));
+    const size_t bytes = descriptor["bytes"].get<size_t>();
+    if (bytes > std::numeric_limits<size_t>::max() - payload_bytes) {
+      return absl::ResourceExhaustedError("Serialized state is too large.");
+    }
+    payload_bytes += bytes;
+    descriptor["name"] = name;
+    tensors.push_back(std::move(descriptor));
+  }
+  const std::string header =
+      nlohmann::json({{"version", 1},
+                      {"byte_order", ByteOrder()},
+                      {"metadata", metadata},
+                      {"tensors", std::move(tensors)}})
+          .dump();
+  if (header.size() > kMaxHeaderBytes || !BoundedJsonDepth(header)) {
+    return absl::ResourceExhaustedError("Serialized state header is too large.");
+  }
+  std::string result;
+  const size_t overhead = kPrefixBytes + header.size() + kChecksumBytes;
+  if (payload_bytes > result.max_size() - overhead) {
+    return absl::ResourceExhaustedError("Serialized state is too large.");
+  }
+  result.reserve(overhead + payload_bytes);
+  result.append(kMagic.data(), kMagic.size());
+  AppendInteger(result, header.size(), 8);
+  result += header;
+  for (const auto& name : names) {
+    const auto& source = buffers.at(name);
+    LITERT_ASSIGN_OR_RETURN(size_t bytes, source.PackedSize());
+    ABSL_ASSIGN_OR_RETURN(size_t offset, TransferOffset(source, bytes));
+    if (bytes != 0) {
+      // Duplicate only the handle, never the tensor payload.
+      LITERT_ASSIGN_OR_RETURN(auto buffer, source.Duplicate());
+      LITERT_RETURN_IF_ERROR(buffer.ReleaseHostStagingMemory());
+      ABSL_ASSIGN_OR_RETURN(
+          void* data, LockForTransfer(buffer, TensorBuffer::LockMode::kRead));
+      result.append(static_cast<const char*>(data) + offset, bytes);
+      ABSL_RETURN_IF_ERROR(UnlockAfterTransfer(buffer));
+    }
+  }
+  AppendInteger(result, static_cast<uint32_t>(absl::ComputeCrc32c(result)), 4);
+  return result;
+}
+
+absl::StatusOr<ParsedSerializedState> ParseSerializedState(
+    absl::string_view serialized_state) {
+  if (serialized_state.size() < kPrefixBytes + kChecksumBytes ||
+      serialized_state.substr(0, kMagic.size()) != kMagic) {
+    return absl::DataLossError("Invalid serialized state header.");
+  }
+  const uint64_t header_bytes = ReadInteger(serialized_state.substr(8, 8));
+  if (header_bytes > kMaxHeaderBytes ||
+      header_bytes > serialized_state.size() - kPrefixBytes - kChecksumBytes) {
+    return absl::DataLossError("Invalid serialized state header length.");
+  }
+  const size_t checksum_position = serialized_state.size() - kChecksumBytes;
+  if (ReadInteger(serialized_state.substr(checksum_position)) !=
+      static_cast<uint32_t>(
+          absl::ComputeCrc32c(serialized_state.substr(0, checksum_position)))) {
+    return absl::DataLossError("Serialized state checksum mismatch.");
+  }
+  const auto header_text = serialized_state.substr(kPrefixBytes, header_bytes);
+  if (!BoundedJsonDepth(header_text)) {
+    return absl::DataLossError("Invalid serialized state JSON depth.");
+  }
+  auto header = nlohmann::json::parse(header_text.begin(), header_text.end(),
+                                    nullptr, /*allow_exceptions=*/false);
+  if (!header.is_object() || header.size() != 4 ||
+      !header.contains("version") || !header.contains("byte_order") ||
+      !header.contains("metadata") || !header["metadata"].is_object() ||
+      !header.contains("tensors") || !header["tensors"].is_array() ||
+      header["tensors"].size() > kMaxTensors || header.dump() != header_text) {
+    return absl::DataLossError("Invalid serialized state JSON header.");
+  }
+  uint64_t version;
+  if (!UnsignedInteger(header["version"], version) || version != 1 ||
+      !header["byte_order"].is_string() || header["byte_order"] != ByteOrder()) {
+    return absl::FailedPreconditionError("Incompatible serialized state format.");
+  }
+  ParsedSerializedState result{std::move(header["metadata"]), {}};
+  size_t position = kPrefixBytes + header_bytes;
+  for (auto& tensor : header["tensors"]) {
+    if (!tensor.is_object() || tensor.size() != 4 ||
+        !tensor.contains("name") || !tensor["name"].is_string()) {
+      return absl::DataLossError("Invalid serialized state tensor name.");
+    }
+    std::string name = tensor["name"].get<std::string>();
+    if (name.empty() || name.size() > kMaxNameBytes ||
+        (!result.tensors.empty() && name <= result.tensors.back().name)) {
+      return absl::DataLossError("State tensor names are not unique and sorted.");
+    }
+    tensor.erase("name");
+    ABSL_ASSIGN_OR_RETURN(size_t bytes, DescriptorBytes(tensor));
+    if (bytes > checksum_position - position) {
+      return absl::DataLossError("Truncated serialized state tensor.");
+    }
+    result.tensors.push_back({std::move(name), std::move(tensor),
+                              serialized_state.substr(position, bytes)});
+    position += bytes;
+  }
+  if (position != checksum_position) {
+    return absl::DataLossError("Unexpected trailing serialized state bytes.");
+  }
+  return result;
+}
+
+absl::Status ValidateSerializedState(const ParsedSerializedState& state,
+                                    const StateTensorBuffers& buffers) {
+  if (state.tensors.size() != buffers.size()) {
+    return absl::InvalidArgumentError("State tensor count mismatch.");
+  }
+  absl::string_view previous_name;
+  for (const auto& tensor : state.tensors) {
+    const auto it = buffers.find(tensor.name);
+    if (it == buffers.end() || tensor.name <= previous_name) {
+      return absl::InvalidArgumentError("State tensor name mismatch.");
+    }
+    previous_name = tensor.name;
+    ABSL_ASSIGN_OR_RETURN(auto expected, DescribeStateTensor(it->second));
+    if (tensor.descriptor.dump() != expected.dump() ||
+        tensor.bytes.size() != expected["bytes"].get<size_t>()) {
+      return absl::InvalidArgumentError("State tensor descriptor mismatch.");
+    }
+  }
+  return absl::OkStatus();
+}
+
+absl::Status LoadSerializedState(const ParsedSerializedState& state,
+                                StateTensorBuffers& buffers) {
+  ABSL_RETURN_IF_ERROR(ValidateSerializedState(state, buffers));
+  // Reject providers unable to release staging before the first write.
+  for (auto& [_, buffer] : buffers) {
+    LITERT_RETURN_IF_ERROR(buffer.ReleaseHostStagingMemory());
+  }
+  for (const auto& tensor : state.tensors) {
+    auto& buffer = buffers.at(tensor.name);
+    ABSL_ASSIGN_OR_RETURN(size_t offset,
+                          TransferOffset(buffer, tensor.bytes.size()));
+    if (!tensor.bytes.empty()) {
+      ABSL_ASSIGN_OR_RETURN(
+          void* data, LockForTransfer(buffer, TensorBuffer::LockMode::kWrite));
+      std::memcpy(static_cast<char*>(data) + offset, tensor.bytes.data(),
+                  tensor.bytes.size());
+      ABSL_RETURN_IF_ERROR(UnlockAfterTransfer(buffer));
+    }
+  }
+  return absl::OkStatus();
+}
+
+}  // namespace litert::lm
