+// A verifier can write V future rows before the first returned token ends a
+// turn. A cold-start stop can also cause Prefill to replay the previous token.
+// R >= W + V, plus any further logical rollback, ensures those writes only
+// replace expired local-ring entries.
+// Full-attention K/V uses causal positions; recurrent state cannot be rewound
+// this way. Read the physical R from each tensor, not metadata's minimum size.
+absl::Status ValidateNpuMtpSnapshot(
+    const nlohmann::json& descriptors,
+    const proto::ExecutorMetadata* metadata, int verify_steps,
+    int current_step, int token_count, int nominal_capacity) {
+  if (metadata == nullptr || !metadata->has_llm_executor_metadata() ||
+      metadata->llm_executor_metadata().state_buffers().empty() ||
+      !descriptors.is_object() || descriptors.empty()) {
+    return absl::FailedPreconditionError(
+        "MTP cache persistence requires declared KV state metadata.");
+  }
+  const auto& llm = metadata->llm_executor_metadata();
+  const int64_t rollback_steps =
+      std::max<int64_t>(0, static_cast<int64_t>(token_count) - current_step);
+  std::vector<bool> covered(llm.state_buffers_size(), false);
+  for (auto it = descriptors.begin(); it != descriptors.end(); ++it) {
+    const proto::StateBuffer* declared = nullptr;
+    int index = -1;
+    for (int i = 0; i < llm.state_buffers_size(); ++i) {
+      const auto& candidate = llm.state_buffers(i);
+      if (it.key() == candidate.prefill_input_name() ||
+          it.key() == candidate.decode_input_name()) {
+        if (declared != nullptr) {
+          return absl::FailedPreconditionError("Ambiguous MTP state metadata.");
+        }
+        declared = &candidate;
+        index = i;
+      }
+    }
+    if (declared == nullptr || covered[index] ||
+        absl::StartsWith(it.key(), kKvCacheCRootName)) {
+      return absl::FailedPreconditionError("MTP state is not independent KV.");
+    }
+    covered[index] = true;
+    bool local;
+    switch (declared->type()) {
+      case proto::StateBuffer::TYPE_GLOBAL_KEY_CACHE:
+      case proto::StateBuffer::TYPE_GLOBAL_VALUE_CACHE:
+        local = false;
+        break;
+      case proto::StateBuffer::TYPE_LOCAL_KEY_CACHE:
+      case proto::StateBuffer::TYPE_LOCAL_VALUE_CACHE:
+        local = true;
+        break;
+      default:
+        return absl::FailedPreconditionError(
+            "MTP cache persistence requires pure key/value state.");
+    }
+    const auto& descriptor = it.value();
+    if (!declared->has_sequence_axis() || declared->sequence_axis() < 0 ||
+        !descriptor.contains("shape") || !descriptor["shape"].is_array() ||
+        static_cast<size_t>(declared->sequence_axis()) >=
+            descriptor["shape"].size()) {
+      return absl::FailedPreconditionError("Invalid MTP cache sequence axis.");
+    }
+    ABSL_ASSIGN_OR_RETURN(
+        const int capacity,
+        ReadContextInteger(descriptor["shape"][declared->sequence_axis()]));
+    if (capacity <= 0) {
+      return absl::FailedPreconditionError("Invalid MTP cache capacity.");
+    }
+    if (local) {
+      if (!llm.has_attention_mask_settings() ||
+          !llm.attention_mask_settings().has_sliding_window_size() ||
+          !IsMtpRingSnapshotSafe(
+              capacity, llm.attention_mask_settings().sliding_window_size(),
+              verify_steps, rollback_steps)) {
+        return absl::FailedPreconditionError(
+            "MTP local cache lacks space for the verifier, window and rewind.");
+      }
+    } else if (capacity < std::max(verify_steps, nominal_capacity) ||
+               static_cast<int64_t>(std::max(current_step, token_count)) >
+                   static_cast<int64_t>(capacity) + 1) {
+      return absl::FailedPreconditionError("MTP global cache capacity exceeded.");
+    }
+  }
+  if (!std::all_of(covered.begin(), covered.end(),
+                   [](bool value) { return value; })) {
+    return absl::FailedPreconditionError("MTP state metadata is incomplete.");
+  }
+  return absl::OkStatus();
+}
