+TEST_F(StateSerializationTest, LegacyMapUsesTheCheckedCodec) {
+  StateTensorBuffers buffers;
+  ASSERT_NO_FATAL_FAILURE(AddBuffer(buffers, "kv", ElementType::UInt8, {4}, 7));
+  LegacyMapState state(std::move(buffers));
+  ASSERT_OK_AND_ASSIGN(auto serialized, state.Serialize());
+  ASSERT_OK(state.Clear());
+  ASSERT_OK(state.Load(serialized));
+  ASSERT_NO_FATAL_FAILURE(ExpectBytes(state.buffers().at("kv"), 7));
+  ASSERT_OK_AND_ASSIGN(auto parsed, ParseSerializedState(serialized));
+  parsed.metadata["kind"] = "different";
+  EXPECT_THAT(state.Load(parsed),
+              StatusIs(absl::StatusCode::kInvalidArgument));
+}
