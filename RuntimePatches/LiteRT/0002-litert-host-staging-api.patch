+TEST(LiteRtAbiHeaderTest, CustomBufferHostStagingCapability) {
+  LiteRtCustomTensorBufferHandlersDef old = {};
+  old.abi_header = {sizeof(old), 1, 0, 0};
+  EXPECT_EQ(LiteRtGetCustomTensorBufferHostStagingMemoryHandler(&old), nullptr);
+  old.abi_header.minor_version = 1;
+  EXPECT_EQ(LiteRtGetCustomTensorBufferHostStagingMemoryHandler(&old), nullptr);
+
+  LiteRtCustomTensorBufferHandlersDefV1_1 def = {};
+  def.v1.abi_header = {sizeof(def), 1, 1, 0};
+  def.release_host_staging_memory = ReleaseHostStagingMemory;
+  EXPECT_EQ(LiteRtGetCustomTensorBufferHostStagingMemoryHandler(&def.v1),
+            ReleaseHostStagingMemory);
+  --def.v1.abi_header.struct_size;
+  EXPECT_EQ(LiteRtGetCustomTensorBufferHostStagingMemoryHandler(&def.v1), nullptr);
+  ++def.v1.abi_header.struct_size;
+  def.v1.abi_header.minor_version = 0;
+  EXPECT_EQ(LiteRtGetCustomTensorBufferHostStagingMemoryHandler(&def.v1), nullptr);
+  def.v1.abi_header = {sizeof(def), 2, 1, 0};
+  EXPECT_EQ(LiteRtGetCustomTensorBufferHostStagingMemoryHandler(&def.v1), nullptr);
+  EXPECT_EQ(LiteRtGetCustomTensorBufferHostStagingMemoryHandler(nullptr), nullptr);
+}
