+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+#include "runtime/executor/context_serialization.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <cstring>
+#include <limits>
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "absl/status/status.h"  // from @com_google_absl
+#include "absl/status/status_macros.h"  // from @com_google_absl
+#include "absl/strings/escaping.h"  // from @com_google_absl
+#include "absl/types/span.h"  // from @com_google_absl
+#include "runtime/executor/executor_settings_base.h"
+
+namespace litert::lm {
+namespace {
+
+using Json = nlohmann::json;
+
+absl::Status InvalidMetadata() {
+  return absl::InvalidArgumentError("Invalid serialized execution metadata.");
+}
+
+bool IsLittleEndian() {
+  const uint32_t one = 1;
+  return *reinterpret_cast<const uint8_t*>(&one) == 1;
+}
+
+Json ExecutionSettings(const LlmExecutorSettings& settings) {
+  const auto& advanced = settings.GetAdvancedSettings();
+  return {
+      {"backend", GetBackendString(settings.GetBackend())},
+      {"activation",
+       settings.GetActivationDataType().has_value()
+           ? Json(static_cast<int>(*settings.GetActivationDataType()))
+           : Json(nullptr)},
+      {"mixed_precision", settings.IsMixedPrecisionEnabled()},
+      {"max_tokens", settings.GetMaxNumTokens()},
+      {"lora_rank", settings.GetLoraRank()},
+      {"signatures", settings.GetSelectedSignatures()},
+      {"output_candidates", advanced ? advanced->num_output_candidates : 1},
+      {"speculative_decoding",
+       advanced && advanced->enable_speculative_decoding},
+  };
+}
+
+// Reject excessive nesting before constructing a JSON tree. Syntax and escapes
+// are subsequently checked by the JSON parser.
+bool HasBoundedDepth(absl::string_view text) {
+  bool quoted = false;
+  bool escaped = false;
+  int depth = 0;
+  for (char c : text) {
+    if (quoted) {
+      if (escaped) {
+        escaped = false;
+      } else if (c == '\\') {
+        escaped = true;
+      } else if (c == '"') {
+        quoted = false;
+      }
+    } else if (c == '"') {
+      quoted = true;
+    } else if (c == '{' || c == '[') {
+      if (++depth > 32) return false;
+    } else if (c == '}' || c == ']') {
+      if (--depth < 0) return false;
+    }
+  }
+  return depth == 0 && !quoted;
+}
+
+std::string EncodeEmbedding(absl::Span<const float> values) {
+  static_assert(sizeof(float) == 4 && std::numeric_limits<float>::is_iec559);
+  return absl::Base64Escape(absl::string_view(
+      reinterpret_cast<const char*>(values.data()), values.size() * sizeof(float)));
+}
+
+absl::StatusOr<std::string> ReadContextBytes(const Json& value) {
+  if (!value.is_string()) return InvalidMetadata();
+  const auto& encoded = value.get_ref<const std::string&>();
+  std::string result;
+  if (encoded.size() > kMaxContextMetadataBytes ||
+      !absl::Base64Unescape(encoded, &result)) {
+    return InvalidMetadata();
+  }
+  return result;
+}
+
+absl::StatusOr<std::vector<float>> DecodeEmbedding(const Json& value) {
+  ABSL_ASSIGN_OR_RETURN(std::string bytes, ReadContextBytes(value));
+  if (bytes.size() % sizeof(float) != 0) return InvalidMetadata();
+  std::vector<float> result(bytes.size() / sizeof(float));
+  if (!bytes.empty()) std::memcpy(result.data(), bytes.data(), bytes.size());
+  return result;
+}
+
+}  // namespace
+
+absl::StatusOr<int> ReadContextInteger(const Json& value) {
+  if (!value.is_number_integer()) return InvalidMetadata();
+  if (value.is_number_unsigned()) {
+    const uint64_t number = value.get<uint64_t>();
+    if (number > std::numeric_limits<int>::max()) return InvalidMetadata();
+    return static_cast<int>(number);
+  }
+  const int64_t number = value.get<int64_t>();
+  if (number < std::numeric_limits<int>::min() ||
+      number > std::numeric_limits<int>::max()) {
+    return InvalidMetadata();
+  }
+  return static_cast<int>(number);
+}
+
+absl::StatusOr<std::string> SerializeContextMetadata(
+    const LlmExecutorSettings& settings, const ProcessedTokens& tokens,
+    int current_step, bool ran_decode, Json backend) {
+  if (!backend.is_object()) return InvalidMetadata();
+  auto rows = tokens.GetCopyOfTokens();
+  auto pending = tokens.GetNextUnprocessedToken();
+  Json pending_json = Json::array();
+  for (size_t i = 0; i < pending.token.size(); ++i) {
+    if (i >= rows.size() || rows[i].empty() || pending.token[i] == nullptr ||
+        rows[i].back() != pending.token[i]->id()) {
+      return absl::InternalError("Inconsistent pending input tokens.");
+    }
+    rows[i].pop_back();
+    pending_json.push_back(
+        {{"id", pending.token[i]->id()},
+         {"embedding", EncodeEmbedding(pending.token[i]->embedding())},
+         {"per_layer_embedding",
+          EncodeEmbedding(pending.token[i]->per_layer_embedding())}});
+  }
+  Json metadata = {
+      {"version", 1},
+      {"little_endian", IsLittleEndian()},
+      {"settings", ExecutionSettings(settings)},
+      {"current_step", current_step},
+      {"ran_decode", ran_decode},
+      {"tokens", std::move(rows)},
+      {"pending", std::move(pending_json)},
+      {"backend", std::move(backend)},
+  };
+  std::string result = metadata.dump();
+  if (result.size() > kMaxContextMetadataBytes) {
+    return absl::ResourceExhaustedError("Execution metadata exceeds 16 MiB.");
+  }
+  return result;
+}
+
+absl::StatusOr<ContextMetadata> ParseContextMetadata(
+    absl::string_view serialized, const LlmExecutorSettings& settings) {
+  if (serialized.empty() || serialized.size() > kMaxContextMetadataBytes ||
+      !HasBoundedDepth(serialized)) {
+    return InvalidMetadata();
+  }
+  Json metadata = Json::parse(serialized.begin(), serialized.end(), nullptr, false);
+  if (!metadata.is_object() || metadata.size() != 8 ||
+      !metadata.contains("version") || !metadata.contains("little_endian") ||
+      !metadata.contains("settings") || !metadata.contains("current_step") ||
+      !metadata.contains("ran_decode") || !metadata.contains("tokens") ||
+      !metadata.contains("pending") || !metadata.contains("backend") ||
+      metadata.dump() != serialized) {
+    return InvalidMetadata();
+  }
+  ABSL_ASSIGN_OR_RETURN(int version, ReadContextInteger(metadata["version"]));
+  if (version != 1 ||
+      metadata["little_endian"] != IsLittleEndian() ||
+      metadata["settings"].dump() != ExecutionSettings(settings).dump()) {
+    return absl::FailedPreconditionError("Incompatible execution metadata.");
+  }
+  ABSL_ASSIGN_OR_RETURN(int step, ReadContextInteger(metadata["current_step"]));
+  if (step < 0 || static_cast<uint32_t>(step) > settings.GetMaxNumTokens() ||
+      !metadata["ran_decode"].is_boolean() ||
+      !metadata["backend"].is_object()) {
+    return InvalidMetadata();
+  }
+  const Json& rows_json = metadata["tokens"];
+  const Json& pending_json = metadata["pending"];
+  const int max_candidates = std::max(
+      settings.GetAdvancedSettings()
+          ? settings.GetAdvancedSettings()->num_output_candidates
+          : 1,
+      1);
+  if (!rows_json.is_array() || rows_json.empty() ||
+      rows_json.size() > static_cast<size_t>(max_candidates) ||
+      !pending_json.is_array() ||
+      (!pending_json.empty() && pending_json.size() != rows_json.size())) {
+    return InvalidMetadata();
+  }
+  std::vector<std::vector<int>> rows;
+  rows.reserve(rows_json.size());
+  for (const Json& row_json : rows_json) {
+    if (!row_json.is_array() ||
+        row_json.size() > static_cast<uint64_t>(settings.GetMaxNumTokens()) + 1 ||
+        (!rows.empty() && row_json.size() != rows.front().size())) {
+      return InvalidMetadata();
+    }
+    std::vector<int> row;
+    row.reserve(row_json.size());
+    for (const Json& value : row_json) {
+      ABSL_ASSIGN_OR_RETURN(int id, ReadContextInteger(value));
+      row.push_back(id);
+    }
+    rows.push_back(std::move(row));
+  }
+  std::vector<std::shared_ptr<TokenData>> pending;
+  pending.reserve(pending_json.size());
+  for (const Json& value : pending_json) {
+    if (!value.is_object() || value.size() != 3 || !value.contains("id") ||
+        !value.contains("embedding") || !value.contains("per_layer_embedding")) {
+      return InvalidMetadata();
+    }
+    ABSL_ASSIGN_OR_RETURN(int id, ReadContextInteger(value["id"]));
+    ABSL_ASSIGN_OR_RETURN(auto embedding, DecodeEmbedding(value["embedding"]));
+    ABSL_ASSIGN_OR_RETURN(auto per_layer_embedding,
+                          DecodeEmbedding(value["per_layer_embedding"]));
+    pending.push_back(std::make_shared<TokenData>(
+        id, std::move(embedding), std::move(per_layer_embedding)));
+  }
+  ABSL_ASSIGN_OR_RETURN(
+      auto tokens,
+      ProcessedTokens::CreateFromTokens(std::move(rows), std::move(pending)));
+  // DecodeLogits advances the logical step before an externally sampled token
+  // is available. Normal Decode includes that token as pending input.
+  if (static_cast<int64_t>(step) >
+      static_cast<int64_t>(tokens.TokenCount()) +
+          (pending_json.empty() ? 1 : 0)) {
+    return InvalidMetadata();
+  }
+  return ContextMetadata{std::move(tokens), step,
+                         metadata["ran_decode"].get<bool>(), rows_json.size(),
+                         std::move(metadata["backend"])};
+}
+
+absl::Status ValidateContextTokens(const ProcessedTokens& tokens, int vocab_size,
+                                  size_t embedding_size,
+                                  size_t per_layer_embedding_size) {
+  if (vocab_size <= 0) return InvalidMetadata();
+  for (const auto& row : tokens.GetCopyOfTokens()) {
+    for (int id : row) {
+      // Negative IDs in processed history represent modality placeholders.
+      if (id >= vocab_size) return InvalidMetadata();
+    }
+  }
+  for (const auto& token : tokens.GetNextUnprocessedToken().token) {
+    if (token->id() < 0 &&
+        (token->id() != -1 || token->embedding().empty())) {
+      return InvalidMetadata();
+    }
+    if ((!token->embedding().empty() &&
+         token->embedding().size() != embedding_size) ||
+        (!token->per_layer_embedding().empty() &&
+         token->per_layer_embedding().size() != per_layer_embedding_size)) {
+      return InvalidMetadata();
+    }
+  }
+  return absl::OkStatus();
+}
+
+}  // namespace litert::lm
