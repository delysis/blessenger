+// Rewrite a valid header and update the checksum so malformed-metadata tests
+// exercise parsing and validation instead of stopping at the corruption check.
+std::string ReplaceHeader(absl::string_view state,
+                          const nlohmann::json& header) {
+  uint64_t old_size = 0;
+  for (int i = 0; i < 8; ++i) {
+    old_size |= static_cast<uint64_t>(static_cast<uint8_t>(state[8 + i]))
+                << (8 * i);
+  }
+  std::string result(state.data(), 8);
+  const std::string text = header.dump();
+  for (int i = 0; i < 8; ++i) {
+    result.push_back(
+        static_cast<char>((static_cast<uint64_t>(text.size()) >> (8 * i)) & 255));
+  }
+  result += text;
+  result.append(state.data() + 16 + old_size, state.size() - 20 - old_size);
+  const uint32_t crc = static_cast<uint32_t>(absl::ComputeCrc32c(result));
+  for (int i = 0; i < 4; ++i) {
+    result.push_back(static_cast<char>((crc >> (8 * i)) & 255));
+  }
+  return result;
+}
+
+nlohmann::json Header(absl::string_view state) {
+  uint64_t size = 0;
+  for (int i = 0; i < 8; ++i) {
+    size |= static_cast<uint64_t>(static_cast<uint8_t>(state[8 + i]))
+            << (8 * i);
+  }
+  return nlohmann::json::parse(state.begin() + 16, state.begin() + 16 + size);
+}
+
+void ExpectBytes(TensorBuffer& buffer, uint8_t value) {
+  LITERT_ASSERT_OK_AND_ASSIGN(size_t bytes, buffer.PackedSize());
+  LITERT_ASSERT_OK_AND_ASSIGN(void* data,
+                              buffer.Lock(TensorBuffer::LockMode::kRead));
+  const std::string contents(static_cast<const char*>(data), bytes);
+  ASSERT_TRUE(buffer.Unlock());
+  EXPECT_EQ(contents, std::string(bytes, static_cast<char>(value)));
+}
