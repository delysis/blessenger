+#ifndef THIRD_PARTY_ODML_LITERT_LM_RUNTIME_EXECUTOR_MTP_CACHE_H_
+#define THIRD_PARTY_ODML_LITERT_LM_RUNTIME_EXECUTOR_MTP_CACHE_H_
+
+#include <cstdint>
+
+namespace litert::lm {
+
+// A verifier beginning at P writes through P + verify_steps - 1. Stopping on
+// the preceding cold-prime token can make the next prefill replay P - 1, whose
+// oldest required history row is P - window_size. Keep that row outside the
+// verifier's overwritten ring slots. This is a sufficient bound for any
+// accepted prefix, including a stop within the returned batch. Reserve further
+// rows when the saved logical position has been rewound behind its token history.
+constexpr bool IsMtpRingSnapshotSafe(int64_t ring_size, int64_t window_size,
+                                     int64_t verify_steps,
+                                     int64_t rollback_steps = 0) {
+  return window_size > 0 && verify_steps > 0 && ring_size >= window_size &&
+         verify_steps <= ring_size - window_size && rollback_steps >= 0 &&
+         rollback_steps <= ring_size - window_size - verify_steps;
+}
+
+// Check before constructing masks or writing any verifier input/state. Use
+// subtraction so malformed sizes cannot overflow the bound check.
+constexpr bool MtpBatchFits(int64_t start, int64_t verify_steps,
+                            int64_t capacity) {
+  return start >= 0 && verify_steps > 0 && capacity >= verify_steps &&
+         start <= capacity - verify_steps;
+}
+
+}  // namespace litert::lm
+
+#endif  // THIRD_PARTY_ODML_LITERT_LM_RUNTIME_EXECUTOR_MTP_CACHE_H_
