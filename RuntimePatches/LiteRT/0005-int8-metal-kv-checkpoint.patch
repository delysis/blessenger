+- (void)testCheckpointRejectsInvalidInt8Buffers {
+  if (!_device) return;
+
+  LiteRtRankedTensorType tensorType = {};
+  tensorType.element_type = kLiteRtElementTypeInt8;
+  tensorType.layout.rank = 2;
+  tensorType.layout.dimensions[0] = 1;
+  tensorType.layout.dimensions[1] = 8;
+  tensorType.layout.has_strides = true;
+  tensorType.layout.strides[0] = 16;
+  const size_t bytes = 8;
+  const struct {
+    MTLResourceOptions options;
+    size_t capacity;
+    LiteRtStatus expected;
+  } cases[] = {
+      {MTLResourceStorageModeShared, bytes / 2, kLiteRtStatusErrorInvalidArgument},
+      {MTLResourceStorageModePrivate, bytes, kLiteRtStatusErrorUnsupported},
+#if TARGET_OS_OSX
+      {MTLResourceStorageModeManaged, bytes, kLiteRtStatusErrorUnsupported},
+#endif
+  };
+  for (const auto& testCase : cases) {
+#if TARGET_OS_OSX
+    if (testCase.options == MTLResourceStorageModeManaged &&
+        [_device supportsFamily:MTLGPUFamilyApple1]) continue;
+#endif
+    id<MTLBuffer> buffer =
+        [_device newBufferWithLength:testCase.capacity options:testCase.options];
+    XCTAssertNotNil(buffer);
+    if (buffer == nil) return;
+    HwMemoryInfoPtr info = nullptr;
+    XCTAssertEqual(LiteRtImportMetalMemory(
+                       (__bridge void*)_device, (__bridge void*)_commandQueue, &tensorType,
+                       kLiteRtTensorBufferTypeMetalBuffer, (__bridge void*)buffer,
+                       bytes, bytes, &info),
+                   kLiteRtStatusOk);
+    std::unique_ptr<HwMemoryInfo, decltype(&LiteRtDestroyMetalMemory)> memory(
+        info, &LiteRtDestroyMetalMemory);
+    XCTAssertTrue(memory != nullptr);
+    if (!memory) return;
+    XCTAssertEqual(LiteRtReleaseMetalHostStagingMemory(memory.get()), testCase.expected);
+    if (testCase.options != MTLResourceStorageModeShared) continue;
+    // Even without preflight, an undersized destination must fail before copy.
+    std::memset(buffer.contents, 0x5a, testCase.capacity);
+    void* hostMemory = nullptr;
+    const auto status =
+        LiteRtLockMetalMemory(memory.get(), kLiteRtTensorBufferLockModeWrite, &hostMemory);
+    XCTAssertEqual(status, kLiteRtStatusOk);
+    XCTAssertTrue(hostMemory != nullptr);
+    if (status != kLiteRtStatusOk || hostMemory == nullptr) return;
+    std::memset(hostMemory, 0xa5, bytes);
+    XCTAssertEqual(LiteRtUnlockMetalMemory(memory.get()), kLiteRtStatusErrorInvalidArgument);
+    for (size_t i = 0; i < testCase.capacity; ++i) {
+      XCTAssertEqual(static_cast<const uint8_t*>(buffer.contents)[i], 0x5a);
+    }
   }
 }
 
