+const LiteRtRuntimeHostStagingMemoryApi* GetLiteRtRuntimeHostStagingMemoryApi(
+    const LiteRtRuntimeCApiStruct* runtime) {
+  const LiteRtRuntimeHostStagingMemoryApi* api = nullptr;
+#if defined(LITERT_CC_RUNTIME_BUILTIN_DYNAMIC)
+  static const auto* dynamic_api =
+      []() -> const LiteRtRuntimeHostStagingMemoryApi* {
+#if LITERT_WINDOWS_OS
+    HMODULE module = nullptr;
+    if (!GetModuleHandleExA(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                               GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                           reinterpret_cast<LPCSTR>(&kLiteRtRuntimeBuiltin),
+                           &module)) {
+      return nullptr;
+    }
+    return reinterpret_cast<const LiteRtRuntimeHostStagingMemoryApi*>(
+        GetProcAddress(module, "kLiteRtRuntimeHostStagingMemoryApi"));
+#else
+    return static_cast<const LiteRtRuntimeHostStagingMemoryApi*>(
+        dlsym(RTLD_DEFAULT, "kLiteRtRuntimeHostStagingMemoryApi"));
+#endif
+  }();
+  api = dynamic_api;
+#elif defined(LITERT_CC_RUNTIME_BUILTIN_NONE)
+#if defined(__ANDROID__)
+  if (runtime != GetLiteRtRuntimeBuiltin()) {
+    return nullptr;
+  }
+  static const auto* android_api =
+      []() -> const LiteRtRuntimeHostStagingMemoryApi* {
+    // GetLiteRtRuntimeBuiltin keeps the library loaded for this pointer's life.
+    auto library = litert::SharedLibrary::Load(
+        "libLiteRt.so", litert::RtldFlags::Default());
+    if (!library) {
+      return nullptr;
+    }
+    auto symbol = library->LookupSymbol<const LiteRtRuntimeHostStagingMemoryApi*>(
+        "kLiteRtRuntimeHostStagingMemoryApi");
+    return symbol ? *symbol : nullptr;
+  }();
+  api = android_api;
+#endif
+#else
+  api = &kLiteRtRuntimeHostStagingMemoryApi;
+#endif
+  if (api == nullptr || !LITERT_ABI_IS_COMPATIBLE(api, 1, 0) ||
+      api->abi_header.struct_size < sizeof(LiteRtRuntimeHostStagingMemoryApi) ||
+      api->runtime != runtime ||
+      api->release_tensor_buffer_host_staging_memory == nullptr) {
+    return nullptr;
+  }
+  return api;
+}
