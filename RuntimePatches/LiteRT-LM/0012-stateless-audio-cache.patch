+TEST_F(AudioLiteRtCompiledModelExecutorTest,
+       CacheCheckpointStatelessAudioContinuesWithFreshContext) {
+  const auto model_path =
+      (std::filesystem::path(::testing::SrcDir()) /
+       std::string(kTestAudioNoMaskModelPath)).string();
+  ASSERT_OK_AND_ASSIGN(auto executor,
+                       CreateAudioExecutor(*env_, model_path, 0, Backend::CPU));
+  ASSERT_OK(executor->ValidateContextForCache());
+
+  // A non-multiple of the encoder window exercises zero-padding and the final
+  // partial window. With buffering disabled no frames survive this call.
+  std::vector<float> samples(13 * kSpectrogramFrequencySlots, 1.0f);
+  ASSERT_OK_AND_ASSIGN(
+      auto input, CreateTensorBuffer<const float>(
+                      samples, RankedTensorType(
+                                   GetElementType<float>(),
+                                   Layout(Dimensions(
+                                       {1, 13, kSpectrogramFrequencySlots})))));
+  ASSERT_OK(executor->Encode(input));
+  ASSERT_OK(executor->ValidateContextForCache());
+  ASSERT_OK_AND_ASSIGN(auto context, executor->CloneContext());
+  ASSERT_TRUE(static_cast<AudioStreamingContext*>(context.get())->IsEmpty());
+  ASSERT_OK(executor->ValidateContextForCache(context.get()));
+
+  // The next utterance's embeddings agree with a newly created audio executor;
+  // the LLM checkpoint does not need to contain the old audio input or output.
+  std::vector<float> silence(samples.size(), 0.0f);
+  ASSERT_TRUE(input.Write<float>(absl::MakeConstSpan(silence)).HasValue());
+  ASSERT_OK_AND_ASSIGN(auto continued, executor->Encode(input));
+  ASSERT_OK_AND_ASSIGN(auto continued_buffer,
+                       continued.GetMutableProjectedAudioEmbeddingsPtr());
+  ASSERT_OK_AND_ASSIGN(auto continued_values,
+                       GetDataAsVector<float>(*continued_buffer));
+  ASSERT_OK_AND_ASSIGN(auto restored,
+                       CreateAudioExecutor(*env_, model_path, 0, Backend::CPU));
+  ASSERT_OK(restored->ValidateContextForCache(context.get()));
+  ASSERT_OK(restored->RestoreContext(std::move(context)));
+  ASSERT_OK_AND_ASSIGN(auto resumed, restored->Encode(input));
+  ASSERT_OK_AND_ASSIGN(auto resumed_buffer,
+                       resumed.GetMutableProjectedAudioEmbeddingsPtr());
+  ASSERT_OK_AND_ASSIGN(auto resumed_values,
+                       GetDataAsVector<float>(*resumed_buffer));
+  EXPECT_EQ(resumed.GetValidTokens(), continued.GetValidTokens());
+  EXPECT_EQ(resumed_values, continued_values);
+}
