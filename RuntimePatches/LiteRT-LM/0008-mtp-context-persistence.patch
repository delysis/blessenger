+TEST(LlmLiteRtCompiledModelExecutorStaticTest,
+     MtpSnapshotValidatesPhysicalCache) {
+  proto::ExecutorMetadata metadata;
+  auto* llm = metadata.mutable_llm_executor_metadata();
+  auto* attention = llm->mutable_attention_mask_settings();
+  attention->set_attention_mask_type(proto::ATTENTION_MASK_TYPE_CAUSAL);
+  attention->set_local_attention_mask_type(
+      proto::ATTENTION_MASK_TYPE_VISION_BIDIRECTIONAL);
+  attention->set_sliding_window_size(1024);
+  const struct {
+    const char* name;
+    proto::StateBuffer::Type type;
+    int axis;
+  } buffers[] = {
+      {"local_k", proto::StateBuffer::TYPE_LOCAL_KEY_CACHE, 2},
+      {"local_v", proto::StateBuffer::TYPE_LOCAL_VALUE_CACHE, 3},
+      {"global_k", proto::StateBuffer::TYPE_GLOBAL_KEY_CACHE, 2},
+      {"global_v", proto::StateBuffer::TYPE_GLOBAL_VALUE_CACHE, 3},
+  };
+  nlohmann::json descriptors = nlohmann::json::object();
+  for (const auto& buffer : buffers) {
+    auto* entry = llm->add_state_buffers();
+    entry->set_prefill_input_name(buffer.name);
+    entry->set_decode_output_name(buffer.name);
+    entry->set_type(buffer.type);
+    entry->set_sequence_axis(buffer.axis);
+    // The actual allocated shape, rather than this export maximum, controls
+    // admission after model/context resizing.
+    entry->set_maximum_sequence_length(4096);
+    std::vector<int> shape = {1, 8, 256, 256};
+    shape[buffer.axis] = 1152;
+    descriptors[absl::StrCat("1/", buffer.name)] = {{"shape", shape}};
+  }
+  auto validate = [&](int step = 1000, int token_count = 1000,
+                      int num_entries = 1152, uint32_t max_tokens = 1153) {
+    return TestableLlmLiteRtCompiledModelExecutorStatic::
