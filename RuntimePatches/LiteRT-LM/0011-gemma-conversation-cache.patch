+absl::Status Conversation::SaveCache(absl::string_view path,
+                                    absl::string_view compatibility_key) {
+  ABSL_RETURN_IF_ERROR(CheckCacheConfig(config_));
+  absl::MutexLock lock(history_mutex_);
+  if (is_appending_message_ || checkpoint_message_index_.has_value() ||
+      history_.empty() || !history_.back().is_object() ||
+      !history_.back().contains("role") ||
+      history_.back()["role"] != "assistant") {
+    return absl::FailedPreconditionError(
+        "Conversation cache requires a completed assistant turn.");
+  }
+  ABSL_RETURN_IF_ERROR(CheckCacheHistory(history_));
+  return session_->SaveCache(path, compatibility_key);
+}
+
+absl::Status Conversation::LoadCache(absl::string_view path,
+                                    absl::string_view compatibility_key,
+                                    std::vector<Message> history) {
+  ABSL_RETURN_IF_ERROR(CheckCacheConfig(config_));
+  absl::MutexLock lock(history_mutex_);
+  if (!history_.empty() || is_appending_message_ ||
+      checkpoint_message_index_.has_value()) {
+    return absl::FailedPreconditionError(
+        "Conversation cache requires a fresh conversation.");
+  }
+  ABSL_RETURN_IF_ERROR(CheckCacheHistory(history));
+  ABSL_RETURN_IF_ERROR(session_->LoadCache(path, compatibility_key));
+  history_ = std::move(history);
+  return absl::OkStatus();
+}
