+#ifndef LITERT_LM_RUNTIME_UTIL_TRACKED_STATE_OUTPUT_H_
+#define LITERT_LM_RUNTIME_UTIL_TRACKED_STATE_OUTPUT_H_
+#include <cstddef>
+#include <cstdint>
+namespace litert::lm {
+// Optional stream sink for immutable state capture. Versions belong to a unique
+// state incarnation; callers must mark every potentially written physical block.
+class TrackedStateOutput {
+ public:
+  virtual ~TrackedStateOutput() = default;
+  virtual bool WriteTracked(const char* data, size_t size, uint64_t incarnation,
+                            const uint32_t* versions, size_t count) = 0;
+  virtual uint32_t CurrentCRC() const = 0;
+};
+}
+#endif
