+TEST_F(AotEngineResidencyTest, CachelessAliasReleaseCompletesHostWrites) {
+  ScopedEnvironment deferred("LITERT_NVIDIA_DISPATCH_DEFERRED_UPLOAD", "1");
+  const auto* handlers = api_.tensor_buffer_handlers_def;
+  ASSERT_NE(handlers, nullptr);
+  const auto release =
+      LiteRtGetCustomTensorBufferHostStagingMemoryHandler(handlers);
+  ASSERT_NE(release, nullptr);
+  auto type = TensorType();
+  HwMemoryInfoPtr raw = nullptr;
+  ASSERT_EQ(handlers->create_func(nullptr, nullptr, &type, kCudaBufferType,
+                                  kBytes, kBytes, &raw),
+            kLiteRtStatusOk);
+  std::unique_ptr<HwMemoryInfo, DestroyCustomTensorBuffer> writer(
+      raw, handlers->destroy_func);
+  ASSERT_EQ(handlers->clear_func(writer.get()), kLiteRtStatusOk);
+  ASSERT_EQ(handlers->import_func(nullptr, nullptr, &type, kCudaBufferType,
+                                  writer->memory_handle, kBytes, kBytes, &raw),
+            kLiteRtStatusOk);
+  std::unique_ptr<HwMemoryInfo, DestroyCustomTensorBuffer> alias(
+      raw, handlers->destroy_func);
+  void* host = nullptr;
+  ASSERT_EQ(handlers->lock_func(writer.get(), kLiteRtTensorBufferLockModeWrite,
+                                &host),
+            kLiteRtStatusOk);
+  ASSERT_NE(host, nullptr);
+  for (int i = 0; i < kElements; ++i) {
+    static_cast<float*>(host)[i] = 5.0f + i;
+  }
+  ASSERT_EQ(handlers->unlock_func(writer.get()), kLiteRtStatusOk);
+
+  // The alias has never been mapped. Release must still upload the writer's
+  // dirty staging, and preserve the caller's device even when it differs.
+  int allocation_device, device_count;
+  ASSERT_EQ(cudaGetDevice(&allocation_device), cudaSuccess);
+  ASSERT_EQ(cudaGetDeviceCount(&device_count), cudaSuccess);
+  const int caller_device = (allocation_device + 1) % device_count;
+  ASSERT_EQ(cudaSetDevice(caller_device), cudaSuccess);
+  const auto status = release(alias.get());
+  int current_device = -1;
+  EXPECT_EQ(cudaGetDevice(&current_device), cudaSuccess);
+  EXPECT_EQ(current_device, caller_device);
+  EXPECT_EQ(cudaSetDevice(allocation_device), cudaSuccess);
+  ASSERT_EQ(status, kLiteRtStatusOk);
+  ASSERT_EQ(handlers->lock_func(alias.get(), kLiteRtTensorBufferLockModeRead,
+                                &host),
+            kLiteRtStatusOk);
+  ASSERT_NE(host, nullptr);
+  for (int i = 0; i < kElements; ++i) {
+    EXPECT_FLOAT_EQ(static_cast<const float*>(host)[i], 5.0f + i) << i;
+  }
+  ASSERT_EQ(handlers->unlock_func(alias.get()), kLiteRtStatusOk);
+  EXPECT_EQ(release(alias.get()), kLiteRtStatusOk);
+  EXPECT_EQ(release(writer.get()), kLiteRtStatusOk);
+}
